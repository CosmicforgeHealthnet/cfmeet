# Environment
APP_ENV=dev

# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/cosmicforge_rtc

# Redis Configuration
# Used for OTP codes, rate limiting, token blacklist, and email queue
REDIS_URL=redis://127.0.0.1:6379
REDIS_POOL_SIZE=10
REDIS_TIMEOUT_SECS=5

# Server Configuration
HOST=127.0.0.1 #on production change to your server ip or 0.0.0.0
PORT=8080


# Google OAuth2 Configuration
# These values must match what you set in the Google Cloud Console
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# This must match what you saved in the Google Cloud Console
GOOGLE_REDIRECT_URL=http://localhost:8080/api/v1/auth/oauth/google/callback

# JWT Configuration
JWT_SECRET=your-secret-key-change-this-in-production

# Email Configuration (SMTP)
# Required for sending verification emails
# If not configured, verification tokens will be logged to console
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# Optional email settings
# IMPORTANT: For Gmail, SMTP_FROM_EMAIL must match SMTP_USERNAME
# Gmail rejects emails where the "from" address differs from the authenticated account
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_FROM_NAME=CosmicForge

# Email Verification
# Require users to verify their email before login (true/false)
EMAIL_VERIFICATION_REQUIRED=true

# Frontend URLs (comma-separated for CORS)
# Add all your frontend URLs: local, staging, production
FRONTEND_URLS=http://localhost:3000,http://localhost:3001

# Primary app URL (used for email links, join URLs, etc.)
APP_URL=http://localhost:3000

# Public server URL advertised in Swagger / OpenAPI ("Try it out" target).
# Set per environment (e.g. https://api.staging.cfmeet.com). Defaults to https://api.cfmeet.com
# SWAGGER_SERVER_URL=https://api.staging.cfmeet.com

# LiveKit Configuration (Required for RTC)
# Get these from your LiveKit Cloud dashboard or self-hosted LiveKit server
LIVEKIT_URL=wss://your-livekit-server.livekit.cloud
LIVEKIT_API_KEY=your-api-key
LIVEKIT_API_SECRET=your-api-secret

# Logging
RUST_LOG=debug

# For production use:
# RUST_LOG=backend=info,tower_http=warn

# ---------------------------------------------------------------------------
# Phase 2 meeting domain (/api/v2) — feature flags
# ---------------------------------------------------------------------------
# Code defaults are rollout-safe (all false). Enable for local development:
FEATURE_MEETING_V2_ENABLED=true
FEATURE_WAITING_ROOM_V2_ENABLED=true
# Optional comma-separated user UUIDs allowed to perform v2 writes (empty = everyone)
MEETING_V2_WRITE_ALLOWLIST=
# Log legacy/v2 drift on legacy meeting reads (no behaviour change)
FEATURE_MEETING_V2_SHADOW_READ=false
# Part E: provider-enforced RTC control plane (LiveKit room lifecycle, credentials,
# permission updates, removal, mute, verified webhooks, conference reconciler)
FEATURE_RTC_PROVIDER_CONTROL_V2=false
# Part E: Redis realtime fanout + authorized WebSocket subscription + replay
FEATURE_CONFERENCE_REALTIME_ENABLED=false
FEATURE_HEALTHCARE_PROFILE_ENABLED=false
FEATURE_WEBINAR_MODE_ENABLED=false
# Part F: media controls (locks, screen-share policy/stop, spotlight), chat, reactions,
# hand raise, breakouts (+ closer worker), polls/quizzes, Q&A, pre-join contract
FEATURE_COLLABORATION_V2_ENABLED=false
FEATURE_RECORDING_V2_ENABLED=false
# Never enabled during Phase 2 Parts A–D (ignored with a warning if set)
FEATURE_LEGACY_MEETING_WRITE_DISABLED=false

# Phase 2 tunables (defaults shown)
# MEETING_PASSCODE_HASH_COST=12
# MEETING_SESSION_TTL_SECS=14400
# MEETING_INVITATION_MAX_TTL_HOURS=2160
# MEETING_PASSCODE_MAX_ATTEMPTS=10
# MEETING_PASSCODE_WINDOW_SECS=900
# MEETING_OCCURRENCE_HORIZON_DAYS=30
# MEETING_OCCURRENCE_MAX_PER_RUN=50
# CONFERENCE_SCHEDULER_POLL_SECS=30
# MEETING_MAX_SESSIONS_PER_PARTICIPANT=5

# Part E — RTC control plane (defaults shown)
# LiveKit RoomService admin endpoint (defaults to LIVEKIT_URL with ws→http / wss→https)
# LIVEKIT_API_URL=https://your-livekit-server.livekit.cloud
# Bound on every provider admin call
# LIVEKIT_API_TIMEOUT_MS=5000
# Participant media credential lifetime (60..21600, never longer than the session)
# RTC_CREDENTIAL_TTL_SECS=600
# CONFERENCE_RECONCILER_POLL_SECS=30
# CONFERENCE_RECONCILER_BATCH=50
# CONFERENCE_RECONCILER_PRESENCE_GRACE_SECS=30
# Internal token for GET /internal/rtc/metrics (unset → the route answers 404)
# INTERNAL_API_TOKEN=
# Configure LiveKit webhooks to POST to {public meeting-service URL}/internal/rtc/livekit/webhook
# (signed with LIVEKIT_API_KEY / LIVEKIT_API_SECRET; unsigned callbacks are rejected).

# HEALTHCARE_APPOINTMENT authority (external HealthNet appointment service).
# Unset → every HEALTHCARE_APPOINTMENT join is denied (fail closed).
# HEALTHNET_APPOINTMENT_AUTHZ_URL=https://healthnet.example/internal/appointments/authorize
# HEALTHNET_APPOINTMENT_AUTHZ_TOKEN=service-to-service-secret
# HEALTHNET_APPOINTMENT_AUTHZ_TIMEOUT_MS=3000

# Parts G–I — artefacts, profiles, operations
# Transcription (classified NOT REQUIRED for this release; provider-neutral path only)
FEATURE_TRANSCRIPTION_V2_ENABLED=false
# AI processing (no production provider configured)
FEATURE_INTELLIGENCE_V2_ENABLED=false
FEATURE_QUALITY_TELEMETRY_ENABLED=false
# S3-compatible artefact storage (unset endpoint → recording unavailable)
# ARTIFACT_STORAGE_ENDPOINT=http://minio:9000
# ARTIFACT_STORAGE_PUBLIC_ENDPOINT=https://files.example.com
# ARTIFACT_STORAGE_REGION=us-east-1
# ARTIFACT_STORAGE_BUCKET=cfmeet-artifacts
# ARTIFACT_STORAGE_ACCESS_KEY=
# ARTIFACT_STORAGE_SECRET_KEY=
# ARTIFACT_STORAGE_PATH_STYLE=true
# ARTIFACT_STORAGE_PREFIX=artifacts
# LiveKit Egress encoding: provider default, or h264-opus (no AAC encoder needed)
# RECORDING_ENCODING=h264-opus
# RECORDING_START_TIMEOUT_SECS=90
# RECORDING_STOP_TIMEOUT_SECS=120
# ARTIFACT_SIGNED_URL_TTL_SECS=300
# ARTIFACT_FINALIZE_MAX_ATTEMPTS=10
# ARTIFACT_MAX_CHECKSUM_BYTES=8589934592
# ARTIFACT_RETENTION_BATCH=50
# ARTIFACT_RETENTION_POLL_SECS=60
# HMAC secret for POST /internal/transcription/events (unset → route answers 404)
# TRANSCRIPTION_WEBHOOK_SECRET=
# Quality / health thresholds (<NAME>_DEGRADED / <NAME>_UNHEALTHY), e.g.
# QUALITY_RTT_MS_DEGRADED=300
# QUALITY_RTT_MS_UNHEALTHY=800
# QUALITY_MAX_SAMPLES_PER_BATCH=20
# QUALITY_MAX_BODY_BYTES=16384
# QUALITY_MAX_SAMPLE_SKEW_SECS=300
# QUALITY_JOIN_TIMEOUT_SECS=45
# INTERNAL_API_TOKEN also protects GET /internal/metrics and /internal/operations/*
