# LiveKit Egress for meeting-service Part G certification (rendered by run.sh).
# NOT a production configuration (dev key, loopback only, insecure websocket).
api_key: cfmeet-cert-key
api_secret: cfmeet-local-certification-secret-0123456789
ws_url: ws://127.0.0.1:7880
insecure: true
redis:
  address: @REDIS@
  db: 3
# Egress v1.14 reserves 4 CPUs per video room-composite request by default and, when idle,
# offers exactly the host CPU count; on a 2-vCPU GitHub runner every request is refused
# (ErrNotEnoughCPU) before any capture starts. The certification records one short
# composite, so the admission cost is set to fit the runner. Certification host only —
# not a production sizing or capacity claim.
cpu_cost:
  room_composite_cpu_cost: 1.5
health_port: 7981
template_port: 7980
log_level: debug
# Chrome console output in the egress log (diagnostics for the composite template).
debug:
  enable_chrome_logging: true
storage:
  s3:
    access_key: @S3_KEY@
    secret: @S3_SECRET@
    region: us-east-1
    endpoint: @S3_ENDPOINT@
    bucket: @S3_BUCKET@
    force_path_style: true
# Loopback WebRTC inside headless Chrome (local certification only).
chrome_flags:
  allow-loopback-in-peer-connection: true
  disable-features: WebRtcHideLocalIpsWithMdns
