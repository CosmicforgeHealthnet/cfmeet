# CF Meet Platform Access — example configuration.
# Copy to services/platform-access/.env for local development. Never commit a real .env.
# Platform Access is the shared identity authority (ADR 0032): tenants, applications,
# environments, service accounts, API credentials (issuance, rotation, revocation,
# verification), scopes and principals. It serves ONLY the service-authenticated internal
# API: customers never call it directly — Calling and Numbering verify their credentials
# here, and operators administer identity with `platform-access-admin`.
#
# Every secret may instead be mounted as a file named by `<NAME>_FILE` (trimmed
# contents; preferred in staging / production). Setting both NAME and NAME_FILE is
# refused; a missing / unreadable / empty file is refused (never a fallback).

# --- Database ---------------------------------------------------------------
# Platform Access owns its own PostgreSQL database (never Calling's or Numbering's).
# Apply migrations first: make platform-access-migrate
DATABASE_URL=postgres://platform_access:<password>@127.0.0.1:5432/cfmeet_platform_access
# Optional pool size (default 10).
# PLATFORM_ACCESS_DATABASE_MAX_CONNECTIONS=10

# --- HTTP -------------------------------------------------------------------
# Internal API only (service authentication on every /internal route). Default
# 127.0.0.1:8094; the container image uses 0.0.0.0:8094.
PLATFORM_ACCESS_BIND_ADDRESS=127.0.0.1:8094
# Optional SEPARATE listener serving only `GET /metrics` (bounded labels, never an id).
# PLATFORM_ACCESS_METRICS_ADDRESS=127.0.0.1:9194

# --- API credential verifier pepper (REQUIRED, secret) ---------------------
# Keys the HMAC-SHA-256 verifier of every API credential. At least 32 bytes of random
# data; placeholder-looking values are rejected. Generate one per deployment with:
#   openssl rand -base64 48
# When taking over a Part III estate this MUST be the pepper the Part III Calling used
# (moved, not regenerated: the imported verifiers are keyed with it). Store it in your
# secret manager; it is mounted into Platform Access only. Losing it invalidates every
# issued credential.
API_CREDENTIAL_PEPPER=
# Version of the current pepper (default 1). Increase when rotating the pepper.
# API_CREDENTIAL_PEPPER_VERSION=1
# During a pepper rotation only: the previous pepper and its version, accepted for
# verification until every credential minted under it has been rotated.
# API_CREDENTIAL_PREVIOUS_PEPPER=
# API_CREDENTIAL_PREVIOUS_PEPPER_VERSION=

# --- Credential policy ------------------------------------------------------
# CREDENTIAL_DEFAULT_LIFETIME_DAYS=365
# CREDENTIAL_MAX_LIFETIME_DAYS=730
# CREDENTIAL_ROTATION_OVERLAP_MINUTES=1440
# CREDENTIAL_MAX_ROTATION_OVERLAP_MINUTES=43200

# --- Failed-authentication throttling (§109) --------------------------------
# Failed authentications of one presented credential key id tolerated per window; above
# it further FAILURES are reported as throttled (the consumer answers 429) and the
# guessing signal is raised once. A correct secret is always accepted. Unknown key ids
# share one bucket. (1-10000, default 20; window 10-86400 s, default 300.)
# PLATFORM_ACCESS_AUTH_FAILURE_THRESHOLD=20
# PLATFORM_ACCESS_AUTH_FAILURE_WINDOW_SECONDS=300

# --- Internal service authentication (REQUIRED) -----------------------------
# See docs/decisions/0004-internal-service-authentication.md. Optional; if set it must
# be exactly cfmeet.platform-access.
# CF_SERVICE_ID=cfmeet.platform-access
# local | test | staging | production (tokens are bound to it).
CF_RUNTIME_ENVIRONMENT=local
CF_SERVICE_AUTH_KEY_ID=platform-access-local-1
# PKCS#8 PEM Ed25519 private key FILE (mode 0600). Inline keys are refused. Generate:
#   cargo run --manifest-path packages/service-auth/Cargo.toml --bin cf-service-keygen -- \
#     generate --kid platform-access-local-1 --out /secure/path/platform-access-local-1.pem
CF_SERVICE_AUTH_PRIVATE_KEY_FILE=
# Trust bundle: which services may call Platform Access and with which permissions, e.g.
#   cfmeet.calling: platform-credential.authenticate, platform-principal.resolve,
#                   platform-principal.register, platform-identity.read
#   cfmeet.numbering: platform-credential.authenticate, platform-principal.resolve,
#                     platform-identity.read
#   cfmeet.operator-console: platform-identity.administer (sensitive)
CF_SERVICE_TRUST_BUNDLE_FILE=
# Outbound token lifetime in seconds (default 120, 10..300).
# CF_SERVICE_TOKEN_TTL_SECONDS=120

# --- Logging ----------------------------------------------------------------
# pretty (default) | json
# LOG_FORMAT=pretty
