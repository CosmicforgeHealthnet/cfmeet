# CF Meet Numbering — example configuration.
# Copy to services/numbering/.env for local development. Never commit a real .env.
# Numbering is the canonical authority for public Number Resources, provider bindings,
# capabilities, inventory observations, reservations, DCN assignments, ownership, routing
# profiles and the number lifecycle (Part IV Workstreams C-D, ADR 0033). It never owns
# logical calls, SIP / PSTN execution, relay sessions or SMS transport.

# --- Database ---------------------------------------------------------------
# Numbering owns its own PostgreSQL database (never Calling's, Platform Access's, Privacy
# Relay's or Telephony's). Apply migrations first: make numbering-migrate
DATABASE_URL=postgres://numbering:<password>@127.0.0.1:5432/cfmeet_numbering
# Optional pool size (1-500, default 10).
# NUMBERING_DATABASE_MAX_CONNECTIONS=10

# --- HTTP -------------------------------------------------------------------
# Default 127.0.0.1:8095; the container image uses 0.0.0.0:8095.
NUMBERING_BIND_ADDRESS=127.0.0.1:8095
# Optional SEPARATE listener serving only `GET /metrics` (bounded labels, never an id or
# a number).
# NUMBERING_METRICS_ADDRESS=127.0.0.1:9195
# pretty (default) or json
# LOG_FORMAT=pretty

# --- Workers / reliability --------------------------------------------------
# NUMBERING_WORKER_INTERVAL_MS=1000        # 100-60000
# NUMBERING_WORKER_LEASE_SECONDS=60        # 5-3600: a claim not completed in time is recovered
# NUMBERING_OUTBOX_MAX_ATTEMPTS=12         # 1-100, then DEAD_LETTER (visible in /ready)
# NUMBERING_RETRY_BASE_MS=1000             # exponential backoff base ...
# NUMBERING_RETRY_MAX_MS=300000            # ... and cap
# NUMBERING_IDEMPOTENCY_TTL_HOURS=24       # 1-720

# --- Internal service authentication (REQUIRED) ----------------------------
# Numbering's own Ed25519 identity and trust bundle (packages/service-auth). Generate a
# key with: cargo run --manifest-path packages/service-auth/Cargo.toml --bin cf-service-keygen -- generate --kid numbering-local-1 --out <file>
# The private key is mounted as a FILE; inline keys are refused.
CF_RUNTIME_ENVIRONMENT=local
CF_SERVICE_AUTH_KEY_ID=numbering-local-1
CF_SERVICE_AUTH_PRIVATE_KEY_FILE=
# Who may call Numbering's /internal/v1 API and with which permission
# (number-resource.read: Calling, Telephony). Receiver: cfmeet.numbering.
CF_SERVICE_TRUST_BUNDLE_FILE=
# CF_SERVICE_TOKEN_TTL_SECONDS=120
# CF_INTERNAL_HTTP_TIMEOUT_MS=5000

# --- Platform Access (REQUIRED) ---------------------------------------------
# The identity authority: every customer credential is verified there (permission
# platform-credential.authenticate granted to cfmeet.numbering in Platform Access's
# bundle). Unreachable means customer requests are refused (503), never anonymous.
CF_PLATFORM_ACCESS_BASE_URL=http://127.0.0.1:8094

# --- KYC and eligibility (optional; fail closed) -----------------------------
# manual (default) or deterministic (test-only; refused in staging / production).
# NUMBERING_KYC_VERIFIER=manual
# Evidence is refused until BOTH a sealing key and a private store are configured.
# Generate a key with: openssl rand -base64 32   (never commit it)
# NUMBERING_KYC_EVIDENCE_KEY=
# NUMBERING_KYC_EVIDENCE_KEY_ID=kyc-1
# NUMBERING_KYC_EVIDENCE_STORAGE_ENDPOINT=http://127.0.0.1:9000
# NUMBERING_KYC_EVIDENCE_STORAGE_REGION=us-east-1
# NUMBERING_KYC_EVIDENCE_STORAGE_BUCKET=cfmeet-kyc-evidence
# NUMBERING_KYC_EVIDENCE_STORAGE_ACCESS_KEY=
# NUMBERING_KYC_EVIDENCE_STORAGE_SECRET_KEY=
# NUMBERING_KYC_EVIDENCE_STORAGE_SERVER_SIDE_ENCRYPTION=AES256
# NUMBERING_KYC_EVIDENCE_RETENTION_DAYS=730
# NUMBERING_ELIGIBILITY_MAX_NUMBERS_SANDBOX=5

# --- Numbering provider adapters (optional) ----------------------------------
# synthetic = the deterministic test provider (refused in staging / production).
# NUMBERING_PROVIDERS=synthetic
# Generate with: openssl rand -base64 48   (test material only; never commit it)
# NUMBERING_SYNTHETIC_PROVIDER_CALLBACK_SECRET=

# Acquisition limits (Workstream H; defaults shown). PRODUCTION never permits a hold
# before eligibility.
# NUMBERING_SEARCH_REQUESTS_PER_MINUTE=120
# NUMBERING_SEARCH_PAGE_MAX=50
# NUMBERING_INVENTORY_REFRESH_SECONDS=60
# NUMBERING_RESERVATION_TTL_SECONDS=900
# NUMBERING_PRE_ELIGIBILITY_HOLDS=SANDBOX,TEST
