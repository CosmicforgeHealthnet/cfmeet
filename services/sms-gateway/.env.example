# CF Meet SMS Gateway — example configuration.
# Copy to services/sms-gateway/.env for local development. Never commit a real .env.
# The SMS Gateway is the authoritative SMS transport service (Part IV Workstreams M-O,
# ADR 0042): message transports, provider submission and callbacks, delivery receipts,
# inbound routing through Numbering, transport threads, usage and opt-out controls. It
# never owns Number Resources, assignments, KYC or the provider-number lifecycle
# (Numbering), customer webhooks (Calling) or identities (Platform Access).

# --- Database ---------------------------------------------------------------
# The gateway owns its own PostgreSQL database (never another service's). Apply
# migrations first: make sms-gateway-migrate
DATABASE_URL=postgres://sms_gateway:<password>@127.0.0.1:5432/cfmeet_sms_gateway
# SMS_GATEWAY_DATABASE_MAX_CONNECTIONS=10

# --- HTTP -------------------------------------------------------------------
# Default 127.0.0.1:8096; the container image uses 0.0.0.0:8096.
SMS_GATEWAY_BIND_ADDRESS=127.0.0.1:8096
# Optional SEPARATE listener serving only `GET /metrics` (bounded labels, never a number).
# SMS_GATEWAY_METRICS_ADDRESS=127.0.0.1:9196
# LOG_FORMAT=pretty

# --- Content protection (REQUIRED) -----------------------------------------
# Message content, remote numbers and released senders are stored ONLY sealed (AEAD) with
# this key; remote numbers are also kept as keyed fingerprints. Key FILES only (base64);
# inline keys are refused. Generate e.g. with: head -c 32 /dev/urandom | base64
SMS_GATEWAY_CONTENT_KEY_ID=content-local-1
SMS_GATEWAY_CONTENT_KEY_FILE=
# Rotation overlap (old key opens, new key seals):
# SMS_GATEWAY_PREVIOUS_CONTENT_KEY_ID=
# SMS_GATEWAY_PREVIOUS_CONTENT_KEY_FILE=
# A DIFFERENT key (>= 32 bytes) for fingerprints:
SMS_GATEWAY_FINGERPRINT_KEY_FILE=
# SMS_GATEWAY_CONTENT_RETENTION_DAYS=30     # sealed content kept, then purged
# SMS_GATEWAY_QUARANTINE_RETENTION_DAYS=7   # unattributable inbound kept, then purged

# --- Provider ---------------------------------------------------------------
# `deterministic`: the local / test adapter (never a carrier; refused in staging and
# production). Unset: no provider — sends are refused (PROVIDER_UNAVAILABLE).
# No live carrier or aggregator credential is needed for local development.
# SMS_GATEWAY_PROVIDER=deterministic
# SMS_GATEWAY_PROVIDER_CALLBACK_SECRET_FILE=
# SMS_GATEWAY_SUBMIT_TIMEOUT_MS=10000      # past it, the outcome is UNKNOWN (never resubmitted)
# SMS_GATEWAY_MAX_SUBMIT_ATTEMPTS=3        # definitely-unsent attempts before FAILED
# SMS_GATEWAY_VALIDITY_SECONDS=3600

# --- Safety controls ---------------------------------------------------------
# Destinations are refused unless their prefix is allowed (empty: none).
SMS_GATEWAY_ALLOWED_DESTINATION_PREFIXES=+1
# Premium-rate / high-risk ranges, always refused (default shown):
# SMS_GATEWAY_BLOCKED_DESTINATION_PREFIXES=+1900,+1976,+449,+4487,+4470,+882,+883
# SMS_GATEWAY_RATE_PER_MINUTE=60              # per application environment
# SMS_GATEWAY_TENANT_RATE_PER_MINUTE=600
# SMS_GATEWAY_NUMBER_RATE_PER_MINUTE=60       # per sender number
# SMS_GATEWAY_PRINCIPAL_RATE_PER_MINUTE=30
# SMS_GATEWAY_DESTINATION_RATE_PER_HOUR=10    # per recipient
# SMS_GATEWAY_SEGMENT_COST_MINOR=5            # estimate per segment
# SMS_GATEWAY_COST_CURRENCY=USD
# SMS_GATEWAY_DAILY_SPEND_LIMIT_MINOR=10000   # per environment (estimates count until confirmed)
# SMS_GATEWAY_TENANT_DAILY_SPEND_LIMIT_MINOR=100000
# SMS_GATEWAY_ABUSE_IDENTICAL_RECIPIENTS=20   # distinct recipients of identical content per hour
# SMS_GATEWAY_REPEATED_DESTINATION_LIMIT=3    # identical content to one recipient per hour
# SMS_GATEWAY_MAX_SEGMENTS=10
# SMS_GATEWAY_COST_SPIKE_FACTOR=3             # circuit: confirmed cost per segment > 3x the estimate
# SMS_GATEWAY_COST_SPIKE_MIN_SAMPLES=5
# SMS_GATEWAY_PROVIDER_ANOMALY_PERCENT=50     # circuit: rejected / unknown share of recent attempts
# SMS_GATEWAY_PROVIDER_ANOMALY_MIN_ATTEMPTS=10

# --- Workers / reliability --------------------------------------------------
# SMS_GATEWAY_WORKER_INTERVAL_MS=1000
# SMS_GATEWAY_WORKER_LEASE_SECONDS=60
# SMS_GATEWAY_OUTBOX_MAX_ATTEMPTS=12
# SMS_GATEWAY_RETRY_BASE_MS=1000
# SMS_GATEWAY_RETRY_MAX_MS=300000

# --- Internal service authentication (REQUIRED) ----------------------------
# The gateway's own Ed25519 identity (cfmeet.sms-gateway) and trust bundle. Generate a key
# with: cargo run --manifest-path packages/service-auth/Cargo.toml --bin cf-service-keygen -- generate --kid sms-gateway-local-1 --out <file>
CF_RUNTIME_ENVIRONMENT=local
CF_SERVICE_AUTH_KEY_ID=sms-gateway-local-1
CF_SERVICE_AUTH_PRIVATE_KEY_FILE=
# The gateway serves no internal operation: its bundle trusts no issuer
# ({"bundle_version":1,"receiver":"cfmeet.sms-gateway","runtime_environment":"local","trusted_issuers":[]}).
CF_SERVICE_TRUST_BUNDLE_FILE=
# CF_SERVICE_TOKEN_TTL_SECONDS=120
# CF_INTERNAL_HTTP_TIMEOUT_MS=5000

# --- Platform Access (REQUIRED) ---------------------------------------------
# Every customer credential is verified there (platform-credential.authenticate) and
# principals are resolved there (platform-principal.resolve). Unreachable: 503.
CF_PLATFORM_ACCESS_BASE_URL=http://127.0.0.1:8094

# --- Numbering ----------------------------------------------------------------
# Sender grants (number-sms-sender.authorize, number-grant.verify) and inbound destination
# resolution (number-sms-route.resolve). Unset or unreachable: every SMS fails closed.
CF_NUMBERING_BASE_URL=http://127.0.0.1:8095

# --- Calling (customer webhooks) ---------------------------------------------
# sms.* events are published to the platform webhook delivery (platform-event.publish).
# Unset: events stay PENDING in the outbox (visible in /ready).
CF_CALLING_BASE_URL=http://127.0.0.1:8090

# --- Public events (Part VI §53) ---------------------------------------------
# Receivers of committed events: calling (default, today's behaviour), developer-platform
# or both (shadow comparison before the webhook cutover). developer-platform / both need
# the Developer Platform (its trust bundle grants developer-event.publish).
# SMS_GATEWAY_PUBLIC_EVENTS_DESTINATION=calling
# CF_DEVELOPER_PLATFORM_BASE_URL=http://127.0.0.1:8098
