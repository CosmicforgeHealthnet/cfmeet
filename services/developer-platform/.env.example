# CF Meet Developer Platform — example configuration (LOCAL ONLY).
# Copy to services/developer-platform/.env for local development. Never commit a real .env.
# The Developer Platform is the Part VI developer / enterprise control plane (ADR 0055).
# Platform Access stays the ONLY authority for tenants, applications, environments,
# service accounts, API credentials, scopes and principals: this service stores their
# canonical ids only and never verifies a credential.

# --- Database ---------------------------------------------------------------
# Its OWN PostgreSQL database (never another service's). Provision with
# infra/deployment/postgres/provision-service-database.sh --service developer-platform,
# then: make developer-platform-migrate
DATABASE_URL=postgres://developer_platform:<password>@127.0.0.1:5432/cfmeet_developer_platform
# DEVELOPER_PLATFORM_DATABASE_MAX_CONNECTIONS=10

# --- HTTP -------------------------------------------------------------------
# Default 127.0.0.1:8098 (internal only: customers arrive through the API Gateway).
DEVELOPER_PLATFORM_BIND_ADDRESS=127.0.0.1:8098
# LOG_FORMAT=pretty

# --- Feature flags (disabled by default) -------------------------------------
# Serve requests the API Gateway forwards (GET /internal/v1/gateway/context).
DEVELOPER_PLATFORM_GATEWAY_API_ENABLED=false

# --- Worker -----------------------------------------------------------------
# DEVELOPER_PLATFORM_WORKER_INTERVAL_MS=5000
# DEVELOPER_PLATFORM_WORKER_INSTANCE_ID=worker-local-1

# --- Internal service authentication (packages/service-auth) -----------------
# Key FILES only. Generate: cargo run --manifest-path packages/service-auth/Cargo.toml \
#   --bin cf-service-keygen -- generate --kid developer-platform-local-1 --out <file>
# (or infra/api-gateway/local/bootstrap.sh).
CF_RUNTIME_ENVIRONMENT=local
CF_SERVICE_AUTH_KEY_ID=developer-platform-local-1
CF_SERVICE_AUTH_PRIVATE_KEY_FILE=
# Trust bundle: the API Gateway may forward (developer-request.forward); nobody else.
CF_SERVICE_TRUST_BUNDLE_FILE=
# Platform Access (platform-identity.read must be granted to cfmeet.developer-platform in
# Platform Access's own trust bundle).
CF_PLATFORM_ACCESS_BASE_URL=http://127.0.0.1:8094
# Meeting Service session bridge (user-session.verify) for Developer Console sessions;
# unset: console sessions are refused.
CF_MEETING_SERVICE_BASE_URL=
# Calling: controlled webhook migration export (webhook-migration.export).
CF_CALLING_BASE_URL=
