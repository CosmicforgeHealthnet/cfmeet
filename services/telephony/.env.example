# CF Meet Telephony service — example configuration.
# Copy to services/telephony/.env for local development. Never commit a real .env, a
# provider credential, a SIP password, a TLS private key or a callback secret.
# Telephony stores NO private telephone numbers: protected destinations are resolved
# from Privacy Relay per execution and exist only in memory.

# --- Database ---------------------------------------------------------------
# Telephony owns its own PostgreSQL database (never Calling's or Privacy Relay's).
# Apply migrations first: make telephony-migrate
DATABASE_URL=postgres://telephony:<password>@127.0.0.1:5432/cfmeet_telephony
# TELEPHONY_DATABASE_MAX_CONNECTIONS=10

# --- HTTP -------------------------------------------------------------------
# Internal API (service authentication) + GET /health + the provider callback ingress.
TELEPHONY_BIND_ADDRESS=127.0.0.1:8092

# --- Kill switches (all default false) ---------------------------------------
# Each stops NEW paid effects only; terminate / reconcile / usage always run, and
# application RTC never depends on Telephony.
TELEPHONY_ENABLED=false
PUBLIC_OUTBOUND_CALLING_ENABLED=false
PUBLIC_INBOUND_CALLING_ENABLED=false
CALLBACK_RELAY_ENABLED=false
# TELEPHONY_WORKER_INTERVAL_MS=500

# --- Internal service authentication (REQUIRED) -----------------------------
# CF_SERVICE_ID=cfmeet.telephony
CF_RUNTIME_ENVIRONMENT=local
CF_SERVICE_AUTH_KEY_ID=telephony-local-1
# PKCS#8 PEM Ed25519 private key FILE (mode 0600). Inline keys are refused.
CF_SERVICE_AUTH_PRIVATE_KEY_FILE=
# Telephony's trust bundle: it decides which telephony-* permissions Calling holds.
CF_SERVICE_TRUST_BUNDLE_FILE=
# CF_SERVICE_TOKEN_TTL_SECONDS=120
# CF_INTERNAL_HTTP_TIMEOUT_MS=5000
# Calling (normalized events, inbound offers) and Privacy Relay (contact resolution,
# inbound mapping). Without Privacy Relay every protected origination fails closed.
# CALLING_INTERNAL_BASE_URL=http://127.0.0.1:8090
# PRIVACY_RELAY_INTERNAL_BASE_URL=http://127.0.0.1:8091

# --- Interconnect credentials --------------------------------------------------
# Directory of provider credential FILES named by telecom_providers.credential_ref
# (mounted secrets; never in the database).
# TELECOM_PROVIDER_SECRETS_DIR=/run/secrets/telecom

# --- SIP / media edge -----------------------------------------------------------
# none (default: every SIP / public route fails safely) or asterisk-ari.
TELEPHONY_SIP_EDGE=none
# See infra/telephony/README.md for the ARI settings.

# --- Logging ----------------------------------------------------------------
RUST_LOG=telephony=info,warn
LOG_FORMAT=pretty
