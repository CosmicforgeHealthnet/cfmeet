# CF Meet Messaging — example configuration.
# Copy to services/messaging/.env for local development. Never commit a real .env.
# Messaging (Part V, ADR 0045-0048) owns conversations, Messaging devices and their PUBLIC
# MLS material, the key-transparency log and its outbox. It never holds a private key,
# group secret or plaintext E2EE content; identities belong to Platform Access.

# --- Database ---------------------------------------------------------------
# Messaging owns its own PostgreSQL database (never another service's). Provision it with
# infra/deployment/postgres/provision-service-database.sh --service messaging, then apply
# migrations: make messaging-migrate
DATABASE_URL=postgres://messaging:<password>@127.0.0.1:5432/cfmeet_messaging
# MESSAGING_DATABASE_MAX_CONNECTIONS=10

# --- HTTP -------------------------------------------------------------------
# Default 127.0.0.1:8097; the container image uses 0.0.0.0:8097.
MESSAGING_BIND_ADDRESS=127.0.0.1:8097
# Optional SEPARATE listener serving only `GET /metrics` (bounded labels).
# MESSAGING_METRICS_ADDRESS=127.0.0.1:9197
# LOG_FORMAT=pretty

# --- E2EE device operations --------------------------------------------------
# Device registration and KeyPackage publication. Default true only in local / test;
# staging / production need an explicit `true` once the cryptographic decisions are
# approved (ADR 0045).
# MESSAGING_E2EE_DEVICES_ENABLED=true
# MESSAGING_DEVICE_CHALLENGE_TTL_SECONDS=300
# MESSAGING_DEVICE_CHALLENGES_PER_HOUR=20
# MESSAGING_MAX_ACTIVE_DEVICES=10
# MESSAGING_MAX_KEY_PACKAGES_PER_DEVICE=100
# MESSAGING_KEY_PACKAGE_MAX_LIFETIME_DAYS=90
# MESSAGING_DIRECTORY_LOOKUPS_PER_MINUTE=600

# --- Key transparency (Part V G.5) -------------------------------------------
# Every served tree head is signed with this Ed25519 key: a server secret, distinct from
# the service-authentication key (PKCS#8 PEM FILE; cf-service-keygen in
# packages/service-auth produces one). Clients pin its public key out of band. Required;
# inline MESSAGING_KT_SIGNING_KEY is refused.
MESSAGING_KT_LOG_ID=cfmeet-messaging:local
MESSAGING_KT_SIGNING_KEY_FILE=

# --- Authorization caching (reads only) --------------------------------------
# 0 disables. Flushed on any Platform Access identity change; disabled while the change
# feed cannot be read. Mutations always authenticate afresh.
# MESSAGING_AUTH_CACHE_TTL_SECONDS=10
# MESSAGING_IDENTITY_FEED_INTERVAL_MS=2000

# --- Internal service authentication (packages/service-auth) -----------------
CF_RUNTIME_ENVIRONMENT=local
CF_SERVICE_AUTH_KEY_ID=messaging-local-1
# PKCS#8 PEM Ed25519 key FILE (cargo run --bin cf-service-keygen in packages/service-auth).
CF_SERVICE_AUTH_PRIVATE_KEY_FILE=
# Messaging's own trust bundle (no internal operation yet: trusted_issuers is empty).
CF_SERVICE_TRUST_BUNDLE_FILE=
# Platform Access (credential verification, principal resolution, change feed). Its trust
# bundle must grant cfmeet.messaging platform-credential.authenticate,
# platform-principal.resolve and platform-identity.read.
CF_PLATFORM_ACCESS_BASE_URL=http://127.0.0.1:8094
