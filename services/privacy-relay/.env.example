# CF Meet Privacy Relay service — example configuration.
# Copy to services/privacy-relay/.env for local development. Never commit a real .env.
# Privacy Relay stores NO telephone numbers, contact data or customer API credentials;
# customer requests reach it only through Calling's platform ingress, as a signed
# service request carrying a delegated application scope.

# --- Database ---------------------------------------------------------------
# Privacy Relay owns its own PostgreSQL database (never Calling's or the Meeting
# Service's). Apply migrations first: make privacy-relay-migrate
DATABASE_URL=postgres://privacy_relay:<password>@127.0.0.1:5432/cfmeet_privacy_relay
# Optional pool size (default 10).
# PRIVACY_RELAY_DATABASE_MAX_CONNECTIONS=10

# --- HTTP -------------------------------------------------------------------
# Internal API only (service authentication on every /internal route). Default
# 127.0.0.1:8091; the container image uses 0.0.0.0:8091.
PRIVACY_RELAY_BIND_ADDRESS=127.0.0.1:8091

# --- Feature flag -----------------------------------------------------------
# Kill switch (default false). When false, new contexts, new sessions, resumes and
# communication authorizations are refused (PRIVACY_RELAY_DISABLED); restrictive
# operations (suspend, revoke, complete, updates, expiry, enforcement) keep working.
PRIVACY_RELAY_ENABLED=false
# Expiry / enforcement-retry sweep interval in milliseconds (default 1000).
# PRIVACY_RELAY_WORKER_INTERVAL_MS=1000

# --- Internal service authentication (REQUIRED) -----------------------------
# See docs/decisions/0004-internal-service-authentication.md. Optional; if set it must
# be exactly cfmeet.privacy-relay.
# CF_SERVICE_ID=cfmeet.privacy-relay
# local | test | staging | production (tokens are bound to it).
CF_RUNTIME_ENVIRONMENT=local
CF_SERVICE_AUTH_KEY_ID=privacy-relay-local-1
# PKCS#8 PEM Ed25519 private key FILE (mode 0600). Inline keys are refused. Generate:
#   cargo run --manifest-path packages/service-auth/Cargo.toml --bin cf-service-keygen -- \
#     generate --kid privacy-relay-local-1 --out /secure/path/privacy-relay-local-1.pem
CF_SERVICE_AUTH_PRIVATE_KEY_FILE=
# Trust bundle (contract cfmeet.platform.service-trust-bundle). Privacy Relay is the
# receiver: it decides which permissions Calling holds (communication.authorize,
# communication-context.read/write, relay-session.read/write). Example:
#   packages/contracts/platform/service-trust-bundle/examples/privacy-relay-staging.json
CF_SERVICE_TRUST_BUNDLE_FILE=
# CF_SERVICE_TOKEN_TTL_SECONDS=120
# CF_INTERNAL_HTTP_TIMEOUT_MS=5000

# --- Active-call enforcement --------------------------------------------------
# Calling's internal base URL (HTTPS in staging and production). Calling's own trust
# bundle must grant Privacy Relay `communication-authority.enforce`. Without it,
# enforcement jobs stay durably PENDING (authority is still revoked locally).
# CALLING_INTERNAL_BASE_URL=http://127.0.0.1:8090

# --- Contact Vault (Part D §31–§33) -------------------------------------------
# Kill switch (default false). When false, storing or replacing a telephone number is
# refused (CONTACT_VAULT_DISABLED); disabling contacts and blocking verification keep
# working. With true, all three files below are REQUIRED and validated at startup (no
# plaintext fallback, no generated key).
CONTACT_VAULT_ENABLED=false
# AES-256-GCM encryption keyring (secret file, mode 0600, never committed). Generate:
#   privacy-relay-admin contact-vault generate-keyring --purpose encryption --version ck-1 --out /secure/ck.json
# CONTACT_VAULT_KEYRING_FILE=
# HMAC-SHA-256 equality-fingerprint keyring: a DIFFERENT secret file (startup refuses
# shared key material). Generate with --purpose fingerprint.
# CONTACT_FINGERPRINT_KEYRING_FILE=
# Which issuers' Contact Vault access tokens are accepted, with which privacy.contacts.*
# scopes (contract cfmeet.privacy-relay.contact-delegation). Its keys must NOT also be
# trusted for service tokens (startup refuses).
# CONTACT_DELEGATION_TRUST_BUNDLE_FILE=
# Backups of this database contain encrypted contact data and are sensitive.

# --- Logging ----------------------------------------------------------------
RUST_LOG=privacy_relay=info,warn
# pretty (default) or json.
LOG_FORMAT=pretty
