# CF Meet Organizations Service — example configuration (LOCAL ONLY).
# Copy to services/organizations/.env for local development. Never commit a real .env.
# The Organizations Service is the first-party business organization authority
# (Blueprint v1.0 Sections 3-5, ADR 0056). Users are opaque account ids; it stores no
# credential, meeting, message or call data.

# --- Database ---------------------------------------------------------------
# Its OWN PostgreSQL database (never another service's). Provision with
# infra/deployment/postgres/provision-service-database.sh --service organizations,
# then run `organizations-migration up` as the migrator role.
DATABASE_URL=postgres://organizations:<password>@127.0.0.1:5432/cfmeet_organizations
# ORGANIZATIONS_DATABASE_MAX_CONNECTIONS=10

# --- HTTP -------------------------------------------------------------------
# Default 127.0.0.1:8101 (internal only: humans arrive through the Meeting Service relay).
ORGANIZATIONS_BIND_ADDRESS=127.0.0.1:8101
# LOG_FORMAT=pretty
# Maintenance loop (nonce / idempotency sweeps, invitation expiry, outbox).
# ORGANIZATIONS_WORKER_INTERVAL_MS=30000

# --- Internal service authentication (packages/service-auth) ----------------
# CF_SERVICE_ID=cfmeet.organizations
CF_RUNTIME_ENVIRONMENT=local
# The receiver-authoritative trust bundle of cfmeet.organizations (which issuers may call
# with which organization.* permission). Organizations signs nothing yet: no key.
CF_SERVICE_TRUST_BUNDLE_FILE=/etc/cfmeet/organizations/trust-bundle.json
