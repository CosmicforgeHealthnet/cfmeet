# Local development only (see src/config.rs for every variable). Secrets are files.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/cfmeet_notifications
CF_RUNTIME_ENVIRONMENT=local
CF_SERVICE_TRUST_BUNDLE_FILE=./local/trust.json
NOTIFICATIONS_DATA_KEY_ID=local-1
NOTIFICATIONS_DATA_KEY_FILE=./local/data.key
NOTIFICATIONS_BIND_ADDRESS=127.0.0.1:8102
NOTIFICATIONS_EMAIL_PROVIDER=none
NOTIFICATIONS_PUSH_PROVIDER=none
# ADR 0063 partner push (default off); local-test records sends instead of calling APNs / FCM.
NOTIFICATIONS_PARTNER_PUSH_ENABLED=false
# NOTIFICATIONS_PARTNER_PUSH_TRANSPORT=local-test
LOG_FORMAT=pretty
