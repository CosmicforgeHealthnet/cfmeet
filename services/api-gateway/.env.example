# CF Meet public API Gateway — example configuration (LOCAL ONLY).
# Copy to services/api-gateway/.env for local development. Never commit a real .env.
# Default deny (ADR 0055): with the defaults below every customer path is NOT_FOUND.
# The gateway has NO database (DATABASE_URL is refused).

# --- HTTP -------------------------------------------------------------------
API_GATEWAY_BIND_ADDRESS=127.0.0.1:8099
# API_GATEWAY_UPSTREAM_TIMEOUT_MS=10000
# API_GATEWAY_MAX_BODY_BYTES=1048576
# LOG_FORMAT=pretty

# --- Feature flags (disabled by default) -------------------------------------
# Serve the compiled route catalogue (foundation: GET /v1/developer-platform/context).
API_GATEWAY_PUBLIC_ROUTING_ENABLED=false
# Admit WebSocket routes into the catalogue (forwarding them is Section 51).
API_GATEWAY_WEBSOCKETS_ENABLED=false

# --- Quotas and rate limits ---------------------------------------------------
# Platform request quotas are ENFORCED on platform-credential traffic (limits from the
# Developer Platform). Without Redis each instance keeps its own counters; with Redis the
# counters are shared across instances. rediss:// is required in staging/production.
# API_GATEWAY_REDIS_URL=redis://127.0.0.1:6379/4
# API_GATEWAY_REDIS_KEY_PREFIX=cfgw:
# Bound of one quota-store call / connection attempt (20-5000 ms); past it the request is
# counted per instance (readiness reports quotas: degraded).
# API_GATEWAY_REDIS_TIMEOUT_MS=250
# Per-token ceiling of end-user / device traffic (meeting sessions, participant tokens,
# developer sessions, client tokens, signaling credentials, realtime tickets), counted in
# the same store: 0 (default) off, else 10-100000 requests per token per minute.
# API_GATEWAY_TOKEN_RATE_LIMIT_PER_MINUTE=0

# --- Internal service authentication (packages/service-auth) -----------------
# The gateway signs only (no trust bundle: it receives no internal call).
CF_RUNTIME_ENVIRONMENT=local
CF_SERVICE_AUTH_KEY_ID=api-gateway-local-1
CF_SERVICE_AUTH_PRIVATE_KEY_FILE=
# CF_SERVICE_TOKEN_TTL_SECONDS=60
# Platform Access (platform-credential.authenticate must be granted to cfmeet.api-gateway
# in Platform Access's own trust bundle).
CF_PLATFORM_ACCESS_BASE_URL=http://127.0.0.1:8094
# Upstreams (unset: their routes are SERVICE_UNAVAILABLE).
CF_DEVELOPER_PLATFORM_BASE_URL=http://127.0.0.1:8098
