# CF Meet Calling service — example configuration.
# Copy to services/calling/.env for local development. Never commit a real .env.
# There are NO fallback secrets: the service and platform_admin refuse to start without
# a strong API_CREDENTIAL_PEPPER.

# --- Database ---------------------------------------------------------------
# The Calling service owns its own PostgreSQL database (never the Meeting Service one).
# Any directly reachable PostgreSQL works; Docker is not required.
DATABASE_URL=postgres://calling:<password>@127.0.0.1:5432/cfmeet_calling
# Optional pool size (default 10).
# CALLING_DATABASE_MAX_CONNECTIONS=10

# --- HTTP -------------------------------------------------------------------
# Socket address to listen on (default 127.0.0.1:8090; the container image uses 0.0.0.0:8090).
CALLING_BIND_ADDRESS=127.0.0.1:8090

# --- API credential verifier pepper (REQUIRED, secret) ---------------------
# Keys the HMAC-SHA-256 verifier of every API credential. At least 32 bytes of random
# data; placeholder-looking values are rejected. Generate one per deployment with:
#   openssl rand -base64 48
# Store it in your secret manager. Losing it invalidates every issued credential.
API_CREDENTIAL_PEPPER=
# Version of the current pepper (default 1). Increase when rotating the pepper.
# API_CREDENTIAL_PEPPER_VERSION=1
# During a pepper rotation only: the previous pepper and its version, accepted for
# verification until every credential minted under it has been rotated.
# API_CREDENTIAL_PREVIOUS_PEPPER=
# API_CREDENTIAL_PREVIOUS_PEPPER_VERSION=

# --- Credential policy ------------------------------------------------------
# CREDENTIAL_DEFAULT_LIFETIME_DAYS=365
# CREDENTIAL_MAX_LIFETIME_DAYS=730
# CREDENTIAL_ROTATION_OVERLAP_MINUTES=1440
# CREDENTIAL_MAX_ROTATION_OVERLAP_MINUTES=43200

# --- Platform limit defaults (used when neither application nor credential sets one) --
# Telecom spend has no default: it is always zero unless explicitly configured.
# PLATFORM_DEFAULT_REQUESTS_PER_MINUTE=600
# PLATFORM_DEFAULT_MAX_CONCURRENT_COMMUNICATIONS=50

# --- Internal service authentication (REQUIRED) -----------------------------
# Service-to-service requests are authenticated with short-lived Ed25519 (EdDSA) JWS
# tokens in `X-CF-Service-Authorization: Bearer <token>` — never with customer API
# credentials. See docs/decisions/0004-internal-service-authentication.md.
# This service's identity. Optional; if set it must be exactly cfmeet.calling.
# CF_SERVICE_ID=cfmeet.calling
# Deployment runtime environment: local | test | staging | production. Tokens are bound
# to it; a staging token is never valid in production. (Unrelated to customer
# application environments sandbox/test/production.)
CF_RUNTIME_ENVIRONMENT=local
# Key id of the current signing key; published in peers' trust bundles.
CF_SERVICE_AUTH_KEY_ID=calling-local-1
# PKCS#8 PEM Ed25519 private key FILE (mode 0600). Inline keys are refused. Generate:
#   cargo run --manifest-path packages/service-auth/Cargo.toml --bin cf-service-keygen -- \
#     generate --kid calling-local-1 --out /secure/path/calling-local-1.pem
# Never commit a private key; use one key per service and per runtime environment.
CF_SERVICE_AUTH_PRIVATE_KEY_FILE=
# Trust bundle (contract cfmeet.platform.service-trust-bundle): which peers Calling
# accepts, their public keys, and the permissions CALLING grants them.
CF_SERVICE_TRUST_BUNDLE_FILE=
# Outbound token lifetime in seconds (default 120, 10..300).
# CF_SERVICE_TOKEN_TTL_SECONDS=120
# Outbound internal HTTP timeout in milliseconds (default 5000, 100..30000).
# CF_INTERNAL_HTTP_TIMEOUT_MS=5000
# Base URLs of peer services (HTTPS required in staging and production). Optional until
# Calling calls them.
# CF_PRIVACY_RELAY_BASE_URL=
# CF_TELEPHONY_BASE_URL=

# --- Application calling: signaling (REQUIRED) -----------------------------
# Key of the short-lived Call Signaling Credentials handed to devices (HS256). At least
# 32 random characters, separate from every other key; e.g. `openssl rand -base64 48`.
CALLING_SIGNALING_SIGNING_KEY=
# Signaling credential lifetime in seconds (default 600, max 3600).
# CALLING_SIGNALING_CREDENTIAL_TTL_SECONDS=600

# --- Application calling: media provider ------------------------------------
# `none` (default: application calls answer CAPABILITY_UNAVAILABLE) or `livekit`.
# Calling uses its OWN LiveKit key pair and room namespace — never the Meeting Service's.
# CALLING_MEDIA_PROVIDER=none
# Client connection URL (wss://) and server API URL (https://); plain ws/http only on loopback.
# CALLING_LIVEKIT_URL=wss://media.example.com
# CALLING_LIVEKIT_API_URL=https://media.example.com
# CALLING_LIVEKIT_API_KEY=
# Secret (≥ 32 characters); never logged, stored or returned. Keep it in a secret manager.
# CALLING_LIVEKIT_API_SECRET=
# CALLING_LIVEKIT_API_TIMEOUT_MS=5000
# Media join credential lifetime in seconds (default 300, 30..900).
# CALLING_MEDIA_CREDENTIAL_TTL_SECONDS=300

# --- Application calling: ringing and groups ---------------------------------
# CALLING_INVITATION_TTL_SECONDS=45
# CALLING_MAX_GROUP_PARTICIPANTS=16
# CALLING_MAX_ENDPOINTS_PER_PARTICIPANT=10
# CALLING_MEDIA_RECONCILE_INTERVAL_SECONDS=15

# --- Logging ----------------------------------------------------------------
# tracing EnvFilter syntax.
RUST_LOG=calling=info,warn
# pretty (default) or json.
LOG_FORMAT=pretty
