# CF Meet Calling service — example configuration.
# Copy to services/calling/.env for local development. Never commit a real .env.
# There are NO fallback secrets. Customer API credentials are verified by Platform Access
# (services/platform-access, ADR 0032): Calling holds no credential verifier secret, and
# it refuses to start when any API_CREDENTIAL_* setting is present (those belong to
# Platform Access only).
#
# Secret files (Part H §74.11): every secret below may instead be mounted as a file and
# named by `<NAME>_FILE` (trimmed file contents; preferred in staging / production):
#   CALLING_SIGNALING_SIGNING_KEY_FILE, CALLING_MEDIA_EDGE_SIGNING_KEY_FILE,
#   CALLING_LIVEKIT_API_SECRET_FILE, CALLING_WEBHOOK_SECRET_KEY_FILE,
#   CALLING_WEBHOOK_SECRET_KEY_PREVIOUS_FILE, CALLING_ARTIFACT_STORAGE_SECRET_ACCESS_KEY_FILE.
# Setting both NAME and NAME_FILE is refused (ambiguous); a missing / unreadable / empty
# file is refused (never a fallback). Outside CF_RUNTIME_ENVIRONMENT=local|test the file
# must not be readable by group or others (chmod 0400 or 0600). Inline values keep
# working for local development.

# --- Database ---------------------------------------------------------------
# The Calling service owns its own PostgreSQL database (never the Meeting Service one).
# Any directly reachable PostgreSQL works; Docker is not required.
DATABASE_URL=postgres://calling:<password>@127.0.0.1:5432/cfmeet_calling
# Optional pool size (default 10).
# CALLING_DATABASE_MAX_CONNECTIONS=10

# --- HTTP -------------------------------------------------------------------
# Socket address to listen on (default 127.0.0.1:8090; the container image uses 0.0.0.0:8090).
CALLING_BIND_ADDRESS=127.0.0.1:8090

# --- Identity (Platform Access, ADR 0032) -----------------------------------
# Tenants, applications, environments, service accounts, API credentials, scopes and
# principals are owned by Platform Access; Calling keeps a read-only projection of them
# (same ids) and authenticates every customer credential through Platform Access
# (CF_PLATFORM_ACCESS_BASE_URL below, REQUIRED). Credential lifetime / rotation policy and
# the failed-authentication throttle are configured on Platform Access.
# How often the identity change feed is applied to the projection, in milliseconds
# (100-60000, default 1000).
# CALLING_IDENTITY_SYNC_INTERVAL_MS=1000

# --- Platform limit defaults (used when neither application nor credential sets one) --
# Telecom spend has no default: it is always zero unless explicitly configured.
# PLATFORM_DEFAULT_REQUESTS_PER_MINUTE=600
# PLATFORM_DEFAULT_MAX_CONCURRENT_COMMUNICATIONS=50

# --- Internal service authentication (REQUIRED) -----------------------------
# Service-to-service requests are authenticated with short-lived Ed25519 (EdDSA) JWS
# tokens in `X-CF-Service-Authorization: Bearer <token>` — never with customer API
# credentials. See docs/decisions/0004-internal-service-authentication.md.
# This service's identity. Optional; if set it must be exactly cfmeet.calling.
# CF_SERVICE_ID=cfmeet.calling
# Deployment runtime environment: local | test | staging | production. Tokens are bound
# to it; a staging token is never valid in production. (Unrelated to customer
# application environments sandbox/test/production.)
CF_RUNTIME_ENVIRONMENT=local
# Key id of the current signing key; published in peers' trust bundles.
CF_SERVICE_AUTH_KEY_ID=calling-local-1
# PKCS#8 PEM Ed25519 private key FILE (mode 0600). Inline keys are refused. Generate:
#   cargo run --manifest-path packages/service-auth/Cargo.toml --bin cf-service-keygen -- \
#     generate --kid calling-local-1 --out /secure/path/calling-local-1.pem
# Never commit a private key; use one key per service and per runtime environment.
CF_SERVICE_AUTH_PRIVATE_KEY_FILE=
# Trust bundle (contract cfmeet.platform.service-trust-bundle): which peers Calling
# accepts, their public keys, and the permissions CALLING grants them.
CF_SERVICE_TRUST_BUNDLE_FILE=
# Outbound token lifetime in seconds (default 120, 10..300).
# CF_SERVICE_TOKEN_TTL_SECONDS=120
# Outbound internal HTTP timeout in milliseconds (default 5000, 100..30000).
# CF_INTERNAL_HTTP_TIMEOUT_MS=5000
# Base URLs of peer services (HTTPS required in staging and production).
# Platform Access (REQUIRED by the service: it verifies every customer credential; the
# platform_admin CLI needs it only for the commands that reach it).
CF_PLATFORM_ACCESS_BASE_URL=http://127.0.0.1:8094
# Optional until Calling calls them.
# CF_PRIVACY_RELAY_BASE_URL=
# CF_TELEPHONY_BASE_URL=

# --- Contact Vault delegated access (Part D §31) -----------------------------
# Calling mints short-lived Contact Vault access tokens (POST
# /v1/privacy-relay/contact-access-grants) so customers send raw telephone numbers
# straight to Privacy Relay — never through Calling. The key is a DEDICATED Ed25519 key
# (never CF_SERVICE_AUTH_PRIVATE_KEY_FILE; startup refuses the same key). Its public key
# goes into Privacy Relay's CONTACT_DELEGATION_TRUST_BUNDLE_FILE. Without it the grant
# endpoint answers 503.
# CONTACT_DELEGATION_KEY_ID=calling-contact-local-1
# CONTACT_DELEGATION_PRIVATE_KEY_FILE=
# Token lifetime in seconds (default 120, 10..300).
# CONTACT_DELEGATION_TTL_SECONDS=120

# --- Application calling: signaling (REQUIRED) -----------------------------
# Key of the short-lived Call Signaling Credentials handed to devices (HS256). At least
# 32 random characters, separate from every other key; e.g. `openssl rand -base64 48`.
CALLING_SIGNALING_SIGNING_KEY=
# Signaling credential lifetime in seconds (default 600, max 3600).
# CALLING_SIGNALING_CREDENTIAL_TTL_SECONDS=600

# --- Application calling: media provider ------------------------------------
# `none` (default: application calls answer CAPABILITY_UNAVAILABLE) or `livekit`.
# Calling uses its OWN LiveKit key pair and room namespace — never the Meeting Service's.
# CALLING_MEDIA_PROVIDER=none
# LiveKit signaling URL used ONLY by Calling's media connection gateway (never handed to
# clients) and LiveKit's server API URL; plain ws/http only on loopback.
# CALLING_LIVEKIT_URL=wss://livekit.internal.example.com
# CALLING_LIVEKIT_API_URL=https://livekit.internal.example.com
# Public URL of Calling's media connection gateway, handed to clients in media credentials.
# CALLING_MEDIA_GATEWAY_URL=wss://calling.example.com/v1/calling/media
# Seals every client media credential (≥ 32 random characters, distinct from the LiveKit
# secret; LiveKit never knows it): `openssl rand -hex 32`.
# CALLING_MEDIA_EDGE_SIGNING_KEY=
# CALLING_LIVEKIT_API_KEY=
# Secret (≥ 32 characters); never logged, stored or returned. Keep it in a secret manager.
# CALLING_LIVEKIT_API_SECRET=
# CALLING_LIVEKIT_API_TIMEOUT_MS=5000
# Media join credential lifetime in seconds (default 300, 30..900).
# CALLING_MEDIA_CREDENTIAL_TTL_SECONDS=300

# --- Application calling: ringing and groups ---------------------------------
# CALLING_INVITATION_TTL_SECONDS=45
# CALLING_MAX_GROUP_PARTICIPANTS=16
# CALLING_MAX_ENDPOINTS_PER_PARTICIPANT=10
# CALLING_MEDIA_RECONCILE_INTERVAL_SECONDS=15

# --- Calling feature switches (§95) -------------------------------------------
# Server-side switches for NEW calls. Turning one off refuses only new calls of that
# capability (CAPABILITY_UNAVAILABLE / PUBLIC_ROUTE_DENIED); live Calls keep working and
# end cleanly — end, leave, decline, reconciliation, leg release, cleanup and artifact
# deletion never consult a switch. true / false (or 1 / 0); anything else refuses startup.
# Master switch for every new call (application, public, callback, enterprise, inbound
# offers). Default true.
# CALLING_NEW_CALLS_ENABLED=true
# New application (app-to-app RTC) calls. Default true.
# CALLING_APP_CALLING_ENABLED=true
# Public-network (Telephony) classes — default FALSE (opt-in per deployment):
#   app-to-phone calls and the outbound legs of every public class,
# CALLING_PUBLIC_OUTBOUND_ENABLED=false
#   phone-to-app (and phone-to-phone relay) inbound calls,
# CALLING_PUBLIC_INBOUND_ENABLED=false
#   callback relay (the requester is called back and bridged).
# CALLING_CALLBACK_RELAY_ENABLED=false
# Enterprise / voicemail / recording switches: see the Enterprise calling section.

# --- Durable work: Telephony commands, setup deadline, backlog (§81–§86) ------
# Attempts of one durable Telephony command before it is DEAD (never retried again; one
# TELEPHONY_COMMAND_DEAD incident per command). 3..1000, default 40.
# CALLING_TELEPHONY_COMMAND_MAX_ATTEMPTS=40
# A Call still before connect (REQUESTED … RINGING) with no Call event for this long ends
# FAILED (TIMEOUT); its live public / SIP legs are released in the same transaction.
# Must stay above one maximum queue wait (3600 s): 3900..86400, default 7200.
# CALLING_CALL_SETUP_DEADLINE_SECONDS=7200
# Age of the oldest pending outbox event / Telephony command above which ONE
# platform-wide WORKER_BACKLOG incident (per queue) is raised. 60..86400, default 600.
# CALLING_WORKER_BACKLOG_INCIDENT_SECONDS=600

# --- Logging ----------------------------------------------------------------
# tracing EnvFilter syntax.
RUST_LOG=calling=info,warn
# pretty (default) or json.
LOG_FORMAT=pretty

# --- Enterprise calling (Part F) ---------------------------------------------------------
# Kill switches; all default to false. Each stops NEW effects only (routing of new
# enterprise calls, new voicemail capture, new call recordings); termination, disabling
# configuration, finalizing captured artifacts and retention cleanup are never blocked.
# ENTERPRISE_CALLING_ENABLED=false
# VOICEMAIL_ENABLED=false
# CALL_RECORDING_ENABLED=false
# Failed storage deletes of one voicemail / recording artifact after which ONE incident is
# raised (the deletion keeps being retried with backoff; default 5, 1..100).
# CALLING_ARTIFACT_DELETE_INCIDENT_ATTEMPTS=5

# --- Customer webhooks (Part G, ADR 0028) -------------------------------------------------
# 32-byte key (base64) sealing webhook signing secrets at rest; from the secret manager
# (`openssl rand -base64 32`). Weak keys (repeated / low-entropy bytes) are refused.
# Without it, creating or rotating a webhook subscription is refused.
# CALLING_WEBHOOK_SECRET_KEY=
# Its key id (default k0; [A-Za-z0-9_-], 1-32). Stored per subscription.
# CALLING_WEBHOOK_SECRET_KEY_ID=k0
# Key rotation (Part H §74.12, runbook §5): the previous key and its id open existing
# seals while new seals use the current key; `platform_admin webhooks reseal` moves every
# subscription to the current key, `platform_admin webhooks key-status` shows the counts.
# Startup refuses when stored seals name a key that is neither current nor previous.
# CALLING_WEBHOOK_SECRET_KEY_PREVIOUS=
# CALLING_WEBHOOK_SECRET_KEY_PREVIOUS_ID=
# Key id legacy `v1.` seals (made before key ids existed) were sealed with (default k0).
# CALLING_WEBHOOK_SECRET_LEGACY_KEY_ID=k0
# Allow http:// and private-network webhook endpoints — honoured ONLY when
# CF_RUNTIME_ENVIRONMENT=local (refused at startup anywhere else).
# CALLING_WEBHOOK_ALLOW_PRIVATE_ENDPOINTS=false

# --- Abuse and compliance controls (Part H §77, §78) --------------------------------------
# Destination countries (ISO 3166-1 alpha-2, comma separated, or *) whose paid public
# routes always require an operator-recorded compliance eligibility
# (`platform_admin compliance set`); a customer routing policy cannot remove them.
# Default: empty (only the customer policy's complianceRequiredCountries apply).
# CALLING_COMPLIANCE_REQUIRED_COUNTRIES=
# Refusals of one initiator by block rules / destination policy within 10 minutes that
# raise a REPEATED_BLOCKED_ATTEMPTS / REPEATED_ROUTE_DENIALS incident (1-1000, default 5).
# CALLING_BLOCKED_ATTEMPTS_INCIDENT_THRESHOLD=5
# Abuse reports against one principal within 24 hours that raise an ABUSE_REPORTS_BURST
# incident (1-1000, default 3).
# CALLING_ABUSE_REPORTS_INCIDENT_THRESHOLD=3
# Failed-authentication throttling (§109) moved to Platform Access
# (PLATFORM_ACCESS_AUTH_FAILURE_THRESHOLD / _WINDOW_SECONDS); CALLING_AUTH_FAILURE_* is
# refused. Calling still raises the single CREDENTIAL_GUESSING incident when told to.

# --- Retention, deletion and minimization (Part H §80, ADR 0030) --------------------------
# Platform conventions, not legal claims: set per deployment. Integer days (1-3650).
# A terminal Call's display metadata (participant display names, the enterprise entry
# label) is erased this long after it ended; ids, state, timestamps and relations stay.
# CALLING_RETENTION_CALL_DISPLAY_DAYS=365
# Terminal webhook deliveries (+ attempts) and webhook events without deliveries.
# CALLING_RETENTION_WEBHOOK_HISTORY_DAYS=90
# RESOLVED Calling incidents (counted from resolution; OPEN incidents are never deleted).
# CALLING_RETENTION_INCIDENTS_DAYS=365
# Media-provider / telephony provider events of terminal (or unknown) Calls.
# CALLING_RETENTION_MEDIA_PROVIDER_EVENTS_DAYS=30
# Operator audit rows (own bound, independent of the audited resource).
# CALLING_RETENTION_OPERATOR_AUDIT_DAYS=2555
# Call events are RETAINED (outbox source, transition evidence): setting this refuses startup.
# CALLING_RETENTION_CALL_EVENTS_DAYS=
# Worker tick (seconds, 5-86400); at most 500 rows per class per tick.
# CALLING_RETENTION_INTERVAL_SECS=60
