{
  "description": "One service account. Its free-text description is not relayed.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "service_account_id",
    "application_id",
    "environment_id",
    "name",
    "status",
    "revoked_at",
    "revision",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "service_account_id": {
      "type": "string",
      "format": "uuid"
    },
    "application_id": {
      "type": "string",
      "format": "uuid"
    },
    "environment_id": {
      "type": "string",
      "format": "uuid"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "status": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
    },
    "revoked_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
