{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "items",
    "next_cursor",
    "from",
    "to",
    "price_book_id",
    "version_id",
    "currency",
    "estimate"
  ],
  "properties": {
    "items": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "#/components/schemas/FinanceWorkspaceCharges"
      }
    },
    "next_cursor": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[A-Za-z0-9._~:@+=-]{1,512}$"
    },
    "from": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "to": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "price_book_id": {
      "type": "string",
      "format": "uuid"
    },
    "version_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "estimate": {
      "const": true
    }
  },
  "description": "Estimated charges (an estimate, one currency, minor units) under the PARTNER_PLATFORM price book of the request's market, over the window's UTC days [from, to]."
}
