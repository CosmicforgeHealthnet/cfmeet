{
  "description": "Request of messaging.switch.change (POST /internal/v1/operator/switches/{switch_id}).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "operation_id",
    "reason_code",
    "expected_version",
    "engaged"
  ],
  "properties": {
    "operation_id": {
      "type": "string",
      "format": "uuid",
      "description": "HQ's command id; equal to the Idempotency-Key header."
    },
    "reason_code": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{1,63}$"
    },
    "note": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "expected_version": {
      "type": "integer",
      "minimum": 0,
      "description": "The resource version the command applies to (VERSION_CONFLICT otherwise); 0 means none yet where allowed."
    },
    "environment_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "engaged": {
      "type": "boolean"
    }
  }
}
