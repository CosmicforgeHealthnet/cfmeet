{
  "description": "The effective suppression of one recipient, by the Notification Service's keyed digest only. The address is never relayed.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "recipient_digest",
    "channel",
    "reason",
    "created_at",
    "version"
  ],
  "properties": {
    "recipient_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "channel": {
      "const": "EMAIL"
    },
    "reason": {
      "enum": [
        "COMPLAINED",
        "HARD_BOUNCE",
        "MANUAL"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "notifications.suppression.remove's expected_version."
    }
  }
}
