{
  "description": "The verification queue, most recently changed first (CANCELLED cases are not listed).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "items",
    "next_cursor"
  ],
  "properties": {
    "items": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "#/components/schemas/VerificationCase"
      }
    },
    "next_cursor": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[A-Za-z0-9._~:@+=-]{1,512}$"
    }
  }
}
