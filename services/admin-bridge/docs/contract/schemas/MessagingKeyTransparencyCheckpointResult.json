{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "operation",
    "resource"
  ],
  "properties": {
    "operation": {
      "$ref": "#/components/schemas/OperationReadback"
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tree_size",
        "root_hash",
        "verdict",
        "checked_at"
      ],
      "properties": {
        "tree_size": {
          "type": "integer"
        },
        "root_hash": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:@-]{1,128}$"
        },
        "verdict": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
        },
        "checked_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "description": "The resource after messaging.key-transparency.checkpoint; status: CHECKPOINTED, ROLLBACK_DETECTED, UNVERIFIABLE."
    }
  }
}
