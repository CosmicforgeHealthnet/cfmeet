{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "operation",
    "resource"
  ],
  "properties": {
    "operation": {
      "$ref": "#/components/schemas/OperationReadback"
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "environment_id",
        "application_id",
        "policy_id",
        "admin_capabilities",
        "version",
        "updated_at"
      ],
      "properties": {
        "environment_id": {
          "type": "string",
          "format": "uuid"
        },
        "application_id": {
          "type": "string",
          "format": "uuid"
        },
        "policy_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "admin_capabilities": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._:@-]{1,128}$"
          }
        },
        "version": {
          "type": "integer"
        },
        "updated_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      },
      "description": "The resource after calling.enterprise-features.change; status: CONFIGURED."
    }
  }
}
