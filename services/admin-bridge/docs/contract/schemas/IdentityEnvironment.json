{
  "description": "One environment of a tenant's application.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "environment_id",
    "application_id",
    "kind",
    "status",
    "live_telecom_allowed",
    "revision",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "environment_id": {
      "type": "string",
      "format": "uuid"
    },
    "application_id": {
      "type": "string",
      "format": "uuid"
    },
    "kind": {
      "enum": [
        "SANDBOX",
        "TEST",
        "PRODUCTION"
      ]
    },
    "status": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
    },
    "live_telecom_allowed": {
      "type": "boolean"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
