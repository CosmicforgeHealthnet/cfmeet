{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "operation",
    "resource"
  ],
  "properties": {
    "operation": {
      "$ref": "#/components/schemas/OperationReadback"
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "export_id",
        "conversation_id",
        "export_state",
        "delivery",
        "delivery_channel",
        "delivery_ref",
        "recipient_principal_id",
        "recipient_masked",
        "size_bytes",
        "sha256",
        "failure",
        "created_at",
        "completed_at",
        "delivered_at",
        "expires_at",
        "tenant_id",
        "application_id",
        "environment_id"
      ],
      "properties": {
        "export_id": {
          "type": "string",
          "format": "uuid"
        },
        "conversation_id": {
          "type": "string",
          "format": "uuid"
        },
        "export_state": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
        },
        "delivery": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
        },
        "delivery_channel": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
        },
        "delivery_ref": {
          "type": "string",
          "format": "uuid"
        },
        "recipient_principal_id": {
          "type": "string",
          "format": "uuid"
        },
        "recipient_masked": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 120,
          "pattern": "^(\\*\\*\\*|[^@\\s*]\\*\\*\\*@[^@\\s*.]\\*\\*\\*(\\.[^@\\s*.]{1,63})?)$",
          "description": "A masked address (first character of the local part and of the domain label), never the address."
        },
        "size_bytes": {
          "type": [
            "integer",
            "null"
          ]
        },
        "sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Za-z0-9._:@-]{1,128}$"
        },
        "failure": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "completed_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "delivered_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "tenant_id": {
          "type": "string",
          "format": "uuid"
        },
        "application_id": {
          "type": "string",
          "format": "uuid"
        },
        "environment_id": {
          "type": "string",
          "format": "uuid"
        }
      },
      "description": "The resource after messaging.export.request; status: REQUESTED."
    }
  }
}
