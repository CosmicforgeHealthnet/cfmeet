{
  "description": "Per-channel provider status from configuration and recent deliveries. Never a credential, key or provider response.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "checked_at",
    "providers"
  ],
  "properties": {
    "checked_at": {
      "type": "string",
      "format": "date-time"
    },
    "providers": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "channel",
          "configured",
          "status",
          "last_success_at",
          "last_failure_at",
          "last_error_class",
          "recent_deliveries"
        ],
        "properties": {
          "channel": {
            "enum": [
              "EMAIL",
              "PUSH"
            ]
          },
          "configured": {
            "type": "boolean"
          },
          "status": {
            "enum": [
              "OK",
              "DEGRADED",
              "UNKNOWN",
              "NOT_CONFIGURED"
            ]
          },
          "last_success_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "last_failure_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "last_error_class": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
          },
          "recent_deliveries": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  }
}
