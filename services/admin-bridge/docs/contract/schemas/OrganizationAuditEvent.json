{
  "description": "One organization audit event: who, what, when and the target. The owner's free-form summary is not relayed.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "sequence",
    "organization_id",
    "action",
    "actor",
    "target_type",
    "target_id",
    "occurred_at"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "organization_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "action": {
      "type": "string",
      "pattern": "^[a-z][a-z._]{0,63}$"
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "user_id",
        "service"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
        },
        "user_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "service": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      }
    },
    "target_type": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "target_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
