{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "operation",
    "resource"
  ],
  "properties": {
    "operation": {
      "$ref": "#/components/schemas/OperationReadback"
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "report_id",
        "target_cfmeet_id",
        "decision",
        "reason",
        "held",
        "reviewed_at",
        "version"
      ],
      "properties": {
        "report_id": {
          "type": "string",
          "format": "uuid"
        },
        "target_cfmeet_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Za-z0-9._:@-]{1,128}$"
        },
        "decision": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
        },
        "reason": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
        },
        "held": {
          "type": "boolean"
        },
        "reviewed_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "version": {
          "type": "integer"
        }
      },
      "description": "The resource after communications.report.review; status: DISMISSED, ACTIONED."
    }
  }
}
