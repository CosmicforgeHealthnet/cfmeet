            "string",
            "null"
          ],
          "format": "uuid"
        },
        "environment_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "kind": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
        },
        "tokens_not_before": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
