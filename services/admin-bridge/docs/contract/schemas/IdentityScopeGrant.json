{
  "description": "One scope granted to an application.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "application_id",
    "scope",
    "allowed_environment_kinds",
    "grant_basis",
    "granted_at"
  ],
  "properties": {
    "application_id": {
      "type": "string",
      "format": "uuid"
    },
    "scope": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "allowed_environment_kinds": {
      "type": [
        "array",
        "null"
      ],
      "maxItems": 3,
      "items": {
        "enum": [
          "SANDBOX",
          "TEST",
          "PRODUCTION"
        ]
      }
    },
    "grant_basis": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
    },
    "granted_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
