{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "operation",
    "resource"
  ],
  "properties": {
    "operation": {
      "$ref": "#/components/schemas/OperationReadback"
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "delivery_id",
        "notification_id",
        "channel",
        "lane",
        "delivery_state",
        "attempts",
        "last_error_class",
        "next_attempt_at"
      ],
      "properties": {
        "delivery_id": {
          "type": "string",
          "format": "uuid"
        },
        "notification_id": {
          "type": "string",
          "format": "uuid"
        },
        "channel": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
        },
        "lane": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
        },
        "delivery_state": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
        },
        "attempts": {
          "type": "integer"
        },
        "last_error_class": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
        },
        "next_attempt_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      },
      "description": "The resource after notifications.delivery.retry; status: RETRIED."
    }
  }
}
