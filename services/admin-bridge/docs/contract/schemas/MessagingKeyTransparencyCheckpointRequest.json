{
  "description": "Request of messaging.key-transparency.checkpoint (POST /internal/v1/operator/key-transparency/checkpoint).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "operation_id",
    "reason_code"
  ],
  "properties": {
    "operation_id": {
      "type": "string",
      "format": "uuid",
      "description": "HQ's command id; equal to the Idempotency-Key header."
    },
    "reason_code": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{1,63}$"
    },
    "note": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    }
  }
}
