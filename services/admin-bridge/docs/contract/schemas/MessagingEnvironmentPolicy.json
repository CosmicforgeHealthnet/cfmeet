{
  "description": "An environment's chat policy as it applies: the override version (expected_version of messaging.policy.change; 0 while none is stored), the effective policy and its digest. The override document itself is not relayed.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tenant_id",
    "application_id",
    "environment_id",
    "version",
    "digest",
    "platform_policy_version",
    "effective"
  ],
  "properties": {
    "tenant_id": {
      "type": "string",
      "format": "uuid"
    },
    "application_id": {
      "type": "string",
      "format": "uuid"
    },
    "environment_id": {
      "type": "string",
      "format": "uuid"
    },
    "version": {
      "type": "integer",
      "minimum": 0
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "platform_policy_version": {
      "type": "integer",
      "minimum": 0
    },
    "effective": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "platform_policy_version",
        "application_policy_version",
        "sending_enabled",
        "messages",
        "attachments",
        "privacy",
        "retention",
        "moderation",
        "editing",
        "abuse",
        "backups",
        "contexts"
      ],
      "properties": {
        "schema_version": {
          "type": "integer"
        },
        "platform_policy_version": {
          "type": "integer"
        },
        "application_policy_version": {
          "type": "integer"
        },
        "sending_enabled": {
          "type": "boolean"
        },
        "messages": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "replies",
            "threads",
            "reactions",
            "pins",
            "forwarding",
            "forward_shows_original_sender"
          ],
          "properties": {
            "replies": {
              "type": "boolean"
            },
            "threads": {
              "type": "boolean"
            },
            "reactions": {
              "type": "boolean"
            },
            "pins": {
              "type": "boolean"
            },
            "forwarding": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "forward_shows_original_sender": {
              "type": [
                "boolean",
                "null"
              ]
            }
          }
        },
        "attachments": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "enabled",
            "max_bytes",
            "max_per_message",
            "allowed_kinds",
            "managed_scan_required",
            "max_voice_note_seconds",
            "max_video_seconds",
            "storage_budget_bytes",
            "daily_upload_bytes",
            "max_concurrent_uploads"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "max_bytes": {
              "type": "integer"
            },
            "max_per_message": {
              "type": "integer"
            },
            "allowed_kinds": {
              "type": "array",
              "maxItems": 64,
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z0-9._:@-]{1,128}$"
              }
            },
            "managed_scan_required": {
              "type": "boolean"
            },
            "max_voice_note_seconds": {
              "type": "integer"
            },
            "max_video_seconds": {
              "type": "integer"
            },
            "storage_budget_bytes": {
              "type": [
                "integer",
                "null"
              ]
            },
            "daily_upload_bytes": {
              "type": [
                "integer",
                "null"
              ]
            },
            "max_concurrent_uploads": {
              "type": "integer"
            }
          }
        },
        "privacy": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "presence",
            "typing_indicators",
            "read_receipts",
            "last_seen",
            "delivery_receipts"
          ],
          "properties": {
            "presence": {
              "type": "boolean"
            },
            "typing_indicators": {
              "type": "boolean"
            },
            "read_receipts": {
              "type": "boolean"
            },
            "last_seen": {
              "type": "boolean"
            },
            "delivery_receipts": {
              "type": "boolean"
            }
          }
        },
        "retention": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "message_days",
            "deleted_purge_grace_seconds"
          ],
          "properties": {
            "message_days": {
              "type": [
                "integer",
                "null"
              ]
            },
            "deleted_purge_grace_seconds": {
              "type": "integer"
            }
          }
        },
        "moderation": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "enabled",
            "reports_enabled",
            "managed_evidence_allowed"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "reports_enabled": {
              "type": "boolean"
            },
            "managed_evidence_allowed": {
              "type": "boolean"
            }
          }
        },
        "editing": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "edit_window_seconds",
            "delete_window_seconds",
            "revision_history_visible"
          ],
          "properties": {
            "edit_window_seconds": {
              "type": [
                "integer",
                "null"
              ]
            },
            "delete_window_seconds": {
              "type": [
                "integer",
                "null"
              ]
            },
            "revision_history_visible": {
              "type": "boolean"
            }
          }
        },
        "abuse": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "messages_per_minute",
            "new_direct_contacts_per_hour",
            "reports_per_hour",
            "uploads_per_hour",
            "managed_links_per_hour"
          ],
          "properties": {
            "messages_per_minute": {
              "type": "integer"
            },
            "new_direct_contacts_per_hour": {
              "type": "integer"
            },
            "reports_per_hour": {
              "type": "integer"
            },
            "uploads_per_hour": {
              "type": "integer"
            },
            "managed_links_per_hour": {
              "type": "integer"
            }
          }
        },
        "backups": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "max_bytes",
            "retain_count"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "max_bytes": {
              "type": "integer"
            },
            "retain_count": {
              "type": "integer"
            }
          }
        },
        "contexts": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "context_class",
              "enabled",
              "allowed_profiles",
              "default_profile",
              "max_members",
              "max_lifetime_seconds",
              "reopen_allowed",
              "legal_hold_eligible",
              "sms_bridge_eligible",
              "regulated",
              "central_archive_required",
              "reporting_enabled",
              "exports_enabled",
              "attachments_enabled",
              "retention_days",
              "requests_require_acceptance"
            ],
            "properties": {
              "enabled": {
                "type": "boolean"
              },
              "allowed_profiles": {
                "type": "array",
                "maxItems": 64,
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9._:@-]{1,128}$"
                }
              },
              "default_profile": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
              },
              "max_members": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "max_lifetime_seconds": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "reopen_allowed": {
                "type": "boolean"
              },
              "legal_hold_eligible": {
                "type": "boolean"
              },
              "sms_bridge_eligible": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "regulated": {
                "type": "boolean"
              },
              "central_archive_required": {
                "type": "boolean"
              },
              "reporting_enabled": {
                "type": "boolean"
              },
              "exports_enabled": {
                "type": "boolean"
              },
              "attachments_enabled": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "retention_days": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "requests_require_acceptance": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "context_class": {
                "enum": [
                  "DIRECT",
                  "GROUP",
                  "MEETING",
                  "TRANSACTION",
                  "CONSULTATION",
                  "SUPPORT",
                  "ENTERPRISE",
                  "DEVELOPER_DEFINED"
                ]
              }
            }
          }
        }
      },
      "description": "The policy in force (flags, limits, enums; no personal data)."
    }
  }
}
