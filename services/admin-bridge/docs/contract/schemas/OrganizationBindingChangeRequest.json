{
  "description": "Request of organizations.binding.change (POST /internal/v1/admin/organizations/{organization_id}/scopes/primary/service-bindings/{service}/change).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "operation_id",
    "expected_version",
    "action"
  ],
  "properties": {
    "operation_id": {
      "type": "string",
      "format": "uuid",
      "description": "HQ's command id; equal to the Idempotency-Key header."
    },
    "reason_code": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{1,63}$"
    },
    "note": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "expected_version": {
      "type": "integer",
      "minimum": 0,
      "description": "The resource version the command applies to (VERSION_CONFLICT otherwise); 0 means none yet where allowed."
    },
    "action": {
      "enum": [
        "SET",
        "CLEAR"
      ]
    },
    "service_account_id": {
      "type": "string",
      "format": "uuid"
    },
    "credential_id": {
      "type": "string",
      "format": "uuid"
    }
  }
}
