{
  "description": "Request of communications.events.replay (POST /internal/v1/communications/operator/replay).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "operation_id",
    "event_id"
  ],
  "properties": {
    "operation_id": {
      "type": "string",
      "format": "uuid",
      "description": "HQ's command id; equal to the Idempotency-Key header."
    },
    "reason_code": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{1,63}$"
    },
    "note": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "event_id": {
      "type": "string",
      "format": "uuid"
    }
  }
}
