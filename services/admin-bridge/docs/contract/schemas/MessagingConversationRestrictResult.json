{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "operation",
    "resource"
  ],
  "properties": {
    "operation": {
      "$ref": "#/components/schemas/OperationReadback"
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "conversation_id",
        "lifecycle_state",
        "lifecycle_reason",
        "state_changed_at"
      ],
      "properties": {
        "conversation_id": {
          "type": "string",
          "format": "uuid"
        },
        "lifecycle_state": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
        },
        "lifecycle_reason": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
        },
        "state_changed_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "description": "The resource after messaging.conversation.restrict; status: LOCKED."
    }
  }
}
