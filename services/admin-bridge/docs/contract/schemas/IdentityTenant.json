{
  "description": "One Platform Access tenant.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tenant_id",
    "slug",
    "display_name",
    "classification",
    "status",
    "billing_currency",
    "revision",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "tenant_id": {
      "type": "string",
      "format": "uuid"
    },
    "slug": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "display_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "classification": {
      "enum": [
        "FIRST_PARTY",
        "EXTERNAL"
      ]
    },
    "status": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
    },
    "billing_currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
