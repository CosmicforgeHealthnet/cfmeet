{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "items",
    "next_cursor"
  ],
  "properties": {
    "items": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "#/components/schemas/PricingPlan"
      }
    },
    "next_cursor": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[A-Za-z0-9._~:@+=-]{1,512}$"
    }
  },
  "description": "Every plan in one page (next_cursor is always null)."
}
