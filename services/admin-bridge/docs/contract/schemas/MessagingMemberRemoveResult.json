{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "operation",
    "resource"
  ],
  "properties": {
    "operation": {
      "$ref": "#/components/schemas/OperationReadback"
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "conversation_id",
        "principal_id",
        "member_state",
        "action_id",
        "acted_at"
      ],
      "properties": {
        "conversation_id": {
          "type": "string",
          "format": "uuid"
        },
        "principal_id": {
          "type": "string",
          "format": "uuid"
        },
        "member_state": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
        },
        "action_id": {
          "type": "string",
          "format": "uuid"
        },
        "acted_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "description": "The resource after messaging.member.remove; status: REMOVED."
    }
  }
}
