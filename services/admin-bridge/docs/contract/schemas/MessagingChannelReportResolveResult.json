{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "operation",
    "resource"
  ],
  "properties": {
    "operation": {
      "$ref": "#/components/schemas/OperationReadback"
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "report_id",
        "channel_id",
        "post_id",
        "report_status",
        "resolved_at"
      ],
      "properties": {
        "report_id": {
          "type": "string",
          "format": "uuid"
        },
        "channel_id": {
          "type": "string",
          "format": "uuid"
        },
        "post_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "report_status": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
        },
        "resolved_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "description": "The resource after messaging.channel-report.resolve; status: ACTIONED, DISMISSED."
    }
  }
}
