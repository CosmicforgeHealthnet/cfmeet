{
  "description": "Request of partners.usage.reprocess (POST /internal/v1/operator/usage/rollups/rebuild).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "operation_id",
    "from",
    "to"
  ],
  "properties": {
    "operation_id": {
      "type": "string",
      "format": "uuid",
      "description": "HQ's command id; equal to the Idempotency-Key header."
    },
    "reason_code": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{1,63}$",
      "description": "Kept in the bridge's operation record; not sent to the owning service."
    },
    "note": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "from": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "to": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "environment_id": {
      "type": "string",
      "format": "uuid"
    }
  }
}
