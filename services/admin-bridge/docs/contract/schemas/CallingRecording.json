{
  "description": "Recording metadata only: never an object key or media URL.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "recording_id",
    "call_id",
    "environment_id",
    "state",
    "capture_source",
    "duration_ms",
    "size_bytes",
    "retention_until",
    "created_at",
    "deleted_at",
    "version"
  ],
  "properties": {
    "recording_id": {
      "type": "string",
      "format": "uuid"
    },
    "call_id": {
      "type": "string",
      "format": "uuid"
    },
    "environment_id": {
      "type": "string",
      "format": "uuid"
    },
    "state": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
    },
    "capture_source": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
    },
    "duration_ms": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "size_bytes": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "retention_until": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "deleted_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    }
  }
}
