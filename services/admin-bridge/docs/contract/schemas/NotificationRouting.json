{
  "description": "Routing per category and channel, and the hourly route audit (accepted decisions per producer and category).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "routing_protocols",
    "routes",
    "audit"
  ],
  "properties": {
    "routing_protocols": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "integer",
        "minimum": 1
      }
    },
    "routes": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "category",
          "channel",
          "mode",
          "version",
          "canary_percent",
          "fence_at"
        ],
        "properties": {
          "category": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
          },
          "channel": {
            "enum": [
              "EMAIL",
              "PUSH",
              "IN_APP",
              "OPERATOR"
            ]
          },
          "mode": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
          },
          "version": {
            "type": "integer",
            "minimum": 0
          },
          "canary_percent": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "fence_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "audit": {
      "type": "array",
      "maxItems": 2000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "producer",
          "category",
          "hour",
          "accepted_decisions"
        ],
        "properties": {
          "producer": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9.-]{0,63}$"
          },
          "category": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
          },
          "hour": {
            "type": "string",
            "format": "date-time"
          },
          "accepted_decisions": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  }
}
