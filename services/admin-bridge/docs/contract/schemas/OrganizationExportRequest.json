{
  "description": "Request of organizations.organization.export (POST /internal/v1/admin/organizations/{organization_id}/exports).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "operation_id"
  ],
  "properties": {
    "operation_id": {
      "type": "string",
      "format": "uuid",
      "description": "HQ's command id; equal to the Idempotency-Key header."
    },
    "reason_code": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{1,63}$",
      "description": "Kept in the bridge's operation record; not sent to the owning service."
    },
    "note": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    }
  }
}
