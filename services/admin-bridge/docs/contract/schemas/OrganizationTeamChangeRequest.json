{
  "description": "Request of organizations.team.change (POST /internal/v1/admin/organizations/{organization_id}/teams/{team_id}/change).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "operation_id",
    "expected_version"
  ],
  "properties": {
    "operation_id": {
      "type": "string",
      "format": "uuid",
      "description": "HQ's command id; equal to the Idempotency-Key header."
    },
    "reason_code": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{1,63}$"
    },
    "note": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "expected_version": {
      "type": "integer",
      "minimum": 1,
      "description": "The resource version the command applies to (VERSION_CONFLICT otherwise); 0 means none yet where allowed."
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "description": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 0,
      "maxLength": 500
    },
    "team_state": {
      "enum": [
        "ARCHIVED"
      ]
    }
  }
}
