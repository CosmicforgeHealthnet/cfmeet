        "application_id",
        "currency",
        "enabled",
        "daily_limit_minor",
        "monthly_limit_minor",
        "revision",
        "updated_at"
      ],
      "properties": {
        "environment_id": {
          "type": "string",
          "format": "uuid"
        },
        "application_id": {
          "type": "string",
          "format": "uuid"
        },
        "currency": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
        },
        "enabled": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "daily_limit_minor": {
          "type": [
            "integer",
            "null"
          ]
        },
        "monthly_limit_minor": {
          "type": [
            "integer",
            "null"
          ]
        },
        "revision": {
          "type": "integer"
        },
        "updated_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      },
      "description": "The resource after calling.spend-limits.change; status: ENABLED, DISABLED."
    }
  }
