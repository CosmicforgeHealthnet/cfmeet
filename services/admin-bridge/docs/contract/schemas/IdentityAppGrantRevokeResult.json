{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "operation",
    "resource"
  ],
  "properties": {
    "operation": {
      "$ref": "#/components/schemas/OperationReadback"
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "app_id",
        "target",
        "tenant_id",
        "environment_id",
        "principal_id",
        "grant_state",
        "revoked_at",
        "revoke_reason",
        "revision",
        "updated_at"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "app_id": {
          "type": "string",
          "format": "uuid"
        },
        "target": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Za-z0-9._:@-]{1,128}$"
        },
        "tenant_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "environment_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "principal_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "grant_state": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
        },
        "revoked_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "revoke_reason": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
        },
        "revision": {
          "type": "integer"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "description": "The resource after identity.app-grant.revoke; status: REVOKED."
    }
  }
}
