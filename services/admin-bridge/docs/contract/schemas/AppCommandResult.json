        },
        "workspace_id": {
          "type": "string",
          "format": "uuid"
        },
        "state": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
        },
        "published_version": {
          "type": [
            "integer",
            "null"
          ]
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "description": "The resource after apps.app.lift-suspension; status: any state code."
