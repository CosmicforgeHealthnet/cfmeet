{
  "description": "One verification case with its decision details (verification.cases.read only).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "case_id",
    "product",
    "kind",
    "subject_ref",
    "state",
    "version",
    "assignee_ref",
    "submitted_at",
    "updated_at",
    "evidence",
    "approvals_required",
    "partner_tenant_id",
    "details"
  ],
  "properties": {
    "case_id": {
      "type": "string",
      "pattern": "^cfmeet:(PARTNER_GO_LIVE|APP_REVIEW):[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "maxLength": 128
    },
    "product": {
      "const": "cfmeet"
    },
    "kind": {
      "enum": [
        "PARTNER_GO_LIVE",
        "APP_REVIEW"
      ]
    },
    "subject_ref": {
      "type": "string",
      "format": "uuid"
    },
    "state": {
      "enum": [
        "OPEN",
        "CLAIMED",
        "APPROVED",
        "REJECTED",
        "PUBLISHED",
        "SUSPENDED",
        "CANCELLED"
      ]
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "assignee_ref": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^(hq:[A-Za-z0-9._:@-]{1,128}|operator:[A-Za-z0-9][A-Za-z0-9._@-]{0,99})$",
      "maxLength": 132
    },
    "submitted_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "evidence": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "ref",
          "sha256"
        ],
        "properties": {
          "kind": {
            "enum": [
              "USE_CASE_SUMMARY",
              "APP_MANIFEST"
            ]
          },
          "ref": {
            "type": "string",
            "pattern": "^[0-9a-f-]{36}:[a-z0-9-]{1,16}$",
            "maxLength": 53
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "approvals_required": {
      "const": 2
    },
    "partner_tenant_id": {
      "type": "string",
      "format": "uuid"
    },
    "details": {
      "oneOf": [
        {
          "description": "PARTNER_GO_LIVE: what is asked for and what was approved (product capability ids).",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "requested_capabilities",
            "approved_capabilities"
          ],
          "properties": {
            "requested_capabilities": {
              "type": "array",
              "minItems": 0,
              "maxItems": 16,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9_]{1,63}$"
              }
            },
            "approved_capabilities": {
              "type": "array",
              "minItems": 0,
              "maxItems": 16,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9_]{1,63}$"
              }
            }
          }
        },
        {
          "description": "APP_REVIEW: the manifest version under review and the published one.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "app_version",
            "published_version"
          ],
          "properties": {
            "app_version": {
              "type": "integer",
              "minimum": 1
            },
            "published_version": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1
            }
          }
        }
      ]
    }
  }
}
