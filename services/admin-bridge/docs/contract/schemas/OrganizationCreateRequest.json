{
  "description": "Request of organizations.organization.create (POST /internal/v1/admin/organizations).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "operation_id",
    "name",
    "slug"
  ],
  "properties": {
    "operation_id": {
      "type": "string",
      "format": "uuid",
      "description": "HQ's command id; equal to the Idempotency-Key header."
    },
    "reason_code": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{1,63}$"
    },
    "note": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "slug": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "owner_user_id": {
      "type": "string",
      "format": "uuid"
    }
  }
}
