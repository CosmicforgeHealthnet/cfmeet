{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "operation",
    "resource"
  ],
  "properties": {
    "operation": {
      "$ref": "#/components/schemas/OperationReadback"
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "application_id",
        "tenant_id",
        "scope",
        "granted",
        "allowed_environment_kinds",
        "grant_basis",
        "granted_at"
      ],
      "properties": {
        "application_id": {
          "type": "string",
          "format": "uuid"
        },
        "tenant_id": {
          "type": "string",
          "format": "uuid"
        },
        "scope": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:@-]{1,128}$"
        },
        "granted": {
          "type": "boolean"
        },
        "allowed_environment_kinds": {
          "type": [
            "array",
            "null"
          ],
          "maxItems": 64,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._:@-]{1,128}$"
          }
        },
        "grant_basis": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
        },
        "granted_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      },
      "description": "The resource after identity.privileged-scope-grant.change; status: GRANTED, REVOKED."
    }
  }
}
