{
  "description": "Request of messaging.export.request (POST /internal/v1/operator/exports). The owner receives the request's tenant scope as its tenant; the body never names a tenant.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "operation_id",
    "reason_code",
    "conversation_id",
    "recipient_principal_id"
  ],
  "properties": {
    "operation_id": {
      "type": "string",
      "format": "uuid",
      "description": "HQ's command id; equal to the Idempotency-Key header."
    },
    "reason_code": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{1,63}$"
    },
    "note": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "conversation_id": {
      "type": "string",
      "format": "uuid"
    },
    "recipient_principal_id": {
      "type": "string",
      "format": "uuid"
    }
  }
}
