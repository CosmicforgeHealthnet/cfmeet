{
  "description": "Request of partners.support-tier.change (POST /internal/v1/operator/organizations/{workspace_id}/support-profile).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "operation_id",
    "expected_version",
    "support_tier"
  ],
  "properties": {
    "operation_id": {
      "type": "string",
      "format": "uuid",
      "description": "HQ's command id; equal to the Idempotency-Key header."
    },
    "reason_code": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{1,63}$",
      "description": "Kept in the bridge's operation record; not sent to the owning service."
    },
    "note": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "expected_version": {
      "type": "integer",
      "minimum": 0,
      "description": "The resource version the command applies to (VERSION_CONFLICT otherwise); 0 means none yet where allowed."
    },
    "support_tier": {
      "enum": [
        "COMMUNITY",
        "STANDARD",
        "PREMIUM",
        "ENTERPRISE",
        "INTERNAL"
      ]
    },
    "support_reference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    }
  }
}
