{
  "description": "Request of partners.incident.record (POST /internal/v1/operator/organizations/{workspace_id}/incidents).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "operation_id",
    "expected_version",
    "workspace_id",
    "incident_ref",
    "occurred_at"
  ],
  "properties": {
    "operation_id": {
      "type": "string",
      "format": "uuid",
      "description": "HQ's command id; equal to the Idempotency-Key header."
    },
    "reason_code": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{1,63}$",
      "description": "Kept in the bridge's operation record; not sent to the owning service."
    },
    "note": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "expected_version": {
      "type": "integer",
      "minimum": 0,
      "description": "The resource version the command applies to (VERSION_CONFLICT otherwise); 0 means none yet where allowed."
    },
    "workspace_id": {
      "type": "string",
      "format": "uuid"
    },
    "incident_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time",
      "maxLength": 40,
      "pattern": "Z$"
    }
  }
}
