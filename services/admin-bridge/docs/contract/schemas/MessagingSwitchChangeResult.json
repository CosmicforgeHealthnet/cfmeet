{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "operation",
    "resource"
  ],
  "properties": {
    "operation": {
      "$ref": "#/components/schemas/OperationReadback"
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "switch_name",
        "scope_key",
        "engaged",
        "reason",
        "changed_at"
      ],
      "properties": {
        "switch_name": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
        },
        "scope_key": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:@-]{1,128}$"
        },
        "engaged": {
          "type": "boolean"
        },
        "reason": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
        },
        "changed_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "description": "The resource after messaging.switch.change; status: ENGAGED, RELEASED."
    }
  }
}
