{
  "description": "One API key: its public id and last four characters, scopes, state and times. Never the secret, the verifier, its algorithm or key version, or the free-text label.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "credential_id",
    "public_id",
    "last4",
    "application_id",
    "environment_id",
    "service_account_id",
    "status",
    "scopes",
    "not_before",
    "expires_at",
    "revoked_at",
    "superseded_at",
    "suspended_at",
    "suspension_reason",
    "last_used_at",
    "revision",
    "created_at"
  ],
  "properties": {
    "credential_id": {
      "type": "string",
      "format": "uuid"
    },
    "public_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,32}$"
    },
    "last4": {
      "type": "string",
      "pattern": "^[A-Za-z0-9]{4}$"
    },
    "application_id": {
      "type": "string",
      "format": "uuid"
    },
    "environment_id": {
      "type": "string",
      "format": "uuid"
    },
    "service_account_id": {
      "type": "string",
      "format": "uuid"
    },
    "status": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
    },
    "scopes": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100
      }
    },
    "not_before": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "revoked_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "superseded_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "suspended_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "suspension_reason": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 64
    },
    "last_used_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
