{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "operation",
    "resource"
  ],
  "properties": {
    "operation": {
      "$ref": "#/components/schemas/OperationReadback"
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "organization_id",
        "team_id",
        "team_state",
        "version",
        "parent_team_id",
        "member_count",
        "updated_at"
      ],
      "properties": {
        "organization_id": {
          "type": "string",
          "format": "uuid"
        },
        "team_id": {
          "type": "string",
          "format": "uuid"
        },
        "team_state": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
        },
        "version": {
          "type": "integer"
        },
        "parent_team_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "member_count": {
          "type": "integer"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "description": "The resource after organizations.team.change; status: ACTIVE, ARCHIVED."
    }
  }
}
