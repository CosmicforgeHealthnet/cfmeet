{
  "description": "Operational view of one business organization. Contact details (address, public email, registration number) are never included.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "organization_id",
    "name",
    "slug",
    "lifecycle_status",
    "provisioning_state",
    "member_count",
    "created_at",
    "updated_at",
    "version",
    "creation_source",
    "archived_at",
    "organization_type",
    "industry",
    "country_code",
    "legal_verification"
  ],
  "properties": {
    "organization_id": {
      "type": "string",
      "format": "uuid"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "slug": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "lifecycle_status": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
    },
    "provisioning_state": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
    },
    "member_count": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "version": {
      "type": "integer",
      "minimum": 0
    },
    "creation_source": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
    },
    "archived_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "organization_type": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 64
    },
    "industry": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 128
    },
    "country_code": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[A-Z]{2}$"
    },
    "legal_verification": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
    }
  }
}
