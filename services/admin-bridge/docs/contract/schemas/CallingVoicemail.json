{
  "description": "Voicemail metadata only: never an object key, media URL or caller identity.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "message_id",
    "call_id",
    "mailbox_id",
    "environment_id",
    "state",
    "read_state",
    "duration_ms",
    "size_bytes",
    "retention_until",
    "received_at",
    "deleted_at"
  ],
  "properties": {
    "message_id": {
      "type": "string",
      "format": "uuid"
    },
    "call_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "mailbox_id": {
      "type": "string",
      "format": "uuid"
    },
    "environment_id": {
      "type": "string",
      "format": "uuid"
    },
    "state": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
    },
    "read_state": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
    },
    "duration_ms": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "size_bytes": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "retention_until": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "received_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "deleted_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  }
}
