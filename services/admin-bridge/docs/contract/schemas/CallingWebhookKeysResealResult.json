{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "operation",
    "resource"
  ],
  "properties": {
    "operation": {
      "$ref": "#/components/schemas/OperationReadback"
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tenant_id",
        "keys"
      ],
      "properties": {
        "tenant_id": {
          "type": "string",
          "format": "uuid"
        },
        "keys": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "key_id",
              "subscriptions"
            ],
            "properties": {
              "key_id": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^[A-Za-z0-9._:@-]{1,128}$"
              },
              "subscriptions": {
                "type": "integer"
              }
            }
          }
        }
      },
      "description": "The resource after calling.webhook-keys.reseal; status: RESEALED."
    }
  }
}
