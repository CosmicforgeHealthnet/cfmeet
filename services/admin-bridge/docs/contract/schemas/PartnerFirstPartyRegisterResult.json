{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "operation",
    "resource"
  ],
  "properties": {
    "operation": {
      "$ref": "#/components/schemas/OperationReadback"
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workspace_id",
        "workspace_state",
        "version",
        "created_at",
        "delivery",
        "delivery_channel",
        "delivery_ref",
        "recipient_masked",
        "delivery_state",
        "claim_state",
        "expires_at",
        "owner_invitation_id"
      ],
      "properties": {
        "workspace_id": {
          "type": "string",
          "format": "uuid"
        },
        "workspace_state": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
        },
        "version": {
          "type": "integer"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "delivery": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
        },
        "delivery_channel": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
        },
        "delivery_ref": {
          "type": "string",
          "format": "uuid"
        },
        "recipient_masked": {
          "type": "string",
          "maxLength": 120,
          "pattern": "^(\\*\\*\\*|[^@\\s*]\\*\\*\\*@[^@\\s*.]\\*\\*\\*(\\.[^@\\s*.]{1,63})?)$",
          "description": "A masked address (first character of the local part and of the domain label), never the address."
        },
        "delivery_state": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
        },
        "claim_state": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "owner_invitation_id": {
          "type": "string",
          "format": "uuid"
        }
      },
      "description": "The resource after partners.workspace.register-first-party; status: INVITED."
    }
  }
}
