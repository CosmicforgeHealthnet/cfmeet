{
  "description": "Request of identity.key.issue (POST /internal/v1/operator/service-accounts/{service_account_id}/credentials).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "operation_id",
    "expected_version",
    "service_account_id",
    "scopes"
  ],
  "properties": {
    "operation_id": {
      "type": "string",
      "format": "uuid",
      "description": "HQ's command id; equal to the Idempotency-Key header."
    },
    "reason_code": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{1,63}$",
      "description": "Kept in the bridge's operation record; not sent to the owning service."
    },
    "note": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "expected_version": {
      "type": "integer",
      "minimum": 1,
      "description": "The resource version the command applies to (VERSION_CONFLICT otherwise); 0 means none yet where allowed."
    },
    "service_account_id": {
      "type": "string",
      "format": "uuid"
    },
    "scopes": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100
      }
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "maxLength": 40,
      "pattern": "Z$"
    }
  }
}
