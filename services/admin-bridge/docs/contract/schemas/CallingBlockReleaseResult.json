{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "operation",
    "resource"
  ],
  "properties": {
    "operation": {
      "$ref": "#/components/schemas/OperationReadback"
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "block_rule_id",
        "application_id",
        "environment_id",
        "block_state",
        "released_at",
        "version"
      ],
      "properties": {
        "block_rule_id": {
          "type": "string",
          "format": "uuid"
        },
        "application_id": {
          "type": "string",
          "format": "uuid"
        },
        "environment_id": {
          "type": "string",
          "format": "uuid"
        },
        "block_state": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
        },
        "released_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "version": {
          "type": "integer"
        }
      },
      "description": "The resource after calling.block.release; status: RELEASED."
    }
  }
}
