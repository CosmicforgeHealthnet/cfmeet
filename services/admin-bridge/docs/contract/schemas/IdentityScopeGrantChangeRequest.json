{
  "description": "Request of identity.scope-grant.change (POST /internal/v1/operator/applications/{application_id}/scope-grants).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "operation_id",
    "application_id",
    "action",
    "scope"
  ],
  "properties": {
    "operation_id": {
      "type": "string",
      "format": "uuid",
      "description": "HQ's command id; equal to the Idempotency-Key header."
    },
    "reason_code": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{1,63}$"
    },
    "note": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "application_id": {
      "type": "string",
      "format": "uuid"
    },
    "action": {
      "enum": [
        "GRANT",
        "REVOKE"
      ]
    },
    "scope": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "environment_kinds": {
      "type": "array",
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "enum": [
          "SANDBOX",
          "TEST",
          "PRODUCTION"
        ]
      }
    }
  }
}
