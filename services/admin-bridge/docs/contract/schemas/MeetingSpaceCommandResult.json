{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "operation",
    "resource"
  ],
  "properties": {
    "operation": {
      "$ref": "#/components/schemas/OperationReadback"
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "space_id",
        "space_state",
        "owner_user_id",
        "archived_at"
      ],
      "properties": {
        "space_id": {
          "type": "string",
          "format": "uuid"
        },
        "space_state": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:@-]{1,128}$"
        },
        "owner_user_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "archived_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      },
      "description": "The resource after meetings.space.transfer; status: TRANSFERRED."
    }
  }
}
