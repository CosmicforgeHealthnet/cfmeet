{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "operation",
    "resource"
  ],
  "properties": {
    "operation": {
      "$ref": "#/components/schemas/OperationReadback"
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "email_uniqueness",
        "username_uniqueness"
      ],
      "properties": {
        "email_uniqueness": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enforced",
            "duplicate_groups"
          ],
          "properties": {
            "enforced": {
              "type": "boolean"
            },
            "duplicate_groups": {
              "type": "array",
              "maxItems": 100,
              "items": {
                "type": "array",
                "maxItems": 100,
                "items": {
                  "type": "string",
                  "format": "uuid"
                }
              }
            }
          }
        },
        "username_uniqueness": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enforced",
            "duplicate_groups"
          ],
          "properties": {
            "enforced": {
              "type": "boolean"
            },
            "duplicate_groups": {
              "type": "array",
              "maxItems": 100,
              "items": {
                "type": "array",
                "maxItems": 100,
                "items": {
                  "type": "string",
                  "format": "uuid"
                }
              }
            }
          }
        }
      },
      "description": "The resource after accounts.duplicates.enforce; status: ENFORCED, PARTIALLY_ENFORCED, NOT_ENFORCED."
    }
  }
}
