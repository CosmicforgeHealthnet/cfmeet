{
  "description": "Request of calling.spend-limits.change (POST /internal/v1/operator/spend-policies/{environment_id}). The owner receives the request's tenant scope as its tenant; the body never names a tenant.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "operation_id",
    "expected_version",
    "environment_id",
    "currency",
    "leg_allowance_minor",
    "max_leg_seconds",
    "daily_limit_minor",
    "monthly_limit_minor",
    "max_concurrent_legs",
    "max_originations_per_minute",
    "max_per_party_per_hour",
    "enabled"
  ],
  "properties": {
    "operation_id": {
      "type": "string",
      "format": "uuid",
      "description": "HQ's command id; equal to the Idempotency-Key header."
    },
    "reason_code": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{1,63}$",
      "description": "Kept in the bridge's operation record; not sent to the owning service."
    },
    "note": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "expected_version": {
      "type": "integer",
      "minimum": 0,
      "description": "The resource version the command applies to (VERSION_CONFLICT otherwise); 0 means none yet where allowed."
    },
    "environment_id": {
      "type": "string",
      "format": "uuid"
    },
    "currency": {
      "type": "string",
      "minLength": 3,
      "maxLength": 3
    },
    "leg_allowance_minor": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000000000000
    },
    "max_leg_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000000000000
    },
    "daily_limit_minor": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000000000000
    },
    "monthly_limit_minor": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000000000000
    },
    "max_concurrent_legs": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000000000000
    },
    "max_originations_per_minute": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000000000000
    },
    "max_per_party_per_hour": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000000000000
    },
    "max_per_principal_per_hour": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1,
      "maximum": 1000000000000000
    },
    "max_per_service_account_per_hour": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1,
      "maximum": 1000000000000000
    },
    "max_per_context_per_hour": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1,
      "maximum": 1000000000000000
    },
    "enabled": {
      "type": "boolean"
    }
  }
}
