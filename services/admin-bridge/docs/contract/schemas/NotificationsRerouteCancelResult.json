{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "operation",
    "resource"
  ],
  "properties": {
    "operation": {
      "$ref": "#/components/schemas/OperationReadback"
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision_id",
        "category",
        "event_state",
        "reject_reason",
        "processed_at"
      ],
      "properties": {
        "decision_id": {
          "type": "string",
          "format": "uuid"
        },
        "category": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
        },
        "event_state": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
        },
        "reject_reason": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Za-z0-9._:@-]{1,128}$"
        },
        "processed_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      },
      "description": "The resource after notifications.reroute.cancel; status: CANCELLED."
    }
  }
}
