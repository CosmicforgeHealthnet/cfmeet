{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "operation",
    "resource"
  ],
  "properties": {
    "operation": {
      "$ref": "#/components/schemas/OperationReadback"
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "abuse_report_id",
        "application_id",
        "environment_id",
        "call_id",
        "category",
        "report_state",
        "reviewed_at",
        "version"
      ],
      "properties": {
        "abuse_report_id": {
          "type": "string",
          "format": "uuid"
        },
        "application_id": {
          "type": "string",
          "format": "uuid"
        },
        "environment_id": {
          "type": "string",
          "format": "uuid"
        },
        "call_id": {
          "type": "string",
          "format": "uuid"
        },
        "category": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
        },
        "report_state": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
        },
        "reviewed_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "version": {
          "type": "integer"
        }
      },
      "description": "The resource after calling.abuse-report.resolve; status: REVIEWED, DISMISSED, OPEN."
    }
  }
}
