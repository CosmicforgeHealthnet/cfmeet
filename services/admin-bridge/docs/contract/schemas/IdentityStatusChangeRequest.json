{
  "description": "Request of identity.status.change (POST /internal/v1/operator/{resource_type}/{resource_id}/status).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "operation_id",
    "expected_version",
    "resource_state"
  ],
  "properties": {
    "operation_id": {
      "type": "string",
      "format": "uuid",
      "description": "HQ's command id; equal to the Idempotency-Key header."
    },
    "reason_code": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{1,63}$"
    },
    "note": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "expected_version": {
      "type": "integer",
      "minimum": 1,
      "description": "The resource version the command applies to (VERSION_CONFLICT otherwise); 0 means none yet where allowed."
    },
    "resource_state": {
      "enum": [
        "ACTIVE",
        "SUSPENDED",
        "REVOKED"
      ]
    }
  }
}
