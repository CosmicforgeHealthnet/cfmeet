{
  "description": "One installation grant of an app. Targets are opaque ids; scopes are counted, not listed.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "grant_id",
    "target_kind",
    "organization_id",
    "principal_id",
    "scope_count",
    "status",
    "revoked_reason",
    "installed_at",
    "updated_at"
  ],
  "properties": {
    "grant_id": {
      "type": "string",
      "format": "uuid"
    },
    "target_kind": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
    },
    "organization_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "principal_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "scope_count": {
      "type": "integer",
      "minimum": 0
    },
    "status": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
    },
    "revoked_reason": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
    },
    "installed_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
