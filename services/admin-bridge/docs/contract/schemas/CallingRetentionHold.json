{
  "description": "A retention hold of the tenant or the platform. The placing operator is not relayed.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "hold_id",
    "scope",
    "data_class",
    "resource_id",
    "environment_id",
    "reason_code",
    "active",
    "created_at",
    "released_at"
  ],
  "properties": {
    "hold_id": {
      "type": "string",
      "format": "uuid"
    },
    "scope": {
      "enum": [
        "PLATFORM",
        "TENANT"
      ]
    },
    "data_class": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "resource_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "environment_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "reason_code": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
    },
    "active": {
      "type": "boolean"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "released_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  }
}
