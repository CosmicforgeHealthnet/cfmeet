{
  "description": "Request of pricing.plan.assign (POST /internal/v1/operator/pricing/plan-assignments).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "operation_id",
    "expected_version",
    "holder_kind",
    "holder_id",
    "plan_code",
    "price_book_id"
  ],
  "properties": {
    "operation_id": {
      "type": "string",
      "format": "uuid",
      "description": "HQ's command id; equal to the Idempotency-Key header."
    },
    "reason_code": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{1,63}$"
    },
    "note": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "expected_version": {
      "type": "integer",
      "minimum": 0,
      "description": "The resource version the command applies to (VERSION_CONFLICT otherwise); 0 means none yet where allowed."
    },
    "holder_kind": {
      "enum": [
        "USER",
        "ORGANIZATION"
      ]
    },
    "holder_id": {
      "type": "string",
      "format": "uuid"
    },
    "plan_code": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
    },
    "price_book_id": {
      "type": "string",
      "format": "uuid"
    },
    "billing_account_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    }
  }
}
