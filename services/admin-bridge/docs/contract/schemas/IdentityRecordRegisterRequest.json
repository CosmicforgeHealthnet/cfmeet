{
  "description": "Request of identity.record.register (POST /internal/v1/operator/environments/{environment_id}/principals).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "operation_id",
    "environment_id"
  ],
  "properties": {
    "operation_id": {
      "type": "string",
      "format": "uuid",
      "description": "HQ's command id; equal to the Idempotency-Key header."
    },
    "reason_code": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{1,63}$"
    },
    "note": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "environment_id": {
      "type": "string",
      "format": "uuid"
    },
    "kind": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
    },
    "external_reference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "service_account_id": {
      "type": "string",
      "format": "uuid"
    }
  }
}
