{
  "description": "One account security event (sign-ins and changes): type, outcome, actor kind and time. No detail, IP address or location.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "sequence",
    "event_type",
    "outcome",
    "actor_kind",
    "actor_user_id",
    "session_id",
    "occurred_at"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "event_type": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
    },
    "outcome": {
      "enum": [
        "SUCCESS",
        "FAILURE",
        "DENIED"
      ]
    },
    "actor_kind": {
      "enum": [
        "USER",
        "ADMIN",
        "SYSTEM",
        "ANONYMOUS"
      ]
    },
    "actor_user_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "session_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
