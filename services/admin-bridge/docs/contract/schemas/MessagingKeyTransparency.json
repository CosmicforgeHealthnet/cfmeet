{
  "description": "Key-transparency status: the tree head (null before the first leaf) and each witness state. No key material.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "head",
    "witnesses"
  ],
  "properties": {
    "head": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "description": "The key-transparency tree head.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tree_size",
            "root_hash",
            "updated_at"
          ],
          "properties": {
            "tree_size": {
              "type": "integer",
              "minimum": 0
            },
            "root_hash": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "updated_at": {
              "type": "string",
              "format": "date-time"
            }
          }
        }
      ]
    },
    "witnesses": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "description": "One witness's last verified state.",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "witness_id",
          "tree_size",
          "root_hash",
          "updated_at",
          "last_cosigned_size"
        ],
        "properties": {
          "witness_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9.:-]{2,63}$"
          },
          "tree_size": {
            "type": "integer",
            "minimum": 0
          },
          "root_hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "last_cosigned_size": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          }
        }
      }
    }
  }
}
