{
  "description": "One conference audit event. No actor or target reference, metadata or request id.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "space_id",
    "meeting_id",
    "actor_type",
    "action",
    "target_type",
    "occurred_at"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "space_id": {
      "type": "string",
      "format": "uuid"
    },
    "meeting_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "actor_type": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
    },
    "action": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
    },
    "target_type": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
