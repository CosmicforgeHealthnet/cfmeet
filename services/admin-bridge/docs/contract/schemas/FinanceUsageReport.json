{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "items",
    "next_cursor",
    "from",
    "to"
  ],
  "properties": {
    "items": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "#/components/schemas/FinanceUsageRow"
      }
    },
    "next_cursor": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[A-Za-z0-9._~:@+=-]{1,512}$"
    },
    "from": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "to": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    }
  },
  "description": "Usage per workspace over the window's UTC days [from, to] (at most 31 days)."
}
