{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "operation",
    "resource"
  ],
  "properties": {
    "operation": {
      "$ref": "#/components/schemas/OperationReadback"
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "public_id",
        "tenant_id",
        "application_id",
        "environment_id",
        "service_account_id",
        "credential_state",
        "suspended_at",
        "suspension_reason",
        "revoked_at",
        "revision",
        "version",
        "updated_at"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "public_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:@-]{1,128}$"
        },
        "tenant_id": {
          "type": "string",
          "format": "uuid"
        },
        "application_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "environment_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "service_account_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "credential_state": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
        },
        "suspended_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "suspension_reason": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
        },
        "revoked_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "revision": {
          "type": "integer"
        },
        "version": {
          "type": "integer"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "description": "The resource after partners.key.revoke; status: REVOKED, ACTIVE, SUSPENDED."
    }
  }
}
