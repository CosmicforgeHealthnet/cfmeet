{
  "description": "Request of communications.report.review (POST /internal/v1/communications/operator/reports/{report_id}/review).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "operation_id",
    "expected_version",
    "decision",
    "reason"
  ],
  "properties": {
    "operation_id": {
      "type": "string",
      "format": "uuid",
      "description": "HQ's command id; equal to the Idempotency-Key header."
    },
    "reason_code": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{1,63}$"
    },
    "note": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "expected_version": {
      "type": "integer",
      "minimum": 1,
      "description": "The resource version the command applies to (VERSION_CONFLICT otherwise); 0 means none yet where allowed."
    },
    "decision": {
      "enum": [
        "DISMISSED",
        "ACTIONED"
      ]
    },
    "reason": {
      "enum": [
        "NO_VIOLATION",
        "ABUSE",
        "SECURITY",
        "LEGAL",
        "OTHER"
      ]
    },
    "hold_target": {
      "type": "boolean"
    }
  }
}
