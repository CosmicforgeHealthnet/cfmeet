{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "operation",
    "resource"
  ],
  "properties": {
    "operation": {
      "$ref": "#/components/schemas/OperationReadback"
    },
    "resource": {
      "description": "The switch after the change.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "switch_id",
        "owner",
        "state",
        "version",
        "changed_at"
      ],
      "properties": {
        "switch_id": {
          "type": "string",
          "pattern": "^[a-z][a-z-]{0,31}:[A-Za-z0-9._:-]{1,160}$"
        },
        "owner": {
          "enum": [
            "messaging",
            "notifications"
          ]
        },
        "state": {
          "enum": [
            "ENGAGED",
            "RELEASED",
            "OFF",
            "SHADOW",
            "ACTIVE"
          ]
        },
        "version": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "changed_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    }
  }
}
