{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "code",
    "message"
  ],
  "properties": {
    "code": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{1,63}$"
    },
    "message": {
      "type": "string",
      "maxLength": 256
    },
    "operation_id": {
      "type": "string",
      "format": "uuid"
    }
  }
}
