{
  "description": "One block rule. A blocked contact is only reported as present, never named.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "block_rule_id",
    "application_id",
    "environment_id",
    "blocker_kind",
    "blocker_principal_id",
    "blocked_kind",
    "blocked_principal_id",
    "has_contact_reference",
    "reason_code",
    "status",
    "created_at",
    "released_at",
    "version"
  ],
  "properties": {
    "block_rule_id": {
      "type": "string",
      "format": "uuid"
    },
    "application_id": {
      "type": "string",
      "format": "uuid"
    },
    "environment_id": {
      "type": "string",
      "format": "uuid"
    },
    "blocker_kind": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
    },
    "blocker_principal_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "blocked_kind": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
    },
    "blocked_principal_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "has_contact_reference": {
      "type": "boolean"
    },
    "reason_code": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
    },
    "status": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "released_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "version": {
      "type": "integer",
      "minimum": 0
    }
  }
}
