{
  "description": "A live meeting's evaluated health.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "meeting_id",
    "space_id",
    "lifecycle_state",
    "health_state",
    "evaluated_at"
  ],
  "properties": {
    "meeting_id": {
      "type": "string",
      "format": "uuid"
    },
    "space_id": {
      "type": "string",
      "format": "uuid"
    },
    "lifecycle_state": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
    },
    "health_state": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
    },
    "evaluated_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
