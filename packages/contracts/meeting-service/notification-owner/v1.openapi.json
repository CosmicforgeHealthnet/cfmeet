{
  "openapi": "3.1.0",
  "info": {
    "title": "CF Meet Meeting Service / Account — Notification Service owner API",
    "version": "1.1.0",
    "description": "Owner read and fencing APIs the Meeting Service (Account authority and conferences) exposes to the Notification Service only (blueprint Document 4 §3.4): X1 resolveAccountContacts, X2 resolveConferenceRecipients, X6 claimCriticalSendLeases, X7 completeCriticalSends. Frozen by roadmap N1; implemented in N6 (X1, X2) and N12 (X6, X7). Grantable to cfmeet.notifications only. Batches ≤ 100."
  },
  "paths": {
    "/internal/v1/accounts/notification-contacts/resolve": {
      "post": {
        "operationId": "resolveAccountContacts",
        "summary": "Resolve notification contacts (X1)",
        "description": "Per cfmeet-user ref (≤ 100): status, email address, display name, locale, time zone and device states. Addresses are returned only to cfmeet.notifications and go only into email ledger rows.",
        "tags": [
          "Notification owner"
        ],
        "security": [
          {
            "cfServiceAuth": []
          }
        ],
        "x-cfmeet-internal-permission": "account-contacts.read",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "accountRefs"
                ],
                "properties": {
                  "accountRefs": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 100,
                    "uniqueItems": true,
                    "items": {
                      "$ref": "https://schemas.cfmeet.com/notifications/common/v1.schema.json#/$defs/AccountRef"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Contacts.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "results"
                  ],
                  "properties": {
                    "results": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "accountRef",
                          "status"
                        ],
                        "properties": {
                          "accountRef": {
                            "$ref": "https://schemas.cfmeet.com/notifications/common/v1.schema.json#/$defs/AccountRef"
                          },
                          "status": {
                            "type": "string",
                            "enum": [
                              "ACTIVE",
                              "DEACTIVATED",
                              "SUSPENDED",
                              "ERASED",
                              "UNKNOWN"
                            ]
                          },
                          "email": {
                            "type": [
                              "string",
                              "null"
                            ],
                            "maxLength": 254
                          },
                          "displayName": {
                            "type": [
                              "string",
                              "null"
                            ],
                            "maxLength": 200
                          },
                          "locale": {
                            "type": [
                              "string",
                              "null"
                            ],
                            "maxLength": 35
                          },
                          "timeZone": {
                            "type": [
                              "string",
                              "null"
                            ],
                            "maxLength": 64
                          },
                          "devices": {
                            "type": "array",
                            "maxItems": 50,
                            "items": {
                              "type": "object",
                              "additionalProperties": false,
                              "required": [
                                "accountDeviceRef",
                                "state"
                              ],
                              "properties": {
                                "accountDeviceRef": {
                                  "type": "string",
                                  "format": "uuid",
                                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                                },
                                "state": {
                                  "type": "string",
                                  "enum": [
                                    "ACTIVE",
                                    "REVOKED",
                                    "PENDING"
                                  ]
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "VALIDATION_ERROR.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "https://schemas.cfmeet.com/notifications/common/v1.schema.json#/$defs/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid or replayed service token (INTERNAL_AUTHENTICATION_FAILED).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "https://schemas.cfmeet.com/notifications/common/v1.schema.json#/$defs/Error"
                }
              }
            }
          },
          "403": {
            "description": "INTERNAL_PERMISSION_DENIED (FORBIDDEN): the issuer does not hold the permission in the receiver's trust bundle.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "https://schemas.cfmeet.com/notifications/common/v1.schema.json#/$defs/Error"
                }
              }
            }
          },
          "429": {
            "description": "RATE_LIMITED (Retry-After).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "https://schemas.cfmeet.com/notifications/common/v1.schema.json#/$defs/Error"
                }
              }
            }
          },
          "503": {
            "description": "UNAVAILABLE (Retry-After).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "https://schemas.cfmeet.com/notifications/common/v1.schema.json#/$defs/Error"
                }
              }
            }
          }
        }
      }
    },
    "/internal/v1/conferences/{conferenceId}/notification-recipients/resolve": {
      "post": {
        "operationId": "resolveConferenceRecipients",
        "summary": "Resolve conference notification recipients (X2)",
        "description": "Port of RECIPIENTS_SQL: recipient refs (accounts and email principals with address), the presented title (protected-title rule applied by Meeting), start time, space time zone and the still-true state for the requested notice kind.",
        "tags": [
          "Notification owner"
        ],
        "security": [
          {
            "cfServiceAuth": []
          }
        ],
        "x-cfmeet-internal-permission": "meeting-notification-recipients.read",
        "parameters": [
          {
            "name": "conferenceId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind"
                ],
                "properties": {
                  "kind": {
                    "type": "string",
                    "enum": [
                      "SCHEDULED",
                      "RESCHEDULED",
                      "CANCELLED",
                      "REMINDER"
                    ]
                  },
                  "startsAt": {
                    "type": "string",
                    "format": "date-time"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Recipients.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "conferenceId",
                    "stillTrue",
                    "presentedTitle",
                    "startsAt",
                    "timeZone",
                    "recipients"
                  ],
                  "properties": {
                    "conferenceId": {
                      "type": "string",
                      "format": "uuid",
                      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                    },
                    "stillTrue": {
                      "type": "boolean"
                    },
                    "presentedTitle": {
                      "type": "string",
                      "maxLength": 200
                    },
                    "startsAt": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "timeZone": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "maxLength": 64
                    },
                    "recipients": {
                      "type": "array",
                      "maxItems": 500,
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "ref"
                        ],
                        "properties": {
                          "ref": {
                            "$ref": "https://schemas.cfmeet.com/notifications/common/v1.schema.json#/$defs/RecipientRef"
                          },
                          "email": {
                            "type": [
                              "string",
                              "null"
                            ],
                            "maxLength": 254
                          }
                        }
                      }
                    },
                    "joinPath": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "maxLength": 120,
                      "pattern": "^/[A-Za-z0-9-]{1,100}$",
                      "description": "1.1.0 (N6): the join path under the app URL (`/<meeting code>`), as Meeting builds join links today; never a full URL."
                    },
                    "endsAt": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "format": "date-time",
                      "description": "1.1.0 (N6): the scheduled end (reschedule notices show it)."
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "NOT_FOUND.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "https://schemas.cfmeet.com/notifications/common/v1.schema.json#/$defs/Error"
                }
              }
            }
          },
          "400": {
            "description": "VALIDATION_ERROR.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "https://schemas.cfmeet.com/notifications/common/v1.schema.json#/$defs/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid or replayed service token (INTERNAL_AUTHENTICATION_FAILED).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "https://schemas.cfmeet.com/notifications/common/v1.schema.json#/$defs/Error"
                }
              }
            }
          },
          "403": {
            "description": "INTERNAL_PERMISSION_DENIED (FORBIDDEN): the issuer does not hold the permission in the receiver's trust bundle.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "https://schemas.cfmeet.com/notifications/common/v1.schema.json#/$defs/Error"
                }
              }
            }
          },
          "429": {
            "description": "RATE_LIMITED (Retry-After).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "https://schemas.cfmeet.com/notifications/common/v1.schema.json#/$defs/Error"
                }
              }
            }
          },
          "503": {
            "description": "UNAVAILABLE (Retry-After).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "https://schemas.cfmeet.com/notifications/common/v1.schema.json#/$defs/Error"
                }
              }
            }
          }
        }
      }
    },
    "/internal/v1/accounts/notification-route-decisions/leases": {
      "post": {
        "operationId": "claimCriticalSendLeases",
        "summary": "Claim CRITICAL send leases (X6)",
        "description": "CRITICAL lane only (§9.8). In one row-locked Meeting transaction per decision: GRANTED when the route is still NEW, not completed and without a live lease (send_lease_until set from the Meeting DB clock, lease_count + 1); REVOKED when rerouted or superseded; EXPIRED when the code expired. The service sends a CRITICAL email only under a granted lease and aborts the provider call if the lease would lapse. A fencing token, not a read.",
        "tags": [
          "Notification owner"
        ],
        "security": [
          {
            "cfServiceAuth": []
          }
        ],
        "x-cfmeet-internal-permission": "account-route-lease.claim",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "decisionIds",
                  "leaseSeconds"
                ],
                "properties": {
                  "decisionIds": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 100,
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "format": "uuid",
                      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                    }
                  },
                  "leaseSeconds": {
                    "type": "integer",
                    "minimum": 5,
                    "maximum": 30
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Per-decision lease.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "results"
                  ],
                  "properties": {
                    "results": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "decisionId",
                          "outcome"
                        ],
                        "properties": {
                          "decisionId": {
                            "type": "string",
                            "format": "uuid",
                            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                          },
                          "outcome": {
                            "type": "string",
                            "enum": [
                              "GRANTED",
                              "REVOKED",
                              "EXPIRED",
                              "UNKNOWN"
                            ]
                          },
                          "leaseUntil": {
                            "type": [
                              "string",
                              "null"
                            ],
                            "format": "date-time"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "VALIDATION_ERROR.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "https://schemas.cfmeet.com/notifications/common/v1.schema.json#/$defs/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid or replayed service token (INTERNAL_AUTHENTICATION_FAILED).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "https://schemas.cfmeet.com/notifications/common/v1.schema.json#/$defs/Error"
                }
              }
            }
          },
          "403": {
            "description": "INTERNAL_PERMISSION_DENIED (FORBIDDEN): the issuer does not hold the permission in the receiver's trust bundle.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "https://schemas.cfmeet.com/notifications/common/v1.schema.json#/$defs/Error"
                }
              }
            }
          },
          "429": {
            "description": "RATE_LIMITED (Retry-After).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "https://schemas.cfmeet.com/notifications/common/v1.schema.json#/$defs/Error"
                }
              }
            }
          },
          "503": {
            "description": "UNAVAILABLE (Retry-After).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "https://schemas.cfmeet.com/notifications/common/v1.schema.json#/$defs/Error"
                }
              }
            }
          }
        }
      }
    },
    "/internal/v1/accounts/notification-route-decisions/completions": {
      "post": {
        "operationId": "completeCriticalSends",
        "summary": "Report completed CRITICAL sends (X7)",
        "description": "Decisions held under a live lease → ns_completed_at set (terminal; never reroutable). Called immediately after the provider accepted.",
        "tags": [
          "Notification owner"
        ],
        "security": [
          {
            "cfServiceAuth": []
          }
        ],
        "x-cfmeet-internal-permission": "account-route-lease.claim",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "decisionIds"
                ],
                "properties": {
                  "decisionIds": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 100,
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "format": "uuid",
                      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Per-decision result.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "results"
                  ],
                  "properties": {
                    "results": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "decisionId",
                          "outcome"
                        ],
                        "properties": {
                          "decisionId": {
                            "type": "string",
                            "format": "uuid",
                            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                          },
                          "outcome": {
                            "type": "string",
                            "enum": [
                              "COMPLETED",
                              "ALREADY_COMPLETED",
                              "NO_LIVE_LEASE",
                              "UNKNOWN"
                            ]
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "VALIDATION_ERROR.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "https://schemas.cfmeet.com/notifications/common/v1.schema.json#/$defs/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid or replayed service token (INTERNAL_AUTHENTICATION_FAILED).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "https://schemas.cfmeet.com/notifications/common/v1.schema.json#/$defs/Error"
                }
              }
            }
          },
          "403": {
            "description": "INTERNAL_PERMISSION_DENIED (FORBIDDEN): the issuer does not hold the permission in the receiver's trust bundle.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "https://schemas.cfmeet.com/notifications/common/v1.schema.json#/$defs/Error"
                }
              }
            }
          },
          "429": {
            "description": "RATE_LIMITED (Retry-After).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "https://schemas.cfmeet.com/notifications/common/v1.schema.json#/$defs/Error"
                }
              }
            }
          },
          "503": {
            "description": "UNAVAILABLE (Retry-After).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "https://schemas.cfmeet.com/notifications/common/v1.schema.json#/$defs/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "cfServiceAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-CF-Service-Authorization",
        "description": "Bearer EdDSA service token from packages/service-auth; audience cfmeet.meeting-service; issuer must be cfmeet.notifications holding the stated permission in the receiver's trust bundle."
      }
    }
  }
}
