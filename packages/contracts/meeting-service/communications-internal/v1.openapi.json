{
  "openapi": "3.1.0",
  "info": {
    "title": "CF Meet meeting-service private Communications integration",
    "version": "1.0.0",
    "description": "Private backend interfaces for Sections 4\u20137. Never routed by public ingress or advertised by public Swagger. The owner retains canonical data. Scope, permissions and identities come from signed service authentication; request bodies cannot impersonate principals."
  },
  "tags": [
    {
      "name": "Communications integration",
      "description": "Narrow owner-authenticated metadata and policy interfaces."
    }
  ],
  "paths": {
    "/internal/v1/accounts/communications/status": {
      "post": {
        "operationId": "readCommunicationsAccountStatus",
        "summary": "Read live Account eligibility and revocation epoch",
        "description": "Read live Account eligibility and revocation epoch. Private signed service traffic only; the delegated tenant, application and environment must match the verified Platform Access authority. Permission communications-account.read is granted only by the receiving service trust policy. Replayed JWT hops are refused by the Hub; events and commands additionally deduplicate their durable identities. Failures never grant communications.",
        "tags": [
          "Communications integration"
        ],
        "security": [
          {
            "cfServiceAuth": []
          }
        ],
        "x-cfmeet-internal-permission": "communications-account.read",
        "parameters": [
          {
            "name": "X-CF-Request-Id",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^req_[0-9a-f]{32}$"
            }
          },
          {
            "name": "X-CF-Correlation-Id",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^corr_[0-9a-f]{32}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Typed private result.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountStatusResult"
                }
              }
            }
          },
          "400": {
            "description": "Invalid typed request.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Invalid or replayed service authentication.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Permission or delegated scope denied.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Unavailable scoped resource.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Event identity or payload conflict.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Required authority or persistence unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AccountStatus"
              }
            }
          }
        }
      }
    },
    "/internal/v1/accounts/communications/backfill": {
      "post": {
        "operationId": "readCommunicationsAccountBackfill",
        "summary": "Read a bounded registered Account page",
        "description": "Read a bounded registered Account page. Private signed service traffic only; the delegated tenant, application and environment must match the verified Platform Access authority. Permission communications-account.read is granted only by the receiving service trust policy. Replayed JWT hops are refused by the Hub; events and commands additionally deduplicate their durable identities. Failures never grant communications.",
        "tags": [
          "Communications integration"
        ],
        "security": [
          {
            "cfServiceAuth": []
          }
        ],
        "x-cfmeet-internal-permission": "communications-account.read",
        "parameters": [
          {
            "name": "X-CF-Request-Id",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^req_[0-9a-f]{32}$"
            }
          },
          {
            "name": "X-CF-Correlation-Id",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^corr_[0-9a-f]{32}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Typed private result.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountPage"
                }
              }
            }
          },
          "400": {
            "description": "Invalid typed request.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Invalid or replayed service authentication.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Permission or delegated scope denied.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Unavailable scoped resource.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Event identity or payload conflict.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Required authority or persistence unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Backfill"
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "cfServiceAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-CF-Service-Authorization",
        "description": "Bearer EdDSA service JWT from cf-service-auth; audience, runtime, request IDs, scope, expiration and receiver-granted permission are verified."
      }
    },
    "schemas": {
      "AccountPage": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "accounts": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "accountReference": {
                  "type": "string"
                },
                "displayName": {
                  "type": "string"
                },
                "principalId": {
                  "type": "string",
                  "format": "uuid"
                }
              },
              "required": [
                "accountReference",
                "displayName",
                "principalId"
              ]
            }
          },
          "nextCursor": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "accounts",
          "nextCursor"
        ]
      },
      "AccountStatus": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "accountReference": {
            "type": "string",
            "pattern": "^cfmeet-user:[0-9a-f-]{36}$"
          }
        },
        "required": [
          "accountReference"
        ]
      },
      "AccountStatusResult": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "active": {
            "type": "boolean"
          },
          "version": {
            "type": "integer",
            "minimum": 0
          },
          "state": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "SUSPENDED",
              "DEACTIVATED"
            ]
          },
          "credentialsNotBefore": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          },
          "principalId": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "active",
          "version",
          "state"
        ]
      },
      "Backfill": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "cursor": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "limit",
          "cursor"
        ]
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "schemaVersion": {
            "type": "integer",
            "enum": [
              1
            ]
          },
          "error": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "AUTHENTICATION_REQUIRED",
                  "PERMISSION_DENIED",
                  "NOT_FOUND",
                  "VALIDATION_ERROR",
                  "VERSION_CONFLICT",
                  "IDEMPOTENCY_CONFLICT",
                  "REQUEST_PENDING",
                  "RATE_LIMITED",
                  "RECENT_AUTHENTICATION_REQUIRED",
                  "COMMUNICATIONS_UNAVAILABLE"
                ]
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "message"
            ]
          }
        },
        "required": [
          "schemaVersion",
          "error"
        ]
      }
    }
  }
}
