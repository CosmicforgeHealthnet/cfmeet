{
  "openapi": "3.1.0",
  "info": {
    "title": "CF Meet Telephony internal API",
    "version": "1.2.0",
    "description": "Internal HTTP surface of services/telephony (Part E §165–§172): GET /health and the provider callback ingress (public, provider-authenticated before parsing, 16 KiB limit) and the service-authenticated /internal/v1 API used by Calling only. Every /internal/v1 path — including unknown ones — requires a valid service token; customer credentials, cfmk_ keys and Authorization headers are refused. Telephony -> Calling delivery is the durable outbox (cfmeet.telephony.event to Calling's POST /internal/v1/telephony/events). Metrics are served on a separate listener, never here."
  },
  "components": {
    "securitySchemes": {
      "cfServiceAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-CF-Service-Authorization",
        "description": "Bearer <service token> (cfmeet.platform.internal-http). Permissions come only from Telephony's trust bundle."
      }
    },
    "parameters": {
      "CfRequestId": {
        "name": "X-CF-Request-Id",
        "in": "header",
        "required": true,
        "schema": {
          "$ref": "https://schemas.cfmeet.com/platform/common/v1.schema.json#/$defs/RequestId"
        }
      },
      "CfCorrelationId": {
        "name": "X-CF-Correlation-Id",
        "in": "header",
        "required": true,
        "schema": {
          "$ref": "https://schemas.cfmeet.com/platform/common/v1.schema.json#/$defs/CorrelationId"
        }
      }
    },
    "schemas": {
      "HealthStatus": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status",
          "service"
        ],
        "properties": {
          "status": {
            "enum": [
              "ok",
              "unavailable"
            ]
          },
          "service": {
            "const": "telephony"
          }
        }
      },
      "CallbackAck": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "accepted"
        ],
        "properties": {
          "accepted": {
            "type": "integer",
            "minimum": 0,
            "maximum": 64
          }
        }
      },
      "Readiness": {
        "description": "Counts and normalized states only (no provider names, no credentials).",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status",
          "database",
          "telephonyEnabled",
          "publicOutboundEnabled",
          "publicInboundEnabled",
          "callbackRelayEnabled",
          "sipEdge",
          "interconnects"
        ],
        "properties": {
          "status": {
            "enum": [
              "ready",
              "not_ready"
            ]
          },
          "database": {
            "enum": [
              "ok",
              "unavailable"
            ]
          },
          "telephonyEnabled": {
            "type": "boolean"
          },
          "publicOutboundEnabled": {
            "type": "boolean"
          },
          "publicInboundEnabled": {
            "type": "boolean"
          },
          "callbackRelayEnabled": {
            "type": "boolean"
          },
          "sipEdge": {
            "$ref": "https://schemas.cfmeet.com/telephony/common/v1.schema.json#/$defs/RouteHealth"
          },
          "interconnects": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "configured",
              "available"
            ],
            "properties": {
              "configured": {
                "type": "integer",
                "minimum": 0
              },
              "available": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    "responses": {
      "Error": {
        "description": "Telephony error envelope.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "https://schemas.cfmeet.com/telephony/commands/v1.schema.json#/$defs/Error"
            }
          }
        }
      }
    }
  },
  "security": [
    {
      "cfServiceAuth": []
    }
  ],
  "tags": [
    {
      "name": "Internal — Media Capture",
      "description": "Internal — Media Capture operations in the Telephony internal API. Review the operation description for behavior, required permissions and schemas."
    },
    {
      "name": "Internal — Routes & Readiness",
      "description": "Internal — Routes & Readiness operations in the Telephony internal API. Review the operation description for behavior, required permissions and schemas."
    },
    {
      "name": "Internal — Telephony Bridges",
      "description": "Internal — Telephony Bridges operations in the Telephony internal API. Review the operation description for behavior, required permissions and schemas."
    },
    {
      "name": "Internal — Telephony Call Legs",
      "description": "Internal — Telephony Call Legs operations in the Telephony internal API. Review the operation description for behavior, required permissions and schemas."
    },
    {
      "name": "Provider Telephony Callbacks",
      "description": "Provider Telephony Callbacks operations in the Telephony internal API. Review the operation description for behavior, required permissions and schemas."
    },
    {
      "name": "Service Health",
      "description": "Service Health operations in the Telephony internal API. Review the operation description for behavior, required permissions and schemas."
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "operationId": "health",
        "tags": [
          "Service Health"
        ],
        "summary": "Check service health",
        "security": [],
        "description": "Liveness and database reachability.",
        "responses": {
          "200": {
            "description": "Healthy.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthStatus"
                }
              }
            }
          },
          "503": {
            "description": "Database unreachable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthStatus"
                }
              }
            }
          }
        }
      }
    },
    "/provider-callbacks/{provider_id}": {
      "post": {
        "operationId": "providerCallback",
        "tags": [
          "Provider Telephony Callbacks"
        ],
        "summary": "provider Callback",
        "security": [],
        "description": "Provider event callback. Authenticated by the adapter (signature / token / peer) BEFORE parsing; bodies over 16 KiB are refused unread; a strict parser; dedupe by (provider, provider event id). The body is provider-specific (adapter-internal, not a CF Meet contract).",
        "parameters": [
          {
            "name": "provider_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-z0-9-]{1,32}$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Recorded (applied, duplicate, stale, late or quarantined).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CallbackAck"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "413": {
            "$ref": "#/components/responses/Error"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/provider-callbacks/{provider_id}/{token}": {
      "post": {
        "operationId": "providerCallbackWithToken",
        "tags": [
          "Provider Telephony Callbacks"
        ],
        "summary": "provider Callback With Token",
        "security": [],
        "description": "Provider callback for adapters that authenticate with a path token (compared in constant time).",
        "parameters": [
          {
            "name": "provider_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-z0-9-]{1,32}$"
            }
          },
          {
            "name": "token",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 16,
              "maxLength": 256
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Recorded.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CallbackAck"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "413": {
            "$ref": "#/components/responses/Error"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
