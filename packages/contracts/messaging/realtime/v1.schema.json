{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.cfmeet.com/messaging/realtime/v1.schema.json",
  "title": "CF Meet Messaging realtime protocol v1",
  "description": "Frames of the Messaging WebSocket gateway (subprotocol cfmeet.messaging.v1): JSON text frames with a `type`. Clients ignore unknown server frame types and unknown fields; the gateway answers unknown client frames with error UNSUPPORTED_FRAME without closing (forward compatibility). Durable events carry a per-conversation eventSequence (replay / ack cursor); clients order messages by their message sequence and drop duplicates by eventId. Typing and presence are ephemeral (never stored). Close codes: 1000 normal, 1001 idle timeout, 1008 policy (frame rate), 1009 frame too large, 1012 draining (reconnect after reconnectAfterMs), 1013 slow consumer (resume from the cursors in the preceding error), 4401 authorization ended (session expired / revoked, device revoked, principal inactive). A frame validates against ClientFrame or ServerFrame (typing frames exist in both directions). Section 13 (ADR 0049 amendment A1): a session-device session (deviceKind SESSION_DEVICE) may subscribe to MANAGED conversations only; a PRIVATE_E2EE subscribe is answered with error E2EE_DEVICE_REQUIRED (the connection stays open) and it never receives device events. Omit subscribe.afterEventSequence to resume from the device's stored ack cursor (the REST replay names the same cursor `after`). Audit MSG-018 (1.3.0): read.cursor.updated / delivery.cursor.updated durable events are coalesced per member and conversation (the first advance of a window is published at once, later advances inside the window only once, with the highest cursor, when it ends); cursors in them only grow. Client frame receipts.query / server frame receipts.snapshot return the current cursors after a reconnect. Audit MSG-009 (1.3.0): durable timeline.changed events (data.timelineVersion, data.reason) tell the members of a conversation that its Communications Hub call / meeting timeline changed; refetch the Hub timeline.",
  "$defs": {
    "ClientFrame": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "type",
            "conversationId"
          ],
          "properties": {
            "type": {
              "const": "subscribe"
            },
            "requestId": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 64
            },
            "conversationId": {
              "$ref": "https://schemas.cfmeet.com/platform/common/v1.schema.json#/$defs/Uuid"
            },
            "afterEventSequence": {
              "type": "integer",
              "minimum": 0,
              "description": "Resume after this event cursor. Omit it to resume from this device's stored ack cursor (or the head when none); the answer's subscribed.afterEventSequence is the authoritative baseline."
            }
          },
          "additionalProperties": true
        },
        {
          "type": "object",
          "required": [
            "type",
            "conversationId"
          ],
          "properties": {
            "type": {
              "const": "unsubscribe"
            },
            "requestId": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 64
            },
            "conversationId": {
              "$ref": "https://schemas.cfmeet.com/platform/common/v1.schema.json#/$defs/Uuid"
            }
          },
          "additionalProperties": true
        },
        {
          "type": "object",
          "required": [
            "type",
            "conversationId",
            "eventSequence"
          ],
          "properties": {
            "type": {
              "const": "ack"
            },
            "requestId": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 64
            },
            "conversationId": {
              "$ref": "https://schemas.cfmeet.com/platform/common/v1.schema.json#/$defs/Uuid"
            },
            "eventSequence": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": true
        },
        {
          "type": "object",
          "required": [
            "type",
            "conversationId",
            "state"
          ],
          "properties": {
            "type": {
              "const": "typing"
            },
            "requestId": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 64
            },
            "conversationId": {
              "$ref": "https://schemas.cfmeet.com/platform/common/v1.schema.json#/$defs/Uuid"
            },
            "state": {
              "enum": [
                "started",
                "stopped"
              ]
            }
          },
          "additionalProperties": true
        },
        {
          "type": "object",
          "required": [
            "type",
            "visibility"
          ],
          "properties": {
            "type": {
              "const": "presence.set"
            },
            "requestId": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 64
            },
            "visibility": {
              "enum": [
                "CONVERSATION_MEMBERS",
                "HIDDEN"
              ]
            },
            "shareLastSeen": {
              "type": "boolean"
            }
          },
          "additionalProperties": true
        },
        {
          "type": "object",
          "required": [
            "type",
            "conversationId"
          ],
          "properties": {
            "type": {
              "const": "presence.query"
            },
            "requestId": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 64
            },
            "conversationId": {
              "$ref": "https://schemas.cfmeet.com/platform/common/v1.schema.json#/$defs/Uuid"
            }
          },
          "additionalProperties": true
        },
        {
          "type": "object",
          "required": [
            "type",
            "conversationId"
          ],
          "description": "MSG-018: asks for the CURRENT read / delivery cursors of the other ACTIVE members of a subscribed conversation (answered with receipts.snapshot; error NOT_SUBSCRIBED otherwise; at most once per second per conversation, else RATE_LIMITED). Receipt events are coalesced per member (one per window, the highest cursor), so a client that reconnects or resubscribes reads the current state here instead of relying on the receipts it missed.",
          "properties": {
            "type": {
              "const": "receipts.query"
            },
            "requestId": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 64
            },
            "conversationId": {
              "$ref": "https://schemas.cfmeet.com/platform/common/v1.schema.json#/$defs/Uuid"
            }
          },
          "additionalProperties": true
        },
        {
          "type": "object",
          "required": [
            "type",
            "ticket"
          ],
          "properties": {
            "type": {
              "const": "auth.refresh"
            },
            "requestId": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 64
            },
            "ticket": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "additionalProperties": true
        },
        {
          "type": "object",
          "required": [
            "type"
          ],
          "description": "Inbox signals (optional capability `inbox`, advertised in welcome.capabilities): after inbox.subscribed the connection also receives identifier-only inbox.event frames for every conversation of its principal that it is NOT subscribed to (new conversations, activity, its own removal) and read-cursor.synced for its own read cursors there. Idempotent.",
          "properties": {
            "type": {
              "const": "inbox.subscribe"
            },
            "requestId": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 64
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "const": "ping"
            },
            "requestId": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 64
            }
          },
          "additionalProperties": true
        }
      ]
    },
    "ServerFrame": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "type",
            "protocolVersion",
            "connectionId",
            "sessionExpiresAt"
          ],
          "properties": {
            "type": {
              "const": "welcome"
            },
            "requestId": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 64
            },
            "protocolVersion": {
              "const": 1
            },
            "connectionId": {
              "type": "string"
            },
            "sessionExpiresAt": {
              "type": "string",
              "format": "date-time"
            },
            "heartbeatIntervalMs": {
              "type": "integer",
              "minimum": 1
            },
            "limits": {
              "type": "object"
            },
            "capabilities": {
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 64
              },
              "description": "Optional frames this gateway understands beyond protocol version 1 (currently `inbox`)."
            }
          },
          "additionalProperties": true
        },
        {
          "type": "object",
          "required": [
            "type",
            "conversationId",
            "afterEventSequence",
            "headEventSequence"
          ],
          "properties": {
            "type": {
              "const": "subscribed"
            },
            "requestId": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 64
            },
            "conversationId": {
              "$ref": "https://schemas.cfmeet.com/platform/common/v1.schema.json#/$defs/Uuid"
            },
            "afterEventSequence": {
              "type": "integer",
              "minimum": 0
            },
            "headEventSequence": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": true
        },
        {
          "type": "object",
          "required": [
            "type",
            "conversationId"
          ],
          "properties": {
            "type": {
              "const": "unsubscribed"
            },
            "requestId": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 64
            },
            "conversationId": {
              "$ref": "https://schemas.cfmeet.com/platform/common/v1.schema.json#/$defs/Uuid"
            }
          },
          "additionalProperties": true
        },
        {
          "type": "object",
          "required": [
            "type",
            "event"
          ],
          "properties": {
            "type": {
              "const": "event"
            },
            "requestId": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 64
            },
            "event": {
              "$ref": "https://schemas.cfmeet.com/messaging/common/v1.schema.json#/$defs/ConversationEvent"
            }
          },
          "additionalProperties": true
        },
        {
          "type": "object",
          "required": [
            "type",
            "conversationId",
            "afterEventSequence",
            "headEventSequence",
            "path"
          ],
          "properties": {
            "type": {
              "const": "sync.required"
            },
            "requestId": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 64
            },
            "conversationId": {
              "$ref": "https://schemas.cfmeet.com/platform/common/v1.schema.json#/$defs/Uuid"
            },
            "afterEventSequence": {
              "type": "integer",
              "minimum": 0
            },
            "headEventSequence": {
              "type": "integer",
              "minimum": 0
            },
            "path": {
              "type": "string"
            }
          },
          "additionalProperties": true
        },
        {
          "type": "object",
          "required": [
            "type",
            "conversationId",
            "reason"
          ],
          "properties": {
            "type": {
              "const": "subscription.revoked"
            },
            "requestId": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 64
            },
            "conversationId": {
              "$ref": "https://schemas.cfmeet.com/platform/common/v1.schema.json#/$defs/Uuid"
            },
            "reason": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_]{1,47}$"
            }
          },
          "additionalProperties": true
        },
        {
          "type": "object",
          "required": [
            "type",
            "conversationId",
            "eventSequence"
          ],
          "properties": {
            "type": {
              "const": "ack.recorded"
            },
            "requestId": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 64
            },
            "conversationId": {
              "$ref": "https://schemas.cfmeet.com/platform/common/v1.schema.json#/$defs/Uuid"
            },
            "eventSequence": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": true
        },
        {
          "type": "object",
          "required": [
            "type",
            "conversationId",
            "principalId",
            "state",
            "ttlMs"
          ],
          "properties": {
            "type": {
              "const": "typing"
            },
            "requestId": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 64
            },
            "conversationId": {
              "$ref": "https://schemas.cfmeet.com/platform/common/v1.schema.json#/$defs/Uuid"
            },
            "principalId": {
              "$ref": "https://schemas.cfmeet.com/platform/common/v1.schema.json#/$defs/Uuid"
            },
            "state": {
              "enum": [
                "started",
                "stopped"
              ]
            },
            "ttlMs": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": true
        },
        {
          "type": "object",
          "required": [
            "type",
            "conversationId",
            "principalId",
            "state"
          ],
          "properties": {
            "type": {
              "const": "presence"
            },
            "requestId": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 64
            },
            "conversationId": {
              "$ref": "https://schemas.cfmeet.com/platform/common/v1.schema.json#/$defs/Uuid"
            },
            "principalId": {
              "$ref": "https://schemas.cfmeet.com/platform/common/v1.schema.json#/$defs/Uuid"
            },
            "state": {
              "enum": [
                "AVAILABLE",
                "OFFLINE"
              ]
            },
            "lastSeenAt": {
              "oneOf": [
                {
                  "type": "string",
                  "format": "date-time"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "additionalProperties": true
        },
        {
          "type": "object",
          "required": [
            "type",
            "conversationId",
            "members"
          ],
          "properties": {
            "type": {
              "const": "presence.snapshot"
            },
            "requestId": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 64
            },
            "conversationId": {
              "$ref": "https://schemas.cfmeet.com/platform/common/v1.schema.json#/$defs/Uuid"
            },
            "members": {
              "type": "array",
              "maxItems": 256,
              "items": {
                "type": "object",
                "required": [
                  "principalId",
                  "state"
                ],
                "properties": {
                  "principalId": {
                    "$ref": "https://schemas.cfmeet.com/platform/common/v1.schema.json#/$defs/Uuid"
                  },
                  "state": {
                    "enum": [
                      "AVAILABLE",
                      "OFFLINE",
                      "POLICY_RESTRICTED"
                    ]
                  },
                  "lastSeenAt": {
                    "oneOf": [
                      {
                        "type": "string",
                        "format": "date-time"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": true
        },
        {
          "type": "object",
          "required": [
            "type",
            "conversationId",
            "members",
            "truncated"
          ],
          "description": "MSG-018: the answer to receipts.query — the committed read / delivery cursors of the other ACTIVE members, filtered exactly like the receipt events (readSequence only when the environment's privacy.readReceipts, the conversation's readReceipts and the member's shareReadReceipts allow it; deliveredSequence only with privacy.deliveryReceipts). Members with nothing to share are omitted. Ordered by principal id; at most 1000 members (truncated: true beyond).",
          "properties": {
            "type": {
              "const": "receipts.snapshot"
            },
            "requestId": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 64
            },
            "conversationId": {
              "$ref": "https://schemas.cfmeet.com/platform/common/v1.schema.json#/$defs/Uuid"
            },
            "members": {
              "type": "array",
              "maxItems": 1000,
              "items": {
                "type": "object",
                "required": [
                  "principalId"
                ],
                "properties": {
                  "principalId": {
                    "$ref": "https://schemas.cfmeet.com/platform/common/v1.schema.json#/$defs/Uuid"
                  },
                  "readSequence": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "deliveredSequence": {
                    "type": "integer",
                    "minimum": 1
                  }
                },
                "additionalProperties": false
              }
            },
            "truncated": {
              "type": "boolean"
            }
          },
          "additionalProperties": true
        },
        {
          "type": "object",
          "required": [
            "type",
            "settings"
          ],
          "properties": {
            "type": {
              "const": "presence.settings"
            },
            "requestId": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 64
            },
            "settings": {
              "$ref": "https://schemas.cfmeet.com/messaging/common/v1.schema.json#/$defs/PresenceSettings"
            }
          },
          "additionalProperties": true
        },
        {
          "type": "object",
          "required": [
            "type",
            "event"
          ],
          "properties": {
            "type": {
              "const": "device.event"
            },
            "requestId": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 64
            },
            "event": {
              "type": "object",
              "required": [
                "type",
                "referenceId"
              ],
              "properties": {
                "type": {
                  "type": "string"
                },
                "referenceId": {
                  "$ref": "https://schemas.cfmeet.com/platform/common/v1.schema.json#/$defs/Uuid"
                },
                "conversationId": {
                  "oneOf": [
                    {
                      "$ref": "https://schemas.cfmeet.com/platform/common/v1.schema.json#/$defs/Uuid"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            }
          },
          "additionalProperties": true
        },
        {
          "type": "object",
          "required": [
            "type",
            "sessionExpiresAt"
          ],
          "properties": {
            "type": {
              "const": "auth.refreshed"
            },
            "requestId": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 64
            },
            "sessionExpiresAt": {
              "type": "string",
              "format": "date-time"
            }
          },
          "additionalProperties": true
        },
        {
          "type": "object",
          "required": [
            "type",
            "reconnectAfterMs"
          ],
          "properties": {
            "type": {
              "const": "server.draining"
            },
            "requestId": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 64
            },
            "reconnectAfterMs": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": true
        },
        {
          "type": "object",
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "const": "pong"
            },
            "requestId": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 64
            }
          },
          "additionalProperties": true
        },
        {
          "type": "object",
          "required": [
            "type",
            "code",
            "message"
          ],
          "properties": {
            "type": {
              "const": "error"
            },
            "requestId": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 64
            },
            "code": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_]{1,47}$"
            },
            "message": {
              "type": "string"
            },
            "resume": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "conversationId",
                  "afterEventSequence"
                ],
                "properties": {
                  "conversationId": {
                    "$ref": "https://schemas.cfmeet.com/platform/common/v1.schema.json#/$defs/Uuid"
                  },
                  "afterEventSequence": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            }
          },
          "additionalProperties": true
        },
        {
          "type": "object",
          "required": [
            "type",
            "conversationId",
            "readSequence"
          ],
          "description": "The acting principal's own read position moved on another of its sessions (§55). Sent only to that principal's sessions subscribed to the conversation, whatever the read-receipt policy shares with other members.",
          "properties": {
            "type": {
              "const": "read-cursor.synced"
            },
            "conversationId": {
              "$ref": "https://schemas.cfmeet.com/platform/common/v1.schema.json#/$defs/Uuid"
            },
            "readSequence": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": true
        },
        {
          "type": "object",
          "required": [
            "type"
          ],
          "description": "inbox.subscribe accepted.",
          "properties": {
            "type": {
              "const": "inbox.subscribed"
            },
            "requestId": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 64
            }
          },
          "additionalProperties": true
        },
        {
          "type": "object",
          "required": [
            "type",
            "conversationId",
            "eventSequence",
            "eventType"
          ],
          "description": "A committed event of a conversation of this principal that the connection is not subscribed to. Identifiers only (never content): refresh that conversation's inbox summary by REST (GET v1/conversations/{id}), or subscribe to it with afterEventSequence. eventType is the durable event type without the `messaging.` prefix (e.g. message.created, message.deleted, member.added, member.removed, conversation.updated). Best effort: after reconnect or inbox.resync, re-read the conversation list once.",
          "properties": {
            "type": {
              "const": "inbox.event"
            },
            "conversationId": {
              "$ref": "https://schemas.cfmeet.com/platform/common/v1.schema.json#/$defs/Uuid"
            },
            "eventSequence": {
              "type": "integer",
              "minimum": 0
            },
            "eventType": {
              "type": "string",
              "maxLength": 128
            }
          },
          "additionalProperties": true
        },
        {
          "type": "object",
          "required": [
            "type"
          ],
          "description": "Inbox signals may have been lost (broker interruption): re-read the conversation list once. Subscriptions recover by themselves.",
          "properties": {
            "type": {
              "const": "inbox.resync"
            }
          },
          "additionalProperties": true
        }
      ]
    }
  },
  "anyOf": [
    {
      "$ref": "#/$defs/ClientFrame"
    },
    {
      "$ref": "#/$defs/ServerFrame"
    }
  ]
}
