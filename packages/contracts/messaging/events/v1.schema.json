{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.cfmeet.com/messaging/events/v1.schema.json",
  "title": "CF Meet Messaging events v1",
  "description": "Messaging domain events in the platform envelope (transactional outbox committed with the state change, at least once, per-aggregate order): messaging.device.registered, messaging.device.key-packages-published, messaging.device.revoked, messaging.conversation.created, messaging.conversation.lifecycle-changed, messaging.conversation.updated, messaging.policy.updated. Ids, states and versions only — never key material, ciphertext, content or a credential.",
  "$ref": "#/$defs/MessagingEvent",
  "$defs": {
    "DeviceRegistered": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "device_id",
        "principal_id",
        "key_fingerprint",
        "transparency_leaf_index"
      ],
      "properties": {
        "device_id": {
          "$ref": "https://schemas.cfmeet.com/platform/common/v1.schema.json#/$defs/Uuid"
        },
        "principal_id": {
          "$ref": "https://schemas.cfmeet.com/platform/common/v1.schema.json#/$defs/Uuid"
        },
        "key_fingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "transparency_leaf_index": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "KeyPackagesPublished": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "device_id",
        "count",
        "available"
      ],
      "properties": {
        "device_id": {
          "$ref": "https://schemas.cfmeet.com/platform/common/v1.schema.json#/$defs/Uuid"
        },
        "count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "available": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "DeviceRevoked": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "device_id",
        "principal_id",
        "reason",
        "transparency_leaf_index"
      ],
      "properties": {
        "device_id": {
          "$ref": "https://schemas.cfmeet.com/platform/common/v1.schema.json#/$defs/Uuid"
        },
        "principal_id": {
          "$ref": "https://schemas.cfmeet.com/platform/common/v1.schema.json#/$defs/Uuid"
        },
        "reason": {
          "$ref": "https://schemas.cfmeet.com/messaging/common/v1.schema.json#/$defs/RevocationReason"
        },
        "transparency_leaf_index": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "ConversationCreated": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "conversation_id",
        "conversation_kind",
        "security_profile",
        "lifecycle_state",
        "version",
        "policy_digest",
        "created_by_principal_id"
      ],
      "properties": {
        "conversation_id": {
          "$ref": "https://schemas.cfmeet.com/platform/common/v1.schema.json#/$defs/Uuid"
        },
        "conversation_kind": {
          "$ref": "https://schemas.cfmeet.com/messaging/common/v1.schema.json#/$defs/ContextClass"
        },
        "security_profile": {
          "$ref": "https://schemas.cfmeet.com/messaging/common/v1.schema.json#/$defs/SecurityProfile"
        },
        "lifecycle_state": {
          "const": "ACTIVE"
        },
        "version": {
          "const": 1
        },
        "policy_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "created_by_principal_id": {
          "$ref": "https://schemas.cfmeet.com/platform/common/v1.schema.json#/$defs/Uuid"
        }
      }
    },
    "ConversationLifecycleChanged": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "conversation_id",
        "previous_state",
        "lifecycle_state",
        "reason",
        "version"
      ],
      "properties": {
        "conversation_id": {
          "$ref": "https://schemas.cfmeet.com/platform/common/v1.schema.json#/$defs/Uuid"
        },
        "previous_state": {
          "$ref": "https://schemas.cfmeet.com/messaging/common/v1.schema.json#/$defs/LifecycleState"
        },
        "lifecycle_state": {
          "$ref": "https://schemas.cfmeet.com/messaging/common/v1.schema.json#/$defs/LifecycleState"
        },
        "reason": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_]{1,47}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "version": {
          "type": "integer",
          "minimum": 2
        }
      }
    },
    "ConversationUpdated": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "conversation_id",
        "previous_state",
        "lifecycle_state",
        "reason",
        "version"
      ],
      "properties": {
        "conversation_id": {
          "$ref": "https://schemas.cfmeet.com/platform/common/v1.schema.json#/$defs/Uuid"
        },
        "previous_state": {
          "$ref": "https://schemas.cfmeet.com/messaging/common/v1.schema.json#/$defs/LifecycleState"
        },
        "lifecycle_state": {
          "$ref": "https://schemas.cfmeet.com/messaging/common/v1.schema.json#/$defs/LifecycleState"
        },
        "reason": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_]{1,47}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "version": {
          "type": "integer",
          "minimum": 2
        }
      }
    },
    "PolicyUpdated": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "policy_digest"
      ],
      "properties": {
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "policy_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "MessagingEvent": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "event_type",
            "payload"
          ],
          "properties": {
            "event_type": {
              "const": "messaging.device.registered"
            },
            "payload": {
              "$ref": "#/$defs/DeviceRegistered"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "event_type",
            "payload"
          ],
          "properties": {
            "event_type": {
              "const": "messaging.device.key-packages-published"
            },
            "payload": {
              "$ref": "#/$defs/KeyPackagesPublished"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "event_type",
            "payload"
          ],
          "properties": {
            "event_type": {
              "const": "messaging.device.revoked"
            },
            "payload": {
              "$ref": "#/$defs/DeviceRevoked"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "event_type",
            "payload"
          ],
          "properties": {
            "event_type": {
              "const": "messaging.conversation.created"
            },
            "payload": {
              "$ref": "#/$defs/ConversationCreated"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "event_type",
            "payload"
          ],
          "properties": {
            "event_type": {
              "const": "messaging.conversation.lifecycle-changed"
            },
            "payload": {
              "$ref": "#/$defs/ConversationLifecycleChanged"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "event_type",
            "payload"
          ],
          "properties": {
            "event_type": {
              "const": "messaging.conversation.updated"
            },
            "payload": {
              "$ref": "#/$defs/ConversationUpdated"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "event_type",
            "payload"
          ],
          "properties": {
            "event_type": {
              "const": "messaging.policy.updated"
            },
            "payload": {
              "$ref": "#/$defs/PolicyUpdated"
            }
          }
        }
      ]
    }
  }
}
