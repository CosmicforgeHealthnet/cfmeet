{
  "openapi": "3.1.0",
  "info": {
    "title": "CF Meet Messaging API",
    "version": "1.0.0",
    "description": "HTTP surface of services/messaging: GET /health, /ready, /openapi.json (public, no data); the customer API under /v1/messaging (CF Meet API credential verified by Platform Access — afresh for every mutation; a verified acting principal; 503 when Platform Access is unreachable — fail closed; client tokens are refused with CLIENT_TOKENS_NOT_ENABLED). /internal/v1/** is service-authenticated and exposes no operation yet. Request bodies are limited to 512 KiB."
  },
  "paths": {
    "/health": {
      "get": {
        "operationId": "health",
        "security": [],
        "description": "Liveness only.",
        "responses": {
          "200": {
            "description": "OK.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "https://schemas.cfmeet.com/messaging/common/v1.schema.json#/$defs/Health"
                }
              }
            }
          }
        }
      }
    },
    "/ready": {
      "get": {
        "operationId": "ready",
        "security": [],
        "description": "Readiness: database reachable and every migration applied (503 otherwise). No secret or connection detail.",
        "responses": {
          "200": {
            "description": "OK.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "https://schemas.cfmeet.com/messaging/common/v1.schema.json#/$defs/Readiness"
                }
              }
            }
          },
          "503": {
            "description": "Not ready.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "https://schemas.cfmeet.com/messaging/common/v1.schema.json#/$defs/Readiness"
                }
              }
            }
          }
        }
      }
    },
    "/openapi.json": {
      "get": {
        "operationId": "openapi",
        "security": [],
        "description": "This document.",
        "responses": {
          "200": {
            "description": "The OpenAPI document."
          }
        }
      }
    },
    "/v1/messaging/devices/registration-challenges": {
      "post": {
        "operationId": "createDeviceRegistrationChallenge",
        "security": [
          {
            "customerCredential": []
          }
        ],
        "description": "Scope messages.send. A single-use challenge (server nonce, server-assigned device id) for the acting principal, bound to the credential and environment; rate-limited per principal. 503 FEATURE_DISABLED where E2EE device operations are not enabled.",
        "parameters": [
          {
            "name": "CF-Acting-Principal",
            "in": "header",
            "required": true,
            "description": "The Platform Access principal the application backend acts for; honoured only inside the credential's principal restriction and when Platform Access resolves it ACTIVE and messaging-capable in the credential's own environment.",
            "schema": {
              "$ref": "https://schemas.cfmeet.com/platform/common/v1.schema.json#/$defs/Uuid"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Created.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "https://schemas.cfmeet.com/messaging/common/v1.schema.json#/$defs/RegistrationChallenge"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "$ref": "#/components/responses/Error"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/v1/messaging/devices": {
      "post": {
        "operationId": "registerDevice",
        "security": [
          {
            "customerCredential": []
          }
        ],
        "description": "Scope messages.send. Registers the device by its registration KeyPackage: RFC 9420 validation, the server-assigned credential identity and the signed challenge binding prove possession of the device key and freshness. Stores PUBLIC material only, appends a transparency leaf. Replaying the same answer returns the device (200).",
        "parameters": [
          {
            "name": "CF-Acting-Principal",
            "in": "header",
            "required": true,
            "description": "The Platform Access principal the application backend acts for; honoured only inside the credential's principal restriction and when Platform Access resolves it ACTIVE and messaging-capable in the credential's own environment.",
            "schema": {
              "$ref": "https://schemas.cfmeet.com/platform/common/v1.schema.json#/$defs/Uuid"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Created.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "https://schemas.cfmeet.com/messaging/common/v1.schema.json#/$defs/Device"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          },
          "413": {
            "$ref": "#/components/responses/Error"
          },
          "422": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "$ref": "#/components/responses/Error"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "https://schemas.cfmeet.com/messaging/common/v1.schema.json#/$defs/RegisterDeviceRequest"
              }
            }
          }
        }
      }
    },
    "/v1/messaging/devices/{deviceId}/key-packages": {
      "post": {
        "operationId": "publishKeyPackages",
        "security": [
          {
            "customerCredential": []
          }
        ],
        "description": "Scope messages.send. Publishes 1–20 KeyPackages of the acting principal's ACTIVE device: validated, bound to the device and its key, never last-resort or registration packages, unique by KeyPackageRef (re-submission is ALREADY_PUBLISHED), bounded per device.",
        "parameters": [
          {
            "name": "CF-Acting-Principal",
            "in": "header",
            "required": true,
            "description": "The Platform Access principal the application backend acts for; honoured only inside the credential's principal restriction and when Platform Access resolves it ACTIVE and messaging-capable in the credential's own environment.",
            "schema": {
              "$ref": "https://schemas.cfmeet.com/platform/common/v1.schema.json#/$defs/Uuid"
            }
          },
          {
            "name": "deviceId",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "https://schemas.cfmeet.com/platform/common/v1.schema.json#/$defs/Uuid"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Created.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "https://schemas.cfmeet.com/messaging/common/v1.schema.json#/$defs/PublishKeyPackagesResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          },
          "413": {
            "$ref": "#/components/responses/Error"
          },
          "422": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "$ref": "#/components/responses/Error"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "https://schemas.cfmeet.com/messaging/common/v1.schema.json#/$defs/PublishKeyPackagesRequest"
              }
            }
          }
        }
      }
    },
    "/v1/messaging/devices/{deviceId}/revoke": {
      "post": {
        "operationId": "revokeDevice",
        "security": [
          {
            "customerCredential": []
          }
        ],
        "description": "Scope messages.send. Revokes the acting principal's device (terminal), closes its KeyPackages and appends a transparency leaf. Idempotent.",
        "parameters": [
          {
            "name": "CF-Acting-Principal",
            "in": "header",
            "required": true,
            "description": "The Platform Access principal the application backend acts for; honoured only inside the credential's principal restriction and when Platform Access resolves it ACTIVE and messaging-capable in the credential's own environment.",
            "schema": {
              "$ref": "https://schemas.cfmeet.com/platform/common/v1.schema.json#/$defs/Uuid"
            }
          },
          {
            "name": "deviceId",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "https://schemas.cfmeet.com/platform/common/v1.schema.json#/$defs/Uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "https://schemas.cfmeet.com/messaging/common/v1.schema.json#/$defs/Device"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "$ref": "#/components/responses/Error"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "https://schemas.cfmeet.com/messaging/common/v1.schema.json#/$defs/RevokeDeviceRequest"
              }
            }
          }
        }
      }
    },
    "/v1/messaging/principals/{principalId}/devices": {
      "get": {
        "operationId": "listPrincipalDevices",
        "security": [
          {
            "customerCredential": []
          }
        ],
        "description": "Scope messages.read. The ACTIVE devices (public keys) of an ACTIVE messaging principal of the credential's own environment; any other principal is NOT_FOUND. Rate-limited per credential.",
        "parameters": [
          {
            "name": "CF-Acting-Principal",
            "in": "header",
            "required": true,
            "description": "The Platform Access principal the application backend acts for; honoured only inside the credential's principal restriction and when Platform Access resolves it ACTIVE and messaging-capable in the credential's own environment.",
            "schema": {
              "$ref": "https://schemas.cfmeet.com/platform/common/v1.schema.json#/$defs/Uuid"
            }
          },
          {
            "name": "principalId",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "https://schemas.cfmeet.com/platform/common/v1.schema.json#/$defs/Uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "https://schemas.cfmeet.com/messaging/common/v1.schema.json#/$defs/DeviceDirectory"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "$ref": "#/components/responses/Error"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/v1/messaging/key-transparency/proofs": {
      "get": {
        "operationId": "getKeyTransparencyProofs",
        "security": [
          {
            "customerCredential": []
          }
        ],
        "description": "Scope messages.read. Inclusion proofs (RFC 9162) of a device's log entries against the current tree head and, with fromTreeSize, a consistency proof. The log is UNWITNESSED: verifiable, not anti-equivocation.",
        "parameters": [
          {
            "name": "CF-Acting-Principal",
            "in": "header",
            "required": true,
            "description": "The Platform Access principal the application backend acts for; honoured only inside the credential's principal restriction and when Platform Access resolves it ACTIVE and messaging-capable in the credential's own environment.",
            "schema": {
              "$ref": "https://schemas.cfmeet.com/platform/common/v1.schema.json#/$defs/Uuid"
            }
          },
          {
            "name": "deviceId",
            "in": "query",
            "required": true,
            "schema": {
              "$ref": "https://schemas.cfmeet.com/platform/common/v1.schema.json#/$defs/Uuid"
            }
          },
          {
            "name": "fromTreeSize",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "https://schemas.cfmeet.com/messaging/common/v1.schema.json#/$defs/TransparencyProof"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "$ref": "#/components/responses/Error"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "customerCredential": {
        "type": "http",
        "scheme": "bearer",
        "description": "A CF Meet API credential, verified by Platform Access (never by Messaging)."
      },
      "cfServiceAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-CF-Service-Authorization",
        "description": "Bearer <service token> (cfmeet.platform.internal-http)."
      }
    },
    "responses": {
      "Error": {
        "description": "Error envelope.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "https://schemas.cfmeet.com/messaging/common/v1.schema.json#/$defs/Error"
            }
          }
        }
      }
    }
  }
}
