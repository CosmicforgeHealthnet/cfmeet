    "/v1/messaging/policy": {
      "get": {
        "operationId": "getMessagingPolicy",
        "security": [
          {
            "customerCredential": []
          }
        ],
        "description": "Scope conversations.manage. The environment's overrides, their version and the effective policy.",
        "parameters": [],
        "responses": {
          "200": {
            "description": "OK.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "https://schemas.cfmeet.com/messaging/common/v1.schema.json#/$defs/PolicyView"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "$ref": "#/components/responses/Error"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          }
        }
      },
      "put": {
        "operationId": "updateMessagingPolicy",
        "security": [
          {
            "customerCredential": []
          }
        ],
        "description": "Scope conversations.manage. Replaces the overrides (validated; optimistic concurrency on expectedVersion: POLICY_VERSION_CONFLICT). Audited; existing conversations keep their snapshot.",
        "parameters": [],
        "responses": {
          "200": {
            "description": "OK.",
            "content": {
