{
  "openapi": "3.1.0",
  "info": {
    "title": "CF Meet Numbering API",
    "version": "1.1.0",
    "description": "HTTP surface of services/numbering (Part IV Workstream C foundation, ADR 0033): GET /health and /ready (public, no data); customer reads of the caller's own DCN assignments and reservations under /v1 (credential verified by Platform Access on every request; normalized 401, 429 when Platform Access throttles, 503 when it is unreachable — fail closed); and the service-authenticated /internal/v1 API (cfmeet.platform.internal-http; permission from Numbering's own trust bundle). Every non-probe path, including unknown ones, runs behind its authentication. Request bodies are limited to 64 KiB. Full public number search / provisioning / assignment-mutation APIs are later workstreams."
  },
  "components": {
    "securitySchemes": {
      "cfServiceAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-CF-Service-Authorization",
        "description": "Bearer <service token> (cfmeet.platform.internal-http)."
      },
      "customerCredential": {
        "type": "http",
        "scheme": "bearer",
        "description": "A CF Meet API credential, verified by Platform Access (never by Numbering)."
      }
    },
    "parameters": {
      "CfRequestId": {
        "name": "X-CF-Request-Id",
        "in": "header",
        "required": true,
        "schema": {
          "$ref": "https://schemas.cfmeet.com/platform/common/v1.schema.json#/$defs/RequestId"
        }
      },
      "CfCorrelationId": {
        "name": "X-CF-Correlation-Id",
        "in": "header",
        "required": true,
        "schema": {
          "$ref": "https://schemas.cfmeet.com/platform/common/v1.schema.json#/$defs/CorrelationId"
        }
      },
      "CfOperator": {
        "name": "X-CF-Operator",
        "in": "header",
        "required": true,
        "description": "The audited human operator (opaque id).",
        "schema": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._@-]{0,99}$"
        }
      }
    },
    "schemas": {
      "HealthStatus": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status",
          "service"
        ],
        "properties": {
          "status": {
            "const": "ok"
          },
          "service": {
            "const": "numbering"
          }
        }
      },
      "Readiness": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status",
          "service",
          "database",
          "migrations",
          "outboxPending",
          "outboxDeadLetter",
          "jobsUnknownOutcome"
        ],
        "properties": {
          "status": {
            "enum": [
              "ready",
              "not_ready"
            ]
          },
          "service": {
            "const": "numbering"
          },
          "database": {
            "enum": [
              "ok",
              "unavailable"
            ]
          },
          "migrations": {
            "enum": [
              "current",
              "pending",
              "unknown"
            ]
          },
          "outboxPending": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "outboxDeadLetter": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "jobsUnknownOutcome": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          }
        }
      }
    },
    "responses": {
      "Error": {
        "description": "Numbering error envelope.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "https://schemas.cfmeet.com/numbering/common/v1.schema.json#/$defs/Error"
            }
          }
        }
      }
    }
  },
  "paths": {
    "/health": {
      "get": {
        "operationId": "health",
        "security": [],
        "description": "Liveness.",
        "responses": {
          "200": {
            "description": "Alive.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthStatus"
                }
              }
            }
          }
        }
      }
    },
    "/ready": {
      "get": {
        "operationId": "ready",
        "security": [],
        "description": "Readiness: database reachable and migrations current; outbox backlog, dead letters and jobs awaiting reconciliation (counts only).",
        "responses": {
          "200": {
            "description": "Ready.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Readiness"
                }
              }
            }
          },
          "503": {
            "description": "Not ready.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Readiness"
                }
              }
            }
          }
        }
      }
    },
