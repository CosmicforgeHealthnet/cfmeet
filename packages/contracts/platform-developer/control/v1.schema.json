                  "type": "string"
                },
                "version": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "domainEntitlements": {
          "$ref": "#/$defs/EntitlementValues"
        }
