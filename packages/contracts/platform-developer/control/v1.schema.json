          "maxLength": 64
        },
        "correlationId": {
          "type": "string",
          "maxLength": 64
        },
        "summary": {
          "type": "object",
          "description": "Safe change summary: opaque ids, codes and display metadata only — never secrets, credentials, contacts or E2EE material.",
          "not": {
            "anyOf": [
              {
                "required": [
                  "secret"
                ]
              },
              {
                "required": [
                  "signingSecret"
                ]
              },
              {
                "required": [
                  "credential"
                ]
              },
              {
                "required": [
                  "password"
                ]
              },
              {
                "required": [
                  "token"
                ]
              },
              {
                "required": [
                  "apiKey"
                ]
              },
              {
                "required": [
                  "verifier"
                ]
              },
              {
                "required": [
                  "privateKey"
                ]
              },
              {
                "required": [
                  "phoneNumber"
                ]
              },
              {
                "required": [
                  "email"
                ]
              },
              {
                "required": [
                  "contact"
                ]
              }
            ]
          }
        },
        "occurredAt": {
          "type": "string",
          "format": "date-time"
        }
      }
