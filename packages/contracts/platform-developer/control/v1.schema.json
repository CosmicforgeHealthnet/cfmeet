        },
        "description": {
          "type": "string",
          "maxLength": 500
        }
      },
      "description": "Creates a service account in a SANDBOX / TEST environment (PRODUCTION is refused: production-access workflow). No credential is issued (Section 54)."
    },
    "ActivityEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
