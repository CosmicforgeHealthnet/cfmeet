{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.cfmeet.com/platform-developer/control/v1.schema.json",
  "title": "CF Meet Developer Platform control plane v1",
  "description": "Section 50 control-plane resources: organizations (Platform Access tenants), human workspace members and invitations, projects (Platform Access applications), environments (Platform Access environments), service accounts (read through Platform Access delegation; never credentials), commercial plan / assignment / billing-account references, immutable activity events and effective entitlements. Identity, credentials and scopes stay Platform Access's.",
  "anyOf": [
    {
      "$ref": "#/$defs/Organization"
    },
    {
      "$ref": "#/$defs/Member"
    },
    {
      "$ref": "#/$defs/Invitation"
    },
    {
      "$ref": "#/$defs/InvitationWithToken"
    },
    {
      "$ref": "#/$defs/Project"
    },
    {
      "$ref": "#/$defs/Environment"
    },
    {
      "$ref": "#/$defs/ServiceAccount"
    },
    {
      "$ref": "#/$defs/ActivityEvent"
    },
    {
      "$ref": "#/$defs/CommercialPlan"
    },
    {
      "$ref": "#/$defs/PlanAssignment"
    },
    {
      "$ref": "#/$defs/BillingAccount"
    },
    {
      "$ref": "#/$defs/OrganizationCommercial"
    },
    {
      "$ref": "#/$defs/Entitlements"
    },
    {
      "$ref": "#/$defs/ProjectScopes"
    },
    {
      "$ref": "#/$defs/FirstPartyRegistration"
    }
  ],
  "$defs": {
    "Role": {
      "enum": [
        "OWNER",
        "ADMIN",
        "DEVELOPER",
        "ANALYST",
        "BILLING"
      ],
      "description": "Part VI workspace role (Section 50 permission matrix)."
    },
    "OrganizationState": {
      "enum": [
        "INVITED",
        "ACTIVE",
        "RESTRICTED",
        "SUSPENDED",
        "CLOSED"
      ]
    },
    "Organization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "displayName",
        "state",
        "stateReason",
        "supportEmail",
        "createdAt",
        "updatedAt",
        "closedAt",
        "version",
        "myRole"
      ],
      "properties": {
        "id": {
          "$ref": "https://schemas.cfmeet.com/platform/common/v1.schema.json#/$defs/Uuid",
          "description": "The organization id IS the canonical Platform Access tenant id."
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "state": {
          "$ref": "#/$defs/OrganizationState"
        },
        "stateReason": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "supportEmail": {
          "oneOf": [
            {
              "type": "string",
              "maxLength": 254,
              "pattern": "^[^@\\s]+@[^@\\s]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "closedAt": {
          "oneOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "myRole": {
          "oneOf": [
            {
              "$ref": "#/$defs/Role"
            },
            {
              "type": "null"
            }
          ]
        },
        "classification": {
          "enum": [
            "FIRST_PARTY",
            "EXTERNAL"
          ],
          "description": "Platform Access tenant classification (operator-controlled; GET of one organization only)."
        }
      }
    },
    "OrganizationList": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "items",
        "nextCursor"
      ],
      "properties": {
        "items": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/Organization"
          }
        },
        "nextCursor": {
          "oneOf": [
            {
              "type": "string",
              "maxLength": 200
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "description": "A page of results; pass `nextCursor` as `cursor` for the next page (null: last page)."
    },
    "CreateOrganizationRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "displayName"
      ],
      "properties": {
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "supportEmail": {
          "type": "string",
          "maxLength": 254,
          "pattern": "^[^@\\s]+@[^@\\s]+$"
        }
      }
    },
    "UpdateOrganizationRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expectedVersion"
      ],
      "properties": {
        "expectedVersion": {
          "type": "integer",
          "minimum": 1
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "supportEmail": {
          "oneOf": [
            {
              "type": "string",
              "maxLength": 254,
              "pattern": "^[^@\\s]+@[^@\\s]+$"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "Member": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "organizationId",
        "userId",
        "role",
        "status",
        "joinedVia",
        "createdAt",
        "updatedAt",
        "version"
      ],
      "properties": {
        "id": {
          "$ref": "https://schemas.cfmeet.com/platform/common/v1.schema.json#/$defs/Uuid"
        },
        "organizationId": {
          "$ref": "https://schemas.cfmeet.com/platform/common/v1.schema.json#/$defs/Uuid"
        },
        "userId": {
          "$ref": "https://schemas.cfmeet.com/platform/common/v1.schema.json#/$defs/Uuid",
          "description": "Opaque CF Meet account id (human developer); not a Platform Access principal."
        },
        "role": {
          "$ref": "#/$defs/Role"
        },
        "status": {
          "enum": [
            "ACTIVE",
            "REMOVED"
          ]
        },
        "joinedVia": {
          "enum": [
            "CREATOR",
            "INVITATION",
            "OPERATOR"
          ]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "MemberList": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "items",
        "nextCursor"
      ],
      "properties": {
        "items": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/Member"
          }
        },
        "nextCursor": {
          "oneOf": [
            {
              "type": "string",
              "maxLength": 200
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "description": "A page of results; pass `nextCursor` as `cursor` for the next page (null: last page)."
    },
    "ChangeRoleRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role"
      ],
      "properties": {
        "role": {
          "$ref": "#/$defs/Role"
        },
        "expectedVersion": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "TransferOwnershipRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "memberId"
      ],
      "properties": {
        "memberId": {
          "$ref": "https://schemas.cfmeet.com/platform/common/v1.schema.json#/$defs/Uuid"
        }
      }
    },
    "InvitationStatus": {
      "enum": [
        "PENDING",
        "ACCEPTED",
        "REVOKED",
        "EXPIRED"
      ]
    },
    "Invitation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "organizationId",
        "email",
        "role",
        "status",
        "createdAt",
        "expiresAt",
        "decidedAt"
      ],
      "properties": {
        "id": {
          "$ref": "https://schemas.cfmeet.com/platform/common/v1.schema.json#/$defs/Uuid"
        },
        "organizationId": {
          "$ref": "https://schemas.cfmeet.com/platform/common/v1.schema.json#/$defs/Uuid"
        },
        "email": {
          "type": "string",
          "maxLength": 254,
          "pattern": "^[^@\\s]+@[^@\\s]+$"
        },
        "role": {
          "$ref": "#/$defs/Role"
        },
        "status": {
          "$ref": "#/$defs/InvitationStatus"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        },
        "decidedAt": {
          "oneOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "InvitationWithToken": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "organizationId",
        "email",
        "role",
        "status",
        "createdAt",
        "expiresAt",
        "decidedAt",
        "token"
      ],
      "properties": {
        "id": {
          "$ref": "https://schemas.cfmeet.com/platform/common/v1.schema.json#/$defs/Uuid"
        },
        "organizationId": {
          "$ref": "https://schemas.cfmeet.com/platform/common/v1.schema.json#/$defs/Uuid"
        },
        "email": {
          "type": "string",
          "maxLength": 254,
          "pattern": "^[^@\\s]+@[^@\\s]+$"
        },
        "role": {
          "$ref": "#/$defs/Role"
        },
        "status": {
          "$ref": "#/$defs/InvitationStatus"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        },
        "decidedAt": {
          "oneOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "token": {
          "type": "string",
          "pattern": "^cfinv_[A-Za-z0-9_-]{43}$",
          "description": "One-time acceptance token, returned ONLY in this response (stored as a digest; never readable again)."
        }
      }
    },
    "InvitationList": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "items",
        "nextCursor"
      ],
      "properties": {
        "items": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/Invitation"
          }
        },
        "nextCursor": {
          "oneOf": [
            {
              "type": "string",
              "maxLength": 200
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "description": "A page of results; pass `nextCursor` as `cursor` for the next page (null: last page)."
    },
    "CreateInvitationRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "email",
        "role"
      ],
      "properties": {
        "email": {
          "type": "string",
          "maxLength": 254,
          "pattern": "^[^@\\s]+@[^@\\s]+$"
        },
        "role": {
          "$ref": "#/$defs/Role"
        }
      }
    },
    "AcceptInvitationRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "token"
      ],
      "properties": {
        "token": {
          "type": "string",
          "maxLength": 128
        }
      }
    },
    "ProjectStatus": {
      "enum": [
        "ACTIVE",
        "SUSPENDED",
        "ARCHIVED"
      ]
    },
    "Project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "organizationId",
        "displayName",
        "description",
        "supportEmail",
        "labels",
        "status",
        "statusReason",
        "createdAt",
        "updatedAt",
        "archivedAt",
        "version"
      ],
      "properties": {
        "id": {
          "$ref": "https://schemas.cfmeet.com/platform/common/v1.schema.json#/$defs/Uuid",
          "description": "The project id IS the canonical Platform Access application id."
        },
        "organizationId": {
          "$ref": "https://schemas.cfmeet.com/platform/common/v1.schema.json#/$defs/Uuid"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "description": {
          "oneOf": [
            {
              "type": "string",
              "maxLength": 1000
            },
            {
              "type": "null"
            }
          ]
        },
        "supportEmail": {
          "oneOf": [
            {
              "type": "string",
              "maxLength": 254,
              "pattern": "^[^@\\s]+@[^@\\s]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "labels": {
          "type": "object",
          "maxProperties": 32,
          "propertyNames": {
            "pattern": "^[A-Za-z0-9._/-]{1,64}$"
          },
          "additionalProperties": {
            "type": "string",
            "maxLength": 128
          }
        },
        "status": {
          "$ref": "#/$defs/ProjectStatus"
        },
        "statusReason": {
          "oneOf": [
            {
              "type": "string",
              "maxLength": 64
            },
            {
              "type": "null"
            }
          ]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "archivedAt": {
          "oneOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "version": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "ProjectList": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "items",
        "nextCursor"
      ],
      "properties": {
        "items": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/Project"
          }
        },
        "nextCursor": {
          "oneOf": [
            {
              "type": "string",
              "maxLength": 200
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "description": "A page of results; pass `nextCursor` as `cursor` for the next page (null: last page)."
    },
    "CreateProjectRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "displayName"
      ],
      "properties": {
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "description": {
          "type": "string",
          "maxLength": 1000
        },
        "supportEmail": {
          "type": "string",
          "maxLength": 254,
          "pattern": "^[^@\\s]+@[^@\\s]+$"
        },
        "labels": {
          "type": "object",
          "maxProperties": 32,
          "propertyNames": {
            "pattern": "^[A-Za-z0-9._/-]{1,64}$"
          },
          "additionalProperties": {
            "type": "string",
            "maxLength": 128
          }
        }
      }
    },
    "UpdateProjectRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expectedVersion"
      ],
      "properties": {
        "expectedVersion": {
          "type": "integer",
          "minimum": 1
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "description": {
          "oneOf": [
            {
              "type": "string",
              "maxLength": 1000
            },
            {
              "type": "null"
            }
          ]
        },
        "supportEmail": {
          "oneOf": [
            {
              "type": "string",
              "maxLength": 254,
              "pattern": "^[^@\\s]+@[^@\\s]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "labels": {
          "type": "object",
          "maxProperties": 32,
          "propertyNames": {
            "pattern": "^[A-Za-z0-9._/-]{1,64}$"
          },
          "additionalProperties": {
            "type": "string",
            "maxLength": 128
          }
        }
      }
    },
    "ProjectScopes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "projectId",
        "scopes"
      ],
      "properties": {
        "projectId": {
          "$ref": "https://schemas.cfmeet.com/platform/common/v1.schema.json#/$defs/Uuid"
        },
        "scopes": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "description": "Platform Access application scope grants (Platform Access is the authority)."
        }
      }
    },
    "ProductionAccessState": {
      "enum": [
        "NOT_APPLICABLE",
        "SANDBOX_READY",
        "PRODUCTION_REQUESTED",
        "UNDER_REVIEW",
        "APPROVED",
        "REJECTED",
        "SUSPENDED"
      ]
    },
    "Environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "projectId",
        "organizationId",
        "kind",
        "displayName",
        "status",
        "productionAccessState",
        "createdAt",
        "updatedAt",
        "version"
      ],
      "properties": {
        "id": {
          "$ref": "https://schemas.cfmeet.com/platform/common/v1.schema.json#/$defs/Uuid",
          "description": "The canonical Platform Access environment id."
        },
        "projectId": {
          "$ref": "https://schemas.cfmeet.com/platform/common/v1.schema.json#/$defs/Uuid"
        },
        "organizationId": {
          "$ref": "https://schemas.cfmeet.com/platform/common/v1.schema.json#/$defs/Uuid"
        },
        "kind": {
          "$ref": "https://schemas.cfmeet.com/platform-developer/common/v1.schema.json#/$defs/EnvironmentKind"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "status": {
          "enum": [
            "ACTIVE",
            "SUSPENDED"
          ]
        },
        "productionAccessState": {
          "$ref": "#/$defs/ProductionAccessState"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "authorityStatus": {
          "enum": [
            "ACTIVE",
            "SUSPENDED"
          ],
          "description": "Status reported by Platform Access (GET of one environment)."
        },
        "liveTelecomAllowed": {
          "type": "boolean"
        }
      }
    },
    "EnvironmentList": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "items",
        "nextCursor"
      ],
      "properties": {
        "items": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/Environment"
          }
        },
        "nextCursor": {
          "oneOf": [
            {
              "type": "string",
              "maxLength": 200
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "description": "A page of results; pass `nextCursor` as `cursor` for the next page (null: last page)."
    },
    "CreateEnvironmentRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "SANDBOX",
            "TEST"
          ],
          "description": "PRODUCTION environments are activated by the production-access workflow (Section 55)."
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        }
      }
    },
    "ServiceAccountStatus": {
      "enum": [
        "ACTIVE",
        "SUSPENDED",
        "REVOKED"
      ],
      "description": "Platform Access service-account status. The Developer Platform suspends / resumes (ACTIVE ⇄ SUSPENDED); REVOKED is terminal and an operator decision. A non-ACTIVE service account's API credentials do not authenticate."
    },
    "ServiceAccount": {
      "type": "object",
      "additionalProperties": false,
      "description": "A Platform Access service account (machine identity) of one environment, read through the Developer Platform. Platform Access is its only store; API credentials (secrets) are never part of it (Section 54).",
      "required": [
        "id",
        "organizationId",
        "projectId",
        "environmentId",
        "name",
        "description",
        "status",
        "createdAt",
        "updatedAt"
      ],
      "properties": {
        "id": {
          "$ref": "https://schemas.cfmeet.com/platform/common/v1.schema.json#/$defs/Uuid",
          "description": "The canonical Platform Access service account id."
        },
        "organizationId": {
          "$ref": "https://schemas.cfmeet.com/platform/common/v1.schema.json#/$defs/Uuid"
        },
        "projectId": {
          "$ref": "https://schemas.cfmeet.com/platform/common/v1.schema.json#/$defs/Uuid"
        },
        "environmentId": {
          "$ref": "https://schemas.cfmeet.com/platform/common/v1.schema.json#/$defs/Uuid"
        },
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,62}$",
          "description": "Stable key, unique within the environment."
        },
        "description": {
          "oneOf": [
            {
              "type": "string",
              "maxLength": 500
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "$ref": "#/$defs/ServiceAccountStatus"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "ServiceAccountList": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "items",
        "nextCursor"
      ],
      "properties": {
        "items": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/ServiceAccount"
          }
        },
        "nextCursor": {
          "oneOf": [
            {
              "type": "string",
              "maxLength": 200
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "description": "A page of results; pass `nextCursor` as `cursor` for the next page (null: last page)."
    },
    "CreateServiceAccountRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,62}$",
