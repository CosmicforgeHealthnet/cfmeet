            "description": "Unavailable scoped resource.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Event identity or payload conflict.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Required authority or persistence unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CommittedEvent"
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "cfServiceAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-CF-Service-Authorization",
        "description": "Bearer EdDSA service JWT from cf-service-auth; audience, runtime, request IDs, scope, expiration and receiver-granted permission are verified."
      }
    },
    "schemas": {
      "Blocked": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "blocked": {
            "type": "boolean"
          }
        },
        "required": [
          "blocked"
        ]
      },
      "CallingError": {
        "type": "object",
        "additionalProperties": false,
        "description": "Calling's error envelope (the owner's existing envelope and status).",
        "properties": {
          "error": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "code": {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9_]*$"
              },
              "message": {
                "type": "string"
              },
              "requestId": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^req_[0-9a-f]{32}$"
              }
            },
            "required": [
              "code",
              "message",
              "requestId"
            ]
          }
        },
        "required": [
          "error"
        ]
      },
      "Capability": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "available": {
            "type": "boolean"
          },
          "reason": {
            "type": "string",
            "enum": [
              "AVAILABLE",
              "DISABLED",
              "DEVICE_SECURITY_SETUP_REQUIRED"
            ]
          },
          "securityReady": {
            "type": "boolean"
          }
        },
        "required": [
          "available",
          "reason"
        ]
      },
      "CommittedEvent": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "schemaVersion": {
            "type": "integer",
            "enum": [
              1
            ]
          },
          "eventId": {
            "type": "string",
            "format": "uuid"
          },
          "aggregateId": {
            "type": "string",
            "format": "uuid"
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "type": {
            "type": "string",
            "pattern": "^communications[.][a-z.]+$",
            "maxLength": 80
          },
          "data": {
            "type": "object",
            "description": "Metadata-only domain event, never message content, credentials, invitation tokens or media."
          }
        },
        "required": [
          "schemaVersion",
          "eventId",
          "aggregateId",
          "version",
          "type",
          "data"
        ]
      },
      "CommunicationsCallEntry": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "callId": {
            "type": "string",
            "format": "uuid"
          },
          "kind": {
            "type": "string",
            "enum": [
              "VOICE",
              "VIDEO"
            ]
          },
          "state": {
            "type": "string"
          },
          "terminal": {
            "type": "boolean"
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "answeredAt": {
            "type": "string",
            "format": "date-time",
            "description": "The Call's answer time; absent until it was answered."
          },
          "endedAt": {
            "type": "string",
            "format": "date-time",
            "description": "Absent until the Call ended."
          },
          "durationMs": {
            "type": "integer",
            "minimum": 0,
            "description": "From CONNECTED to the end of the Call; absent while it lasts or if it never connected."
          },
          "direction": {
            "type": "string",
            "enum": [
              "INCOMING",
              "OUTGOING"
            ]
          },
          "outcome": {
            "type": "string",
            "enum": [
              "ANSWERED",
              "NOT_ANSWERED",
              "MISSED",
              "DECLINED",
              "ANSWERED_ELSEWHERE",
              "RINGING",
              "NOT_REACHED",
              "IN_PROGRESS"
            ]
          },
          "missed": {
            "type": "boolean"
          },
          "counterpartPrincipalIds": {
            "type": "array",
            "maxItems": 10,
            "items": {
              "type": "string",
              "format": "uuid"
            }
          }
        },
        "required": [
          "callId",
          "kind",
          "state",
          "terminal",
          "version",
          "createdAt",
          "direction",
          "outcome",
          "missed",
          "counterpartPrincipalIds"
        ]
      },
      "CommunicationsEndpoint": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "principalId": {
            "type": "string",
            "format": "uuid"
          },
          "endpointId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "principalId",
          "endpointId"
        ]
      },
      "CommunicationsEndpointRevocation": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "schemaVersion": {
            "type": "integer",
            "enum": [
              1
            ]
          },
          "revoked": {
            "type": "boolean"
          },
          "alreadyRevoked": {
            "type": "boolean"
          }
        },
        "required": [
          "schemaVersion",
          "revoked",
          "alreadyRevoked"
        ]
      },
      "CommunicationsEndpointVerification": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "schemaVersion": {
            "type": "integer",
            "enum": [
              1
            ]
          },
          "owned": {
            "type": "boolean"
          },
          "status": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "ACTIVE",
              "REVOKED",
              null
            ]
          },
          "endpointKind": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "schemaVersion",
          "owned",
          "status",
          "endpointKind"
        ]
      },
      "CommunicationsHistory": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "principalId": {
            "type": "string",
            "format": "uuid"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "cursor": {
            "type": "string",
            "description": "Opaque nextCursor of a previous page."
          },
          "missed": {
            "type": "boolean"
          }
        },
        "required": [
          "principalId",
          "limit"
        ]
      },
      "CommunicationsHistoryPage": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "schemaVersion": {
            "type": "integer",
            "enum": [
              1
            ]
          },
          "data": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "$ref": "#/components/schemas/CommunicationsCallEntry"
            }
          },
          "nextCursor": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "schemaVersion",
          "data",
          "nextCursor"
        ]
      },
      "CommunicationsLaunch": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "idempotencyKey": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "^[ -~]{1,200}$"
          },
          "initiatorPrincipalId": {
            "type": "string",
            "format": "uuid"
          },
          "initiatorEndpointId": {
            "type": "string",
            "format": "uuid"
          },
          "targetPrincipalIds": {
            "type": "array",
            "minItems": 1,
            "maxItems": 64,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Distinct, never the initiator; at most CALLING_MAX_GROUP_PARTICIPANTS - 1 (enforced by the domain)."
          },
          "kind": {
            "type": "string",
            "enum": [
              "VOICE",
              "VIDEO"
            ]
          }
        },
        "required": [
          "idempotencyKey",
          "initiatorPrincipalId",
          "initiatorEndpointId",
          "targetPrincipalIds",
          "kind"
        ]
      },
      "CommunicationsLaunchResult": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "schemaVersion": {
            "type": "integer",
            "enum": [
              1
            ]
          },
          "callId": {
            "type": "string",
            "format": "uuid"
          },
          "state": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "VOICE",
              "VIDEO"
            ]
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "replayed": {
            "type": "boolean"
          }
        },
        "required": [
          "schemaVersion",
          "callId",
          "state",
          "kind",
          "version",
          "createdAt",
          "replayed"
        ]
      },
      "CommunicationsParticipation": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "principalId": {
            "type": "string",
            "format": "uuid"
          },
          "callIds": {
            "type": "array",
            "minItems": 1,
            "maxItems": 50,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "format": "uuid"
            }
          }
        },
        "required": [
          "principalId",
          "callIds"
        ]
      },
      "CommunicationsParticipationResult": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "schemaVersion": {
            "type": "integer",
            "enum": [
              1
            ]
          },
          "calls": {
            "type": "array",
            "maxItems": 50,
            "items": {
              "$ref": "#/components/schemas/CommunicationsCallEntry"
            }
          }
        },
        "required": [
          "schemaVersion",
          "calls"
        ]
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "schemaVersion": {
            "type": "integer",
            "enum": [
              1
            ]
          },
          "error": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "AUTHENTICATION_REQUIRED",
                  "PERMISSION_DENIED",
                  "NOT_FOUND",
                  "VALIDATION_ERROR",
                  "VERSION_CONFLICT",
                  "IDEMPOTENCY_CONFLICT",
                  "REQUEST_PENDING",
                  "RATE_LIMITED",
                  "RECENT_AUTHENTICATION_REQUIRED",
                  "COMMUNICATIONS_UNAVAILABLE"
                ]
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "message"
            ]
          }
        },
        "required": [
          "schemaVersion",
          "error"
        ]
      },
      "EventReceipt": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "applied": {
            "type": "boolean"
          },
          "duplicate": {
            "type": "boolean"
          }
        },
        "required": [
          "applied",
          "duplicate"
        ]
      },
      "Pair": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "actorPrincipalId": {
            "type": "string",
            "format": "uuid"
          },
          "targetPrincipalId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "actorPrincipalId",
          "targetPrincipalId"
        ]
      },
      "Principal": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "principalId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "principalId"
        ]
      }
    }
  }
}
