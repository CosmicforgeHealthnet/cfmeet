      }
    },
    "/internal/v1/communications/calls": {
      "post": {
        "operationId": "launchCallingCommunicationsCall",
        "summary": "Start an app call for the delegated user (CL-1)",
        "description": "Start an app call for the delegated user (CL-1). Runs the same domain path as customer POST /v1/calls for an application call: the personal policy check runs before idempotent replay, the initiator endpoint must be an ACTIVE endpoint of the initiator, principal categories, blocks, the group limit (CALLING_MAX_GROUP_PARTICIPANTS), routing and ringing all apply. The call is attributed to the scope's configured launch credential (CALLING_COMMUNICATIONS_LAUNCH_CREDENTIAL_ID), re-verified live with Platform Access; unset, rejected, suspended or lacking calls.write it fails closed (503). Idempotent per (initiator, idempotencyKey) in a namespace distinct from customer Idempotency-Key values: a replay returns the first call with replayed=true; the same key with a different request is 409 IDEMPOTENCY_CONFLICT. Private signed service traffic only; the delegated tenant, application and environment must be the governed personal scope (any other scope is 404). Permission calling-communications.launch is granted only by the receiving service trust policy to cfmeet.communications (other callers 403). initiatorPrincipalId must equal the delegated NATIVE_CF_USER initiating principal; otherwise 403. Responses carry no credential, media, provider, recording or contact data.",
        "tags": [
          "Communications integration"
        ],
        "security": [
          {
            "cfServiceAuth": []
          }
        ],
        "x-cfmeet-internal-permission": "calling-communications.launch",
        "parameters": [
          {
            "name": "X-CF-Request-Id",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^req_[0-9a-f]{32}$"
            }
          },
          {
            "name": "X-CF-Correlation-Id",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^corr_[0-9a-f]{32}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Typed private result.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CommunicationsLaunchResult"
                }
              }
            }
          },
          "400": {
            "description": "Invalid typed request (unknown field, bound or format).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CallingError"
                }
              }
            }
          },
          "401": {
            "description": "Invalid or replayed service authentication.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CallingError"
                }
              }
            }
          },
          "403": {
            "description": "Permission denied, no delegated context, or a principal other than the delegated user.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CallingError"
                }
              }
            }
          },
          "404": {
            "description": "Initiator endpoint not an ACTIVE endpoint of the initiator, unknown principal, or delegated scope not governed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CallingError"
                }
              }
            }
          },
          "409": {
            "description": "Personal policy or block refusal (TARGET_UNAVAILABLE), idempotency conflict, participant limit or call-state conflict.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CallingError"
                }
              }
            }
          },
          "503": {
            "description": "Communications policy, launch authority, media provider or persistence unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CallingError"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CommunicationsLaunch"
              }
            }
          }
        }
      }
    },
