{
  "openapi": "3.1.0",
  "info": {
    "title": "CF Meet calling private Communications integration",
    "version": "1.1.0",
    "description": "Private backend interfaces for Sections 4–7 and the Sections 9–23 Calling owner interfaces (CL-1 … CL-5). Never routed by public ingress or advertised by public Swagger. The owner retains canonical data. Scope, permissions and identities come from signed service authentication; request bodies cannot impersonate principals."
  },
  "tags": [
    {
      "name": "Communications integration",
      "description": "Narrow owner-authenticated metadata and policy interfaces."
    }
  ],
  "paths": {
    "/internal/v1/communications/blocks/check": {
      "post": {
        "operationId": "checkCallingCommunicationsBlocks",
        "summary": "Read canonical domain blocks",
        "description": "Read canonical domain blocks. Private signed service traffic only; the delegated tenant, application and environment must match the verified Platform Access authority. Permission calling-communications.read is granted only by the receiving service trust policy. Replayed JWT hops are refused by the Hub; events and commands additionally deduplicate their durable identities. Failures never grant communications.",
        "tags": [
          "Communications integration"
        ],
        "security": [
          {
            "cfServiceAuth": []
          }
        ],
        "x-cfmeet-internal-permission": "calling-communications.read",
        "parameters": [
          {
            "name": "X-CF-Request-Id",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^req_[0-9a-f]{32}$"
            }
          },
          {
            "name": "X-CF-Correlation-Id",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^corr_[0-9a-f]{32}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Typed private result.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Blocked"
                }
              }
            }
          },
          "400": {
            "description": "Invalid typed request.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Invalid or replayed service authentication.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Permission or delegated scope denied.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Unavailable scoped resource.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Event identity or payload conflict.",
