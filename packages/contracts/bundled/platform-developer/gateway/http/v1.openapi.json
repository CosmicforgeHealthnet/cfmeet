{
  "openapi": "3.1.0",
  "info": {
    "title": "CF Meet public API Gateway",
    "version": "1.1.0",
    "description": "Customer ingress of services/api-gateway (Part VI §51): probes, public documentation and discovery, and the generated public route catalogue (infra/api-gateway/route-manifest.json, documented per domain in cfmeet.*.public-api and in aggregate in cfmeet.api-gateway.public-api). Default deny; internal, provider-callback, operator, Platform Access and Telephony surfaces are never routable. The foundation diagnostic route GET /v1/developer-platform/context is kept."
  },
  "tags": [
    {
      "name": "Probes",
      "description": "Liveness and readiness of the API Gateway."
    },
    {
      "name": "Developer context",
      "description": "The authenticated customer's forwarded Developer Platform context."
    },
    {
      "name": "Documentation and discovery",
      "description": "Public OpenAPI documents, the read-only API reference and the API catalogue."
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "Probes"
        ],
        "summary": "Liveness probe",
        "operationId": "health",
        "security": [],
        "description": "Liveness.",
        "responses": {
          "200": {
            "description": "Alive.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/platform-developer.gateway.common.v1.HealthStatus"
                }
              }
            }
          }
        }
      }
    },
    "/ready": {
      "get": {
        "tags": [
          "Probes"
        ],
        "summary": "Readiness probe",
        "operationId": "ready",
        "security": [],
        "description": "Readiness: route catalogue loaded (counts only).",
        "responses": {
          "200": {
            "description": "Ready.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/platform-developer.gateway.common.v1.ReadinessStatus"
                }
              }
            }
          }
        }
      }
    },
    "/v1/developer-platform/context": {
      "get": {
        "tags": [
          "Developer context"
        ],
        "summary": "Get the developer platform context",
        "operationId": "getDeveloperPlatformContext",
        "security": [
          {
            "platformCredential": []
          }
        ],
        "description": "Foundation route (catalogue id developer-platform.context): authenticates the credential through Platform Access and forwards to the Developer Platform (GET /internal/v1/gateway/context) with the signed delegated context. Served only when API_GATEWAY_PUBLIC_ROUTING_ENABLED is true.",
        "responses": {
          "200": {
            "description": "Canonical context of the credential's application environment.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/platform-developer.common.v1.GatewayContext"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "$ref": "#/components/responses/Error"
          },
          "502": {
            "$ref": "#/components/responses/Error"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          },
          "504": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/openapi.json": {
      "get": {
        "tags": [
          "Documentation and discovery"
        ],
        "summary": "Get the aggregate public OpenAPI",
        "operationId": "getPublicOpenApi",
        "security": [],
        "description": "The aggregate customer-facing OpenAPI (public operations only, references resolved).",
        "responses": {
          "200": {
            "description": "OK.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/openapi/{file}": {
      "get": {
        "tags": [
          "Documentation and discovery"
        ],
        "summary": "Get a per-domain public OpenAPI",
        "operationId": "getPublicDomainOpenApi",
        "security": [],
        "description": "The per-domain customer-facing OpenAPI (`{domain}.json`: meetings, calling, privacy-relay, messaging, numbering, sms, developer-platform).",
        "responses": {
          "200": {
            "description": "OK.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/Error"
          }
        },
        "parameters": [
          {
            "name": "file",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-z-]{1,40}\\.json$"
            }
          }
        ]
      }
    },
    "/docs": {
      "get": {
        "tags": [
          "Documentation and discovery"
        ],
        "summary": "Public API reference",
        "operationId": "getApiReference",
        "security": [],
        "description": "Read-only public API reference (Swagger UI over the public documents only; pinned, integrity-checked assets).",
        "responses": {
          "200": {
            "description": "OK.",
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/discovery": {
      "get": {
        "tags": [
          "Documentation and discovery"
        ],
        "summary": "API catalogue and service discovery",
        "operationId": "getDiscovery",
        "security": [],
        "description": "API catalogue and service discovery: families, source contract and version, routable operations, WebSocket channels and enablement.",
        "responses": {
          "200": {
            "description": "OK.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "platformCredential": {
        "type": "http",
        "scheme": "bearer",
        "description": "A CF Meet API credential issued by Platform Access (Authorization: Bearer). X-CF-* headers supplied by a client are stripped; a client X-CF-Service-Authorization is refused."
      }
    },
    "responses": {
      "Error": {
        "description": "Error.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/platform-developer.gateway.common.v1.Error"
            }
          }
        }
      }
    },
    "schemas": {
      "platform-developer.common.v1.AuthorityMode": {
        "type": "string",
        "enum": [
          "FULL",
          "SAFETY_ONLY"
        ]
      },
      "platform-developer.common.v1.EnvironmentKind": {
        "$ref": "#/components/schemas/platform.common.v1.ApplicationEnvironmentKind"
      },
      "platform-developer.common.v1.GatewayContext": {
        "description": "GET /internal/v1/gateway/context: the canonical Platform Access ids of the caller's application environment, as Platform Access re-validated them from the API Gateway's signed delegated context.",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "tenantId",
          "applicationId",
          "environmentId",
          "environmentKind",
          "serviceAccountId",
          "authorityMode",
          "authority",
          "forwardedBy",
          "correlationId"
        ],
        "properties": {
          "tenantId": {
            "$ref": "#/components/schemas/platform.common.v1.Uuid"
          },
          "applicationId": {
            "$ref": "#/components/schemas/platform.common.v1.Uuid"
          },
          "environmentId": {
            "$ref": "#/components/schemas/platform.common.v1.Uuid"
          },
          "environmentKind": {
            "$ref": "#/components/schemas/platform-developer.common.v1.EnvironmentKind"
          },
          "serviceAccountId": {
            "$ref": "#/components/schemas/platform.common.v1.Uuid"
          },
          "authorityMode": {
            "$ref": "#/components/schemas/platform-developer.common.v1.AuthorityMode"
          },
          "authority": {
            "const": "PLATFORM_ACCESS"
          },
          "forwardedBy": {
            "const": "cfmeet.api-gateway"
          },
          "correlationId": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/platform.common.v1.CorrelationId"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "platform-developer.gateway.common.v1.Error": {
        "description": "Public error envelope (Cache-Control: no-store). An unknown route is NOT_FOUND (default deny); messages never echo input, credentials or upstream text.",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code",
              "message",
              "requestId"
            ],
            "properties": {
              "code": {
                "$ref": "#/components/schemas/platform-developer.gateway.common.v1.ErrorCode"
              },
              "message": {
                "type": "string",
                "maxLength": 200
              },
              "requestId": {
                "oneOf": [
                  {
                    "$ref": "#/components/schemas/platform.common.v1.RequestId"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          }
        }
      },
      "platform-developer.gateway.common.v1.ErrorCode": {
        "type": "string",
        "enum": [
          "NOT_FOUND",
          "METHOD_NOT_ALLOWED",
          "PAYLOAD_TOO_LARGE",
          "VALIDATION_ERROR",
          "AUTHENTICATION_FAILED",
          "INSUFFICIENT_SCOPE",
          "RATE_LIMITED",
          "QUOTA_EXCEEDED",
          "HEADERS_TOO_LARGE",
          "URI_TOO_LONG",
          "ORIGIN_NOT_ALLOWED",
          "PROTOCOL_NOT_ENABLED",
          "UPSTREAM_UNAVAILABLE",
          "UPSTREAM_TIMEOUT",
          "SERVICE_UNAVAILABLE",
          "INTERNAL_ERROR"
        ]
      },
      "platform-developer.gateway.common.v1.HealthStatus": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status",
          "service"
        ],
        "properties": {
          "status": {
            "const": "ok"
          },
          "service": {
            "const": "api-gateway"
          }
        }
      },
      "platform-developer.gateway.common.v1.ReadinessStatus": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status",
          "service",
          "publicRouting",
          "routes",
          "websockets",
          "quotas"
        ],
        "properties": {
          "status": {
            "enum": [
              "ready",
              "not_ready"
            ]
          },
          "service": {
            "const": "api-gateway"
          },
          "publicRouting": {
            "enum": [
              "enabled",
              "disabled"
            ]
          },
          "routes": {
            "type": "integer",
            "minimum": 0
          },
          "websockets": {
            "enum": [
              "enabled",
              "disabled"
            ]
          },
          "quotas": {
            "enum": [
              "not_enforced",
              "configured"
            ]
          }
        }
      },
      "platform.common.v1.ApplicationEnvironmentKind": {
        "description": "Kind of a customer application environment (Part B section 7).",
        "type": "string",
        "enum": [
          "SANDBOX",
          "TEST",
          "PRODUCTION"
        ]
      },
      "platform.common.v1.CorrelationId": {
        "description": "Server-generated identifier that stays stable across every hop of one causal operation.",
        "type": "string",
        "pattern": "^corr_[0-9a-f]{32}$"
      },
      "platform.common.v1.RequestId": {
        "description": "Server-generated identifier of one request / one service hop.",
        "type": "string",
        "pattern": "^req_[0-9a-f]{32}$"
      },
      "platform.common.v1.Uuid": {
        "description": "Lower-case hyphenated UUID.",
        "type": "string",
        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
      }
    }
  }
}
