{
  "openapi": "3.1.0",
  "info": {
    "title": "CF Meet Organizations — Notification Service owner API",
    "version": "1.0.0",
    "description": "X5 resolveInvitationInvitee (blueprint Document 4 §3.4; owner decision D-5 approved: secure organization invitation recipient resolution). Frozen by roadmap N1; implemented in N6. Grantable to cfmeet.notifications only. Never returns the invitee email or the token."
  },
  "paths": {
    "/internal/v1/organization-invitations/{invitationId}/invitee/resolve": {
      "post": {
        "operationId": "resolveInvitationInvitee",
        "summary": "Resolve an invitation's invitee account (X5)",
        "description": "{status, inviteeAccountRef?}. inviteeAccountRef is present only when the invitee is (or became) an existing CF Meet account; the email is never returned.",
        "tags": [
          "Notification owner"
        ],
        "security": [
          {
            "cfServiceAuth": []
          }
        ],
        "x-cfmeet-internal-permission": "organization-invitations.read",
        "parameters": [
          {
            "name": "invitationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Invitee.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "status",
                    "inviteeAccountRef"
                  ],
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "PENDING",
                        "ACCEPTED",
                        "DECLINED",
                        "REVOKED",
                        "EXPIRED"
                      ]
                    },
                    "inviteeAccountRef": {
                      "anyOf": [
                        {
                          "$ref": "https://schemas.cfmeet.com/notifications/common/v1.schema.json#/$defs/AccountRef"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "NOT_FOUND.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "https://schemas.cfmeet.com/notifications/common/v1.schema.json#/$defs/Error"
                }
              }
            }
          },
          "400": {
            "description": "VALIDATION_ERROR.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "https://schemas.cfmeet.com/notifications/common/v1.schema.json#/$defs/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid or replayed service token (INTERNAL_AUTHENTICATION_FAILED).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "https://schemas.cfmeet.com/notifications/common/v1.schema.json#/$defs/Error"
                }
              }
            }
          },
          "403": {
            "description": "INTERNAL_PERMISSION_DENIED (FORBIDDEN): the issuer does not hold the permission in the receiver's trust bundle.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "https://schemas.cfmeet.com/notifications/common/v1.schema.json#/$defs/Error"
                }
              }
            }
          },
          "429": {
            "description": "RATE_LIMITED (Retry-After).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "https://schemas.cfmeet.com/notifications/common/v1.schema.json#/$defs/Error"
                }
              }
            }
          },
          "503": {
            "description": "UNAVAILABLE (Retry-After).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "https://schemas.cfmeet.com/notifications/common/v1.schema.json#/$defs/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "cfServiceAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-CF-Service-Authorization",
        "description": "Bearer EdDSA service token from packages/service-auth; audience cfmeet.organizations; issuer must be cfmeet.notifications holding the stated permission in the receiver's trust bundle."
      }
    }
  }
}
