{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.cfmeet.com/sms-gateway/common/v1.schema.json",
  "title": "CF Meet SMS Gateway common v1",
  "description": "SMS Gateway vocabulary and messages (Part IV M–O): transport status / direction / encoding, control reasons, the error envelope, messages, threads, callback acknowledgements, send and opt-out requests. Never a full telephone number in a response, never a provider identifier.",
  "oneOf": [
    {
      "$ref": "#/$defs/Error"
    },
    {
      "$ref": "#/$defs/Message"
    },
    {
      "$ref": "#/$defs/MessagePage"
    },
    {
      "$ref": "#/$defs/Thread"
    },
    {
      "$ref": "#/$defs/ThreadPage"
    },
    {
      "$ref": "#/$defs/CallbackAck"
    },
    {
      "$ref": "#/$defs/SendMessageRequest"
    },
    {
      "$ref": "#/$defs/OptOutRequest"
    },
    {
      "$ref": "#/$defs/OptOut"
    }
  ],
  "$defs": {
    "Status": {
      "description": "Transport status. UNKNOWN: the provider may hold the message; it is never resubmitted, only provider evidence resolves it.",
      "type": "string",
      "enum": [
        "REQUESTED",
        "AUTHORIZED",
        "SUBMITTING",
        "SUBMITTED",
        "DELIVERED",
        "RECEIVED",
        "FAILED",
        "UNKNOWN",
        "EXPIRED"
      ]
    },
    "Direction": {
      "type": "string",
      "enum": [
        "OUTBOUND",
        "INBOUND"
      ]
    },
    "Encoding": {
      "description": "GSM-7 (160 / 153 septets per segment; extension characters count two) or UCS-2 (70 / 67 UTF-16 units).",
      "type": "string",
      "enum": [
        "GSM7",
        "UCS2"
      ]
    },
    "ControlReason": {
      "description": "Stable reason codes of the safety controls and conflicts.",
      "type": "string",
      "enum": [
        "RATE_LIMITED",
        "DESTINATION_RATE_LIMITED",
        "DESTINATION_NOT_ALLOWED",
        "RECIPIENT_OPTED_OUT",
        "SPEND_LIMIT_EXCEEDED",
        "ABUSE_SUSPECTED",
        "SENDER_NOT_AUTHORIZED",
        "INVALID_TRANSITION",
        "VERSION_CONFLICT",
        "PREMIUM_DESTINATION_BLOCKED",
        "TENANT_RATE_LIMITED",
        "NUMBER_RATE_LIMITED",
        "PRINCIPAL_RATE_LIMITED",
        "TENANT_SPEND_LIMIT_EXCEEDED",
        "REPEATED_DESTINATION",
        "COST_SPIKE_CIRCUIT_OPEN",
        "PROVIDER_ANOMALY",
        "IDEMPOTENCY_RACE",
        "THREAD_UNAVAILABLE"
      ]
    },
    "Error": {
      "description": "The SMS Gateway error envelope.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "error"
      ],
      "properties": {
        "error": {
          "description": "One error.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "message",
            "requestId"
          ],
          "properties": {
            "code": {
              "type": "string",
              "enum": [
                "VALIDATION_ERROR",
                "AUTHENTICATION_FAILED",
                "INSUFFICIENT_SCOPE",
                "NOT_FOUND",
                "METHOD_NOT_ALLOWED",
                "PAYLOAD_TOO_LARGE",
                "RATE_LIMITED",
                "INTERNAL_AUTHENTICATION_FAILED",
                "INTERNAL_PERMISSION_DENIED",
                "CALLBACK_REJECTED",
                "IDEMPOTENCY_KEY_REQUIRED",
                "IDEMPOTENCY_KEY_REUSED",
                "CONTENT_TOO_LONG",
                "SMS_BLOCKED",
                "CONFLICT",
                "NUMBERING_UNAVAILABLE",
                "PROVIDER_UNAVAILABLE",
                "SERVICE_UNAVAILABLE",
                "INTERNAL_ERROR"
              ]
            },
            "message": {
              "type": "string",
              "maxLength": 300
            },
            "requestId": {
              "oneOf": [
                {
                  "$ref": "https://schemas.cfmeet.com/platform/common/v1.schema.json#/$defs/RequestId"
                },
                {
                  "type": "null"
                }
              ]
            },
            "reason": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_]{1,63}$"
            },
            "messageId": {
              "$ref": "https://schemas.cfmeet.com/platform/common/v1.schema.json#/$defs/Uuid"
            }
          }
        }
      }
    },
    "RemoteParty": {
      "description": "The remote party (masked only).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "masked"
      ],
      "properties": {
        "masked": {
          "type": "string",
          "pattern": "^\\+\\*{3}[0-9]{0,4}$",
          "description": "The remote party, masked: `+***` and the last four digits. The full number is never returned."
        }
      }
    },
    "Routing": {
      "description": "Numbering's SMS routing target of an inbound message (opaque CF Meet reference).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "targetKind",
        "targetRef"
      ],
      "properties": {
        "targetKind": {
          "type": "string",
          "pattern": "^[A-Z][A-Z_]{1,39}$"
        },
        "targetRef": {
          "$ref": "https://schemas.cfmeet.com/platform/common/v1.schema.json#/$defs/Uuid"
        }
      }
    },
    "Cost": {
      "description": "Estimated / provider-confirmed cost in minor units.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "estimatedMinor",
        "confirmedMinor",
        "currency"
      ],
      "properties": {
        "estimatedMinor": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "confirmedMinor": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        }
      }
    },
    "Message": {
      "description": "One message (inbound or outbound). `content` is the plaintext for the owning environment only (null once purged by retention); the remote party is masked; no provider identifier.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "messageId",
        "direction",
        "status",
        "numberResourceId",
        "threadId",
        "remote",
        "content",
        "contentPurged",
        "encoding",
        "segmentCount",
        "characterCount",
        "principalId",
        "routing",
        "failureCode",
        "blockedReason",
        "cost",
        "createdAt",
        "expiresAt",
        "submittedAt",
        "deliveredAt",
        "receivedAt",
        "failedAt"
      ],
      "properties": {
        "messageId": {
          "$ref": "https://schemas.cfmeet.com/platform/common/v1.schema.json#/$defs/Uuid"
        },
        "direction": {
          "$ref": "#/$defs/Direction"
        },
        "status": {
          "$ref": "#/$defs/Status"
        },
        "numberResourceId": {
          "$ref": "https://schemas.cfmeet.com/platform/common/v1.schema.json#/$defs/Uuid"
        },
        "threadId": {
          "$ref": "https://schemas.cfmeet.com/platform/common/v1.schema.json#/$defs/Uuid"
        },
        "remote": {
          "$ref": "#/$defs/RemoteParty"
        },
        "content": {
          "oneOf": [
            {
              "type": "string",
              "maxLength": 1600
            },
            {
              "type": "null"
            }
          ]
        },
        "contentPurged": {
          "type": "boolean"
        },
        "encoding": {
          "$ref": "#/$defs/Encoding"
        },
        "segmentCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "characterCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1600
        },
        "principalId": {
          "oneOf": [
            {
              "$ref": "https://schemas.cfmeet.com/platform/common/v1.schema.json#/$defs/Uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "routing": {
          "oneOf": [
            {
              "$ref": "#/$defs/Routing"
            },
            {
              "type": "null"
            }
          ]
        },
        "failureCode": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_]{1,63}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "blockedReason": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_]{1,63}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "cost": {
          "oneOf": [
            {
              "$ref": "#/$defs/Cost"
            },
            {
              "type": "null"
            }
          ]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "expiresAt": {
          "oneOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "submittedAt": {
          "oneOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "deliveredAt": {
          "oneOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "receivedAt": {
          "oneOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "failedAt": {
          "oneOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "MessagePage": {
      "description": "A page of messages, newest first.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "messages",
        "nextCursor"
      ],
      "properties": {
        "messages": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/Message"
          }
        },
        "nextCursor": {
          "oneOf": [
            {
              "type": "string",
              "maxLength": 200
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "Thread": {
      "description": "A transport thread: the messages between one Number Resource and one remote party. A transport index, not a conversation.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "threadId",
        "numberResourceId",
        "remote",
        "messageCount",
        "lastMessageAt",
        "createdAt"
      ],
      "properties": {
        "threadId": {
          "$ref": "https://schemas.cfmeet.com/platform/common/v1.schema.json#/$defs/Uuid"
        },
        "numberResourceId": {
          "$ref": "https://schemas.cfmeet.com/platform/common/v1.schema.json#/$defs/Uuid"
        },
        "remote": {
          "$ref": "#/$defs/RemoteParty"
        },
        "messageCount": {
          "type": "integer",
          "minimum": 0
        },
        "lastMessageAt": {
          "type": "string",
          "format": "date-time"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "ThreadPage": {
      "description": "A page of threads, most recent first.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "threads",
        "nextCursor"
      ],
      "properties": {
        "threads": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/Thread"
          }
        },
        "nextCursor": {
          "oneOf": [
            {
              "type": "string",
              "maxLength": 200
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "CallbackAck": {
      "description": "Provider callback acknowledgement (the provider stops retrying).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "disposition"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "ACCEPTED",
            "DUPLICATE"
          ]
        },
        "disposition": {
          "type": "string",
          "enum": [
            "APPLIED",
            "STALE",
            "UNMATCHED",
            "QUARANTINED",
            "REFUSED"
          ]
        }
      }
    },
    "SendMessageRequest": {
      "description": "POST /v1/sms/messages (scope sms.send, Idempotency-Key required): send ONE message from a Number Resource the environment actively owns (Numbering issues and the gateway consumes a single-use SMS_SENDER grant — an arbitrary sender id is impossible). The recipient is either `to` (E.164) or the remote party of `threadId`.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "text"
      ],
      "properties": {
        "from": {
          "description": "The sender.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "numberResourceId"
          ],
          "properties": {
            "numberResourceId": {
              "$ref": "https://schemas.cfmeet.com/platform/common/v1.schema.json#/$defs/Uuid"
            }
          }
        },
        "to": {
          "type": "string",
          "pattern": "^\\+[1-9][0-9]{6,14}$"
        },
        "threadId": {
          "$ref": "https://schemas.cfmeet.com/platform/common/v1.schema.json#/$defs/Uuid"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1600
        },
        "principalId": {
          "$ref": "https://schemas.cfmeet.com/platform/common/v1.schema.json#/$defs/Uuid",
          "description": "The principal the message is sent for (required for personal / professional numbers; must be ACTIVE in the environment)."
        },
        "validitySeconds": {
          "type": "integer",
          "minimum": 60,
          "maximum": 86400
        }
      },
      "oneOf": [
        {
          "required": [
            "to"
          ],
          "not": {
            "required": [
              "threadId"
            ]
          }
        },
        {
          "required": [
            "threadId"
          ],
          "not": {
            "required": [
              "to"
            ]
          }
        }
      ]
    },
    "OptOutRequest": {
      "description": "POST /v1/sms/opt-outs (scope sms.send): the customer blocks a recipient for one number (or every number of the environment).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "to"
      ],
      "properties": {
        "to": {
          "type": "string",
          "pattern": "^\\+[1-9][0-9]{6,14}$"
        },
        "numberResourceId": {
          "$ref": "https://schemas.cfmeet.com/platform/common/v1.schema.json#/$defs/Uuid"
        }
      }
    },
    "OptOut": {
      "description": "A recipient block (masked).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "remote",
        "numberResourceId",
        "reason",
        "createdAt"
      ],
      "properties": {
        "remote": {
          "$ref": "#/$defs/RemoteParty"
        },
        "numberResourceId": {
          "oneOf": [
            {
              "$ref": "https://schemas.cfmeet.com/platform/common/v1.schema.json#/$defs/Uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "reason": {
          "type": "string",
          "enum": [
            "STOP_KEYWORD",
            "CUSTOMER_REQUEST",
            "ABUSE"
          ]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
