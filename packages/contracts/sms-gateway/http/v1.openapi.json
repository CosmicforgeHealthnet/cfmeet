{
  "openapi": "3.1.0",
  "info": {
    "title": "CF Meet SMS Gateway API",
    "version": "1.1.0",
    "description": "HTTP surface of services/sms-gateway: GET /health, /ready, /openapi.json (public, no data); the customer API under /v1/sms (credential verified by Platform Access on every request; scopes sms.read; 503 when Platform Access is unreachable — fail closed); provider callbacks under /provider-callbacks/v1/sms (adapter signature). Every non-probe path, including unknown ones, runs behind its authentication. Request bodies are limited to 32 KiB."
  },
  "paths": {
    "/health": {
      "get": {
        "operationId": "health",
        "security": [],
        "description": "Liveness.",
        "responses": {
          "200": {
            "description": "Alive.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthStatus"
                }
              }
            }
          }
        }
      }
    },
    "/ready": {
      "get": {
        "operationId": "ready",
        "security": [],
        "description": "Readiness: database, migrations, provider configured, outbox / unknown-transport backlog (counts only).",
        "responses": {
          "200": {
            "description": "Ready.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Readiness"
                }
              }
            }
          },
          "503": {
            "description": "Not ready.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Readiness"
                }
              }
            }
          }
        }
      }
    },
    "/openapi.json": {
      "get": {
        "operationId": "openapi",
        "security": [],
        "description": "This document (the served contract).",
        "responses": {
          "200": {
            "description": "The OpenAPI document.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/v1/sms/messages/{messageId}": {
      "get": {
        "operationId": "getMessage",
        "security": [
          {
            "customerCredential": []
          }
        ],
        "description": "One message of the credential's environment (scope sms.read). Another environment's message is NOT_FOUND. Content is returned to its owner only; the remote party is masked.",
        "parameters": [
          {
            "name": "messageId",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "https://schemas.cfmeet.com/platform/common/v1.schema.json#/$defs/Uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "https://schemas.cfmeet.com/sms-gateway/common/v1.schema.json#/$defs/Message"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "$ref": "#/components/responses/Error"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/v1/sms/messages": {
      "get": {
        "operationId": "listMessages",
        "security": [
          {
            "customerCredential": []
          }
        ],
        "description": "Messages of the environment, newest first (scope sms.read), optionally of one number (`numberResourceId`) or direction.",
        "parameters": [
          {
            "name": "numberResourceId",
            "in": "query",
            "required": false,
            "schema": {
              "$ref": "https://schemas.cfmeet.com/platform/common/v1.schema.json#/$defs/Uuid"
            }
          },
          {
            "name": "direction",
            "in": "query",
            "required": false,
            "schema": {
              "$ref": "https://schemas.cfmeet.com/sms-gateway/common/v1.schema.json#/$defs/Direction"
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 200
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "https://schemas.cfmeet.com/sms-gateway/common/v1.schema.json#/$defs/MessagePage"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "$ref": "#/components/responses/Error"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/v1/sms/threads": {
      "get": {
        "operationId": "listThreads",
        "security": [
          {
            "customerCredential": []
          }
        ],
        "description": "Transport threads of the environment, most recent first (scope sms.read).",
        "parameters": [
          {
            "name": "numberResourceId",
            "in": "query",
            "required": false,
            "schema": {
              "$ref": "https://schemas.cfmeet.com/platform/common/v1.schema.json#/$defs/Uuid"
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 200
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "https://schemas.cfmeet.com/sms-gateway/common/v1.schema.json#/$defs/ThreadPage"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "$ref": "#/components/responses/Error"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/v1/sms/threads/{threadId}/messages": {
      "get": {
        "operationId": "listThreadMessages",
        "security": [
          {
            "customerCredential": []
          }
        ],
        "description": "The messages of one thread, newest first (scope sms.read).",
        "parameters": [
          {
            "name": "threadId",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "https://schemas.cfmeet.com/platform/common/v1.schema.json#/$defs/Uuid"
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 200
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "https://schemas.cfmeet.com/sms-gateway/common/v1.schema.json#/$defs/MessagePage"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "$ref": "#/components/responses/Error"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/provider-callbacks/v1/sms/{providerId}/inbound": {
      "post": {
        "operationId": "providerInboundCallback",
        "security": [
          {
            "providerSignature": []
          }
        ],
        "description": "A provider's inbound message. Authenticated by the adapter (signature over the raw body, timestamp window) BEFORE parsing; de-duplicated by the provider event id. The destination is resolved by Numbering (sms-destination-resolutions): ROUTED → stored sealed for the owning environment (sms.received); not routable → QUARANTINED (never delivered to a customer). 503 while Numbering is unreachable (the provider retries; nothing is stored).",
        "parameters": [
          {
            "name": "providerId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-z0-9-]{1,64}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "https://schemas.cfmeet.com/sms-gateway/common/v1.schema.json#/$defs/CallbackAck"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          },
          "413": {
            "$ref": "#/components/responses/Error"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "customerCredential": {
        "type": "http",
        "scheme": "bearer",
        "description": "A CF Meet API credential, verified by Platform Access (never by the SMS Gateway)."
      },
      "providerSignature": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Provider-Signature",
        "description": "The provider adapter's HMAC-SHA256 signature over the raw body with X-Provider-Timestamp (300 s window) and X-Provider-Event-Id."
      },
      "cfServiceAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-CF-Service-Authorization",
        "description": "Bearer <service token> (cfmeet.platform.internal-http)."
      }
    },
    "schemas": {
      "HealthStatus": {
        "description": "Liveness.",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status",
          "service"
        ],
        "properties": {
          "status": {
            "const": "ok"
          },
          "service": {
            "const": "sms-gateway"
          }
        }
      },
      "Readiness": {
        "description": "Readiness (counts only).",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status",
          "service",
          "database",
          "migrations",
          "provider",
          "outboxPending",
          "outboxDeadLetter",
          "transportsUnknown"
        ],
        "properties": {
          "status": {
            "enum": [
              "ready",
              "not_ready"
            ]
          },
          "service": {
            "const": "sms-gateway"
          },
          "database": {
            "enum": [
              "ok",
              "unavailable"
            ]
          },
          "migrations": {
            "enum": [
              "current",
              "pending",
              "unknown"
            ]
          },
          "provider": {
            "enum": [
              "configured",
              "none"
            ]
          },
          "outboxPending": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "outboxDeadLetter": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "transportsUnknown": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          }
        }
      }
    },
    "responses": {
      "Error": {
        "description": "SMS Gateway error envelope.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "https://schemas.cfmeet.com/sms-gateway/common/v1.schema.json#/$defs/Error"
            }
          }
        }
      }
    }
  }
}
