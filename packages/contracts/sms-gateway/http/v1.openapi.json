{
  "openapi": "3.1.0",
  "info": {
    "title": "CF Meet SMS Gateway API",
    "version": "1.0.0",
    "description": "HTTP surface of services/sms-gateway: GET /health, /ready, /openapi.json (public, no data). Every non-probe path, including unknown ones, runs behind its authentication. Request bodies are limited to 32 KiB."
  },
  "paths": {
    "/health": {
      "get": {
        "operationId": "health",
        "security": [],
        "description": "Liveness.",
        "responses": {
          "200": {
            "description": "Alive.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthStatus"
                }
              }
            }
          }
        }
      }
    },
    "/ready": {
      "get": {
        "operationId": "ready",
        "security": [],
        "description": "Readiness: database, migrations, provider configured, outbox / unknown-transport backlog (counts only).",
        "responses": {
          "200": {
            "description": "Ready.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Readiness"
                }
              }
            }
          },
          "503": {
            "description": "Not ready.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Readiness"
                }
              }
            }
          }
        }
      }
    },
    "/openapi.json": {
      "get": {
        "operationId": "openapi",
        "security": [],
        "description": "This document (the served contract).",
        "responses": {
          "200": {
            "description": "The OpenAPI document.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "customerCredential": {
        "type": "http",
        "scheme": "bearer",
        "description": "A CF Meet API credential, verified by Platform Access (never by the SMS Gateway)."
      },
      "providerSignature": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Provider-Signature",
        "description": "The provider adapter's HMAC-SHA256 signature over the raw body with X-Provider-Timestamp (300 s window) and X-Provider-Event-Id."
      },
      "cfServiceAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-CF-Service-Authorization",
        "description": "Bearer <service token> (cfmeet.platform.internal-http)."
      }
    },
    "schemas": {
      "HealthStatus": {
        "description": "Liveness.",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status",
          "service"
        ],
        "properties": {
          "status": {
            "const": "ok"
          },
          "service": {
            "const": "sms-gateway"
          }
        }
      },
      "Readiness": {
        "description": "Readiness (counts only).",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status",
          "service",
          "database",
          "migrations",
          "provider",
          "outboxPending",
          "outboxDeadLetter",
          "transportsUnknown"
        ],
        "properties": {
          "status": {
            "enum": [
              "ready",
              "not_ready"
            ]
          },
          "service": {
            "const": "sms-gateway"
          },
          "database": {
            "enum": [
              "ok",
              "unavailable"
            ]
          },
          "migrations": {
            "enum": [
              "current",
              "pending",
              "unknown"
            ]
          },
          "provider": {
            "enum": [
              "configured",
              "none"
            ]
          },
          "outboxPending": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "outboxDeadLetter": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "transportsUnknown": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          }
        }
      }
    },
    "responses": {
      "Error": {
        "description": "SMS Gateway error envelope.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "https://schemas.cfmeet.com/sms-gateway/common/v1.schema.json#/$defs/Error"
            }
          }
        }
      }
    }
  }
}
