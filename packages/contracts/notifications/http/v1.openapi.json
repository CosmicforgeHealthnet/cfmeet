    "/api/v2/notifications/devices/{accountDeviceId}/push": {
      "put": {
        "operationId": "registerMyPushEndpoint",
        "summary": "Register a push endpoint for my device",
        "description": "U8. The device must be the caller's ACTIVE Account device. The handle is validated per platform (Web Push: HTTPS endpoint on the push-service host allowlist, ported from packages/push-transport) and is never echoed; it is sealed at rest and unique by digest. Rate limit 10/min.",
        "tags": [
          "Push"
        ],
        "security": [
          {
            "cfAccountSession": []
          }
        ],
        "parameters": [
          {
            "name": "accountDeviceId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            },
            "description": "The caller's ACTIVE Account device (ADR 0060)."
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "description": "Required on every mutation; kept 24 h.",
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9:_-]+$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "platform",
                  "handle"
                ],
                "properties": {
                  "platform": {
                    "$ref": "https://schemas.cfmeet.com/notifications/common/v1.schema.json#/$defs/PushPlatform"
                  },
                  "handle": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Registered (no handle returned).",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "pushTargetRef",
                    "platform",
                    "enabled"
                  ],
                  "properties": {
