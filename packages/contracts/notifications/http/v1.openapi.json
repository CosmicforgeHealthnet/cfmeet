    "/api/v1/notifications/provider-events/resend": {
      "post": {
        "operationId": "receiveResendProviderEvent",
        "summary": "Resend delivery webhook (Svix-signed)",
        "description": "Provider callback. Svix signature verification (port of verify_svix); 404 until a webhook secret is configured; 256 KiB cap; dedupe by (provider, event id); monotonic status; unknown message ids are ignored. During the drain Resend calls both this endpoint and the Meeting Service endpoint, and each applies only its own messages.",
        "tags": [
          "Provider callbacks"
        ],
        "security": [
          {
            "svixSignature": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "type",
                  "data"
                ],
                "properties": {
                  "type": {
                    "type": "string",
                    "maxLength": 64
                  },
                  "created_at": {
                    "type": "string"
                  },
                  "data": {
                    "type": "object"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Processed, duplicate or ignored."
          },
          "400": {
            "description": "Malformed payload."
          },
          "401": {
            "description": "Signature missing, invalid or outside the tolerance window."
          },
          "404": {
            "description": "No webhook secret configured."
          },
          "413": {
            "description": "Payload larger than 256 KiB."
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "cfAccountSession": {
        "type": "http",
        "scheme": "bearer",
        "description": "CF Meet Account session (verified by the Meeting Service relay)."
      },
      "svixSignature": {
        "type": "apiKey",
        "in": "header",
        "name": "svix-signature",
        "description": "Svix webhook signature (with svix-id and svix-timestamp)."
      }
    }
  }
}
