          },
          "429": {
            "description": "RATE_LIMITED (Retry-After).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "https://schemas.cfmeet.com/notifications/common/v1.schema.json#/$defs/Error"
                }
              }
            }
          },
          "503": {
            "description": "UNAVAILABLE.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "https://schemas.cfmeet.com/notifications/common/v1.schema.json#/$defs/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v2/notifications/dismiss": {
      "post": {
        "operationId": "dismissMyNotifications",
        "summary": "Dismiss notifications (by ids or up to a time)",
        "description": "U5. Either `ids` (≤ 100) or `upTo`, optionally restricted to categories. Rate limit 30/min.",
        "tags": [
          "Inbox"
        ],
        "security": [
