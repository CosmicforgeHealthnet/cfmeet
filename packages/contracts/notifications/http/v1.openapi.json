{
  "openapi": "3.1.0",
  "info": {
    "title": "CF Meet Notification Service user API (via the Meeting Service relay)",
    "version": "1.0.0",
    "description": "Public user APIs U1–U9 of the unified Notification Service (blueprint Document 4 §3.1) and its Resend provider callback (§3.2). Frozen by roadmap N1 before the service exists (lifecycle experimental; nothing is served yet). U1–U9 are served through the Meeting Service relay like /api/v2/communications/*: the Account session is verified by Meeting, which forwards to I2 with the server-resolved account; the routes join packages/contracts/openapi/meeting-service.json (generated) when the relay is implemented (N8). Responses never contain codes, tokens, addresses, push handles, E2EE text or URLs. Errors: {error:{code,message,requestId}}. Mutations require Idempotency-Key (24 h). The EXISTING Hub and Messaging notification endpoints keep their contracts and become facades in Phases 4.1 / 4.2."
  },
  "paths": {
    "/api/v2/notifications": {
      "get": {
        "operationId": "listMyNotifications",
        "summary": "List my notifications (inbox)",
        "description": "U1. The caller's own inbox items, newest first, opaque cursor. Silent items are listed but never counted. Rate limit 120/min per account.",
        "tags": [
          "Inbox"
        ],
        "security": [
          {
            "cfAccountSession": []
          }
        ],
        "parameters": [
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "type": "string",
              "maxLength": 200
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 30
            }
          },
          {
            "name": "state",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "unread",
                "all"
              ],
              "default": "all"
            }
          },
          {
            "name": "category",
            "in": "query",
            "style": "form",
            "explode": true,
            "schema": {
              "type": "array",
              "maxItems": 14,
              "items": {
                "$ref": "https://schemas.cfmeet.com/notifications/common/v1.schema.json#/$defs/Category"
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Inbox page.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "items",
                    "nextCursor",
                    "unreadCount"
                  ],
                  "properties": {
                    "items": {
                      "type": "array",
                      "maxItems": 100,
                      "items": {
                        "$ref": "https://schemas.cfmeet.com/notifications/common/v1.schema.json#/$defs/NotificationItem"
                      }
                    },
                    "nextCursor": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "maxLength": 200
                    },
                    "unreadCount": {
                      "type": "integer",
                      "minimum": 0
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "VALIDATION_ERROR.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "https://schemas.cfmeet.com/notifications/common/v1.schema.json#/$defs/Error"
                }
              }
            }
          },
          "401": {
            "description": "AUTHENTICATION_REQUIRED.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "https://schemas.cfmeet.com/notifications/common/v1.schema.json#/$defs/Error"
                }
              }
            }
          },
          "429": {
            "description": "RATE_LIMITED (Retry-After).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "https://schemas.cfmeet.com/notifications/common/v1.schema.json#/$defs/Error"
                }
              }
            }
          },
          "503": {
            "description": "UNAVAILABLE.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "https://schemas.cfmeet.com/notifications/common/v1.schema.json#/$defs/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v2/notifications/unread-count": {
      "get": {
        "operationId": "getMyNotificationUnreadCount",
        "summary": "My unread notification count",
        "description": "U2. ETag / If-None-Match supported (304). Rate limit 240/min per account.",
        "tags": [
          "Inbox"
        ],
        "security": [
          {
            "cfAccountSession": []
          }
        ],
        "parameters": [
          {
            "name": "If-None-Match",
            "in": "header",
            "schema": {
              "type": "string",
              "maxLength": 80
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Unread count.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "unreadCount",
                    "latestCreatedAt",
                    "version"
                  ],
                  "properties": {
                    "unreadCount": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "latestCreatedAt": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "format": "date-time"
                    },
                    "version": {
                      "type": "integer",
                      "minimum": 0
                    }
                  }
                }
              }
            }
          },
          "304": {
            "description": "Not modified."
          },
          "401": {
            "description": "AUTHENTICATION_REQUIRED.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "https://schemas.cfmeet.com/notifications/common/v1.schema.json#/$defs/Error"
                }
              }
            }
          },
          "429": {
            "description": "RATE_LIMITED (Retry-After).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "https://schemas.cfmeet.com/notifications/common/v1.schema.json#/$defs/Error"
                }
              }
            }
          },
          "503": {
            "description": "UNAVAILABLE.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "https://schemas.cfmeet.com/notifications/common/v1.schema.json#/$defs/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v2/notifications/{notificationId}": {
      "patch": {
        "operationId": "updateMyNotification",
        "summary": "Mark one notification read or dismissed",
        "description": "U3. Own items only: a foreign or unknown id is 404. Optimistic concurrency with expectedVersion. Rate limit 60/min.",
        "tags": [
          "Inbox"
        ],
        "security": [
          {
            "cfAccountSession": []
          }
        ],
        "parameters": [
          {
            "name": "notificationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "description": "Required on every mutation; kept 24 h.",
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9:_-]+$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "expectedVersion"
                ],
                "minProperties": 2,
                "properties": {
                  "read": {
                    "type": "boolean"
                  },
                  "dismissed": {
                    "type": "boolean"
                  },
                  "expectedVersion": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated item.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "https://schemas.cfmeet.com/notifications/common/v1.schema.json#/$defs/NotificationItem"
                }
              }
            }
          },
          "400": {
            "description": "VALIDATION_ERROR.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "https://schemas.cfmeet.com/notifications/common/v1.schema.json#/$defs/Error"
                }
              }
            }
          },
          "404": {
            "description": "NOT_FOUND.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "https://schemas.cfmeet.com/notifications/common/v1.schema.json#/$defs/Error"
                }
              }
            }
          },
          "409": {
            "description": "VERSION_CONFLICT or IDEMPOTENCY_CONFLICT.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "https://schemas.cfmeet.com/notifications/common/v1.schema.json#/$defs/Error"
                }
              }
            }
          },
          "401": {
            "description": "AUTHENTICATION_REQUIRED.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "https://schemas.cfmeet.com/notifications/common/v1.schema.json#/$defs/Error"
                }
              }
            }
          },
          "429": {
            "description": "RATE_LIMITED (Retry-After).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "https://schemas.cfmeet.com/notifications/common/v1.schema.json#/$defs/Error"
                }
              }
            }
          },
          "503": {
            "description": "UNAVAILABLE.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "https://schemas.cfmeet.com/notifications/common/v1.schema.json#/$defs/Error"
                }
              }
            }
          }
        }
      }
    },
