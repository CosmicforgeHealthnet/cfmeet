              "type": "string",
              "minLength": 8,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9:_-]+$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "minProperties": 1,
                "properties": {
                  "ids": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 100,
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "format": "uuid",
                      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                    }
                  },
                  "upTo": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "category": {
                    "type": "array",
                    "maxItems": 14,
                    "items": {
                      "$ref": "https://schemas.cfmeet.com/notifications/common/v1.schema.json#/$defs/Category"
                    }
                  }
                },
                "oneOf": [
                  {
                    "required": [
                      "ids"
                    ],
                    "not": {
                      "required": [
                        "upTo"
                      ]
                    }
                  },
                  {
                    "required": [
                      "upTo"
                    ],
                    "not": {
                      "required": [
                        "ids"
                      ]
                    }
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Result.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "dismissed",
