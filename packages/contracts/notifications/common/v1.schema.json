{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.cfmeet.com/notifications/common/v1.schema.json",
  "title": "CF Meet Notification Service shared vocabulary v1",
  "description": "Shared definitions of the unified Notification Service (blueprint Document 4; roadmap N1, frozen before the service exists): categories, lanes, channels, recipient references, the route decision of the routing fence (§9), the sealed (HPKE) part, inbox items, preferences, push platforms and the error envelope. Codes, tokens, addresses, push handles and E2EE content never appear in any user-visible or operator-visible shape.",
  "$defs": {
    "Lane": {
      "type": "string",
      "enum": [
        "CRITICAL",
        "HIGH",
        "STANDARD"
      ],
      "description": "CRITICAL (codes, security notices), HIGH (wake-ups, missed calls, operator alerts), STANDARD (everything else). The CALL fast lane is the synchronous I3 handler, not a queue."
    },
    "Priority": {
      "type": "string",
      "enum": [
        "CRITICAL",
        "HIGH",
        "NORMAL"
      ],
      "description": "Envelope priority. CRITICAL only for account.* types from cfmeet.meeting-service."
    },
    "Channel": {
      "type": "string",
      "enum": [
        "EMAIL",
        "PUSH",
        "IN_APP",
        "OPERATOR"
      ]
    },
    "Category": {
      "type": "string",
      "enum": [
        "DIRECT_MESSAGES",
        "GROUP_MESSAGES",
        "INCOMING_CALLS",
        "MISSED_CALLS",
        "CONTACT_REQUESTS",
        "GROUP_INVITATIONS",
        "MEETING_INVITATIONS",
        "MEETING_REMINDERS",
        "VOICEMAIL",
        "ORGANIZATION_UPDATES",
        "DEVELOPER_UPDATES",
        "MESSAGES",
        "SECURITY",
        "OPERATOR_ALERTS"
      ],
      "description": "Notification category. The eleven preference categories, plus SECURITY (fixed on, never stored), OPERATOR_ALERTS (operator group only) and MESSAGES (catalogue placeholder resolved to DIRECT_MESSAGES or GROUP_MESSAGES by the conversation kind)."
    },
    "PreferenceCategory": {
      "type": "string",
      "enum": [
        "DIRECT_MESSAGES",
        "GROUP_MESSAGES",
        "INCOMING_CALLS",
        "MISSED_CALLS",
        "CONTACT_REQUESTS",
        "GROUP_INVITATIONS",
        "MEETING_INVITATIONS",
        "MEETING_REMINDERS",
        "VOICEMAIL",
        "ORGANIZATION_UPDATES",
        "DEVELOPER_UPDATES"
      ]
    },
    "ProducerId": {
      "type": "string",
      "enum": [
        "cfmeet.meeting-service",
        "cfmeet.organizations",
        "cfmeet.communications",
        "cfmeet.calling",
        "cfmeet.messaging",
        "cfmeet.developer-platform",
        "alertmanager"
      ],
      "description": "Producers allowed by the closed per-producer type allowlist. `alertmanager` is only the I12 wrapper (static bearer, private listener)."
    },
    "EventType": {
      "type": "string",
      "enum": [
        "organizations.invitation.created",
        "organizations.invitation.accepted",
        "organizations.invitation.declined",
        "organizations.invitation.revoked",
        "organizations.invitation.expired",
        "organizations.membership.role_changed",
        "organizations.membership.suspended",
        "organizations.membership.removed",
        "organizations.ownership.transferred",
        "organizations.organization.suspended",
        "communications.connection.requested",
        "communications.connection.connected",
        "messaging.message.created",
        "messaging.member.invited",
        "calling.call.participant-missed",
        "calling.voicemail.ready",
        "calling.recording.ready",
        "meeting-service.conference.scheduled",
        "meeting-service.conference.rescheduled",
        "meeting-service.conference.cancelled",
        "meeting-service.invitation.email-requested",
        "meeting-service.organization-invitation.email-requested",
        "account.verification-code.requested",
        "account.password-reset-code.requested",
        "account.device-step-up-code.requested",
        "account.security.password-changed",
        "account.security.device-linked",
        "developer-platform.credential.expiring-soon",
        "developer-platform.credential.expired",
        "developer-platform.production-access.decided",
        "operator.alert.fired",
        "account.sign-in-code.requested",
        "account.email-change-code.requested",
        "account.step-up-code.requested",
        "account.welcome.requested",
        "account.security.new-sign-in",
        "account.security.email-in-use",
        "account.security.email-changed",
        "organizations.organization.archived",
        "organizations.organization.reactivated",
        "notifications.cancel"
      ]
    },
    "StepUpPurpose": {
      "type": "string",
      "enum": [
        "DEACTIVATE_ACCOUNT",
        "CHANGE_EMAIL"
      ],
      "description": "The action an account.step-up-code.requested code confirms (`data.purpose`)."
    },
    "EmailChangedSide": {
      "type": "string",
      "enum": [
        "OLD",
        "NEW"
      ],
      "description": "Which notice of an email change an account.security.email-changed event is (`data.side`): OLD, to the previous address (the masked new address and, for a self-service change, the undo token are sealed); NEW, to the new address."
    },
    "AccountRef": {
      "type": "string",
      "pattern": "^cfmeet-user:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "RecipientRef": {
      "description": "A recipient reference. 1.3.0 (ADR 0063 N-P4): also platform-principal:<environmentId>:<principalId>, a partner's end user reached only through the partner's own push credentials, for the metadata-only partner event types (messaging.message.created).",
      "type": "string",
      "maxLength": 96,
      "pattern": "^(cfmeet-user|meeting-email-principal|platform-principal):[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$|^operator-group:[a-z][a-z-]{0,39}$|^platform-principal:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "Uuid": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "SafeString": {
      "type": "string",
      "maxLength": 200,
      "pattern": "^[^\\u0000-\\u001f\\u007f]*$"
    },
    "Route": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decisionId",
        "routingVersion",
        "protocol"
      ],
      "description": "The producer's routing-fence decision (Document 4 §9.2), made in its own transaction. The service acts only on route NEW; protocol versions N and N-1 are accepted.",
      "properties": {
        "decisionId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "routingVersion": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "protocol": {
          "type": "integer",
          "enum": [
            1
          ]
        }
      }
    },
    "Sealed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kid",
        "enc",
        "ct"
      ],
      "description": "HPKE (RFC 9180) base mode, DHKEM(X25519, HKDF-SHA256) / HKDF-SHA256 / AES-256-GCM, to the service public key `kid`. info = \"cfmeet.notifications.sealed.v1\", aad = the UTF-8 bytes of `<producer>|<eventId>|<eventType>` (binds the sealed part to its envelope). The plaintext is a JSON object with only `code`, `token`, `address`, `maskedAddress`, `requestClient` and/or `requestNetwork`, as the catalogue allows per type (`sealed`: required, `sealedOptional`: allowed). Opened only by the renderer; never logged.",
      "properties": {
        "kid": {
          "type": "string",
          "pattern": "^notif-hpke-[0-9]{4}-[0-9]{2}(-[a-z0-9]{1,8})?$"
        },
        "enc": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$",
          "description": "base64url (no padding) of the 32-byte X25519 encapsulated key"
        },
        "ct": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{22,5462}$",
          "description": "base64url (no padding) of the AES-256-GCM ciphertext and tag (plaintext ≤ 4 KiB)"
        }
      }
    },
    "SealedPlaintext": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "description": "What the sealed part contains once opened by the renderer (never transmitted in clear).",
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[A-Za-z0-9-]{4,64}$"
        },
        "token": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.~-]{16,512}$"
        },
        "address": {
          "type": "string",
          "maxLength": 254,
          "pattern": "^[^@\\s]{1,64}@[^@\\s]{1,253}$"
        },
        "maskedAddress": {
          "type": "string",
          "maxLength": 260,
          "pattern": "^[^@\\s*\\u0000-\\u001f\\u007f]?\\*\\*\\*@[^@\\s\\u0000-\\u001f\\u007f]{1,253}$",
          "description": "A masked address as the legacy email shows it (`n***@example.com`), never a full address."
        },
        "requestClient": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[^\\u0000-\\u001f\\u007f]*$",
          "description": "The shortened client label (User-Agent) of the request an account notice reports."
        },
        "requestNetwork": {
          "type": "string",
          "minLength": 3,
          "maxLength": 64,
          "pattern": "^[0-9A-Fa-f.:]*x[0-9A-Fa-fx.:]*$",
          "description": "The masked network prefix of that request (`102.89.x.x`, `2001:db8:x:x`), never a full address."
        }
      }
    },
    "ActionKind": {
      "type": "string",
      "enum": [
        "OPEN_CONVERSATION",
        "OPEN_CALL_HISTORY",
        "OPEN_VOICEMAIL",
        "OPEN_RECORDING",
        "OPEN_MEETING",
        "OPEN_ORGANIZATION",
        "OPEN_ORGANIZATION_INVITATION",
        "OPEN_CONTACT_REQUEST",
        "OPEN_CONTACT",
        "OPEN_SECURITY_SETTINGS",
        "OPEN_DEVELOPER_APPLICATION",
        "NONE"
      ],
      "description": "Closed set: clients map each kind to a fixed in-app destination. No URL is ever returned."
    },
    "NotificationItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "category",
        "title",
        "body",
        "action",
        "createdAt",
        "readAt",
        "dismissedAt",
        "groupCount",
        "version"
      ],
      "description": "One inbox item. Never E2EE text, codes, tokens, addresses or URLs.",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "category": {
          "$ref": "#/$defs/Category"
        },
        "title": {
          "type": "string",
          "maxLength": 200
        },
        "body": {
          "type": "string",
          "maxLength": 500
        },
        "action": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "ref"
          ],
          "properties": {
            "kind": {
              "$ref": "#/$defs/ActionKind"
            },
            "ref": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "uuid",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "readAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "dismissedAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "groupCount": {
          "type": "integer",
          "minimum": 1
        },
        "version": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "NotificationLevel": {
      "type": "string",
      "enum": [
        "ALL",
        "MENTIONS",
        "MUTED"
      ]
    },
    "ChannelSwitches": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "push": {
          "type": "boolean"
        },
        "email": {
          "type": "boolean"
        },
        "inApp": {
          "type": "boolean"
        }
      }
    },
    "QuietHours": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "start",
        "end",
        "days"
      ],
      "description": "Evaluated in the Account time zone (X1). Push is deferred to the window end; email is never deferred; SECURITY ignores quiet hours.",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "start": {
          "type": "string",
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
        },
        "end": {
          "type": "string",
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
        },
        "days": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 7,
          "items": {
            "type": "string",
            "enum": [
              "MON",
              "TUE",
              "WED",
              "THU",
              "FRI",
              "SAT",
              "SUN"
            ]
          }
        }
      }
    },
    "ConversationPreference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "notifications"
      ],
      "properties": {
        "notifications": {
          "$ref": "#/$defs/NotificationLevel"
        },
        "mutedUntil": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ],
          "description": "Only with MUTED; at most 366 days ahead (Hub chat.rs rule)."
        }
      }
    },
    "ContactPreference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "notifications"
      ],
      "properties": {
        "notifications": {
          "$ref": "#/$defs/NotificationLevel"
        }
      }
    },
    "NotificationPreferences": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "version",
        "categories",
        "channels",
        "quietHours",
        "conversations",
        "contacts",
        "securityEvents",
        "timeZone"
      ],
      "description": "The service is the single preference writer from Phase 4.2. Absent rows mean everything enabled (today's Hub defaults). securityEvents is fixed true and not stored. timeZone is read-only (Account).",
      "properties": {
        "schemaVersion": {
          "type": "integer",
          "enum": [
            1
          ]
        },
        "version": {
          "type": "integer",
          "minimum": 0
        },
        "categories": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "directMessages",
            "groupMessages",
            "incomingCalls",
            "missedCalls",
            "contactRequests",
            "groupInvitations",
            "meetingInvitations",
            "meetingReminders",
            "voicemail",
            "organizationUpdates",
            "developerUpdates"
          ],
          "properties": {
            "directMessages": {
              "type": "boolean"
            },
            "groupMessages": {
              "type": "boolean"
            },
            "incomingCalls": {
              "type": "boolean"
            },
            "missedCalls": {
              "type": "boolean"
            },
            "contactRequests": {
              "type": "boolean"
            },
            "groupInvitations": {
              "type": "boolean"
            },
            "meetingInvitations": {
              "type": "boolean"
            },
            "meetingReminders": {
              "type": "boolean"
            },
            "voicemail": {
              "type": "boolean"
            },
            "organizationUpdates": {
              "type": "boolean"
            },
            "developerUpdates": {
              "type": "boolean"
            }
          }
        },
        "channels": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/ChannelSwitches"
          },
          "propertyNames": {
            "enum": [
              "directMessages",
              "groupMessages",
              "incomingCalls",
              "missedCalls",
              "contactRequests",
              "groupInvitations",
              "meetingInvitations",
              "meetingReminders",
              "voicemail",
              "organizationUpdates",
              "developerUpdates"
            ]
          }
        },
        "quietHours": {
          "anyOf": [
            {
              "$ref": "#/$defs/QuietHours"
            },
            {
              "type": "null"
            }
          ]
        },
        "conversations": {
          "type": "object",
          "maxProperties": 5000,
          "propertyNames": {
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/ConversationPreference"
          }
        },
        "contacts": {
          "type": "object",
          "maxProperties": 5000,
          "propertyNames": {
            "pattern": "^[A-Za-z0-9:_-]{1,64}$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/ContactPreference"
          }
        },
        "securityEvents": {
          "type": "boolean",
          "enum": [
            true
          ]
        },
        "timeZone": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 64,
              "pattern": "^[A-Za-z_]+(/[A-Za-z0-9_+-]+)*$"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "NotificationPreferencesUpdate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expectedVersion"
      ],
      "minProperties": 2,
      "description": "Partial update (deny unknown fields). Conversation / contact entries set to null are removed (back to ALL).",
      "properties": {
        "expectedVersion": {
          "type": "integer",
          "minimum": 0
        },
        "categories": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "directMessages": {
              "type": "boolean"
            },
            "groupMessages": {
              "type": "boolean"
            },
            "incomingCalls": {
              "type": "boolean"
            },
            "missedCalls": {
              "type": "boolean"
            },
            "contactRequests": {
              "type": "boolean"
            },
            "groupInvitations": {
              "type": "boolean"
            },
            "meetingInvitations": {
              "type": "boolean"
            },
            "meetingReminders": {
              "type": "boolean"
            },
            "voicemail": {
              "type": "boolean"
            },
            "organizationUpdates": {
              "type": "boolean"
            },
            "developerUpdates": {
              "type": "boolean"
            }
          }
        },
        "channels": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/ChannelSwitches"
          },
          "propertyNames": {
            "enum": [
              "directMessages",
              "groupMessages",
              "incomingCalls",
              "missedCalls",
              "contactRequests",
              "groupInvitations",
              "meetingInvitations",
              "meetingReminders",
              "voicemail",
              "organizationUpdates",
              "developerUpdates"
            ]
          }
        },
        "quietHours": {
          "anyOf": [
            {
              "$ref": "#/$defs/QuietHours"
            },
            {
              "type": "null"
            }
          ]
        },
        "conversations": {
          "type": "object",
          "maxProperties": 100,
          "propertyNames": {
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "additionalProperties": {
            "anyOf": [
              {
                "$ref": "#/$defs/ConversationPreference"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "contacts": {
          "type": "object",
          "maxProperties": 100,
          "propertyNames": {
            "pattern": "^[A-Za-z0-9:_-]{1,64}$"
          },
          "additionalProperties": {
            "anyOf": [
              {
                "$ref": "#/$defs/ContactPreference"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    },
    "PushPlatform": {
      "type": "string",
      "enum": [
        "APNS",
        "APNS_VOIP",
        "FCM",
        "WEB_PUSH"
      ]
    },
    "IngestOutcome": {
      "type": "string",
      "enum": [
        "ACCEPTED",
        "DUPLICATE",
        "REJECTED",
        "HELD",
        "UNKNOWN"
      ],
      "description": "ACCEPTED only after commit (responsibility boundary §9.5). DUPLICATE has ACCEPTED semantics. HELD: stored, never sent, alert raised. UNKNOWN: dryRun probe found no committed event."
    },
    "ErrorCode": {
      "type": "string",
      "enum": [
        "VALIDATION_ERROR",
        "AUTHENTICATION_REQUIRED",
        "INTERNAL_AUTHENTICATION_FAILED",
        "FORBIDDEN",
        "NOT_FOUND",
        "VERSION_CONFLICT",
        "IDEMPOTENCY_CONFLICT",
        "RATE_LIMITED",
        "UNAVAILABLE",
        "PROTOCOL_UNSUPPORTED",
        "PAYLOAD_TOO_LARGE"
      ]
    },
    "Error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "error"
      ],
      "properties": {
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "message",
            "requestId"
          ],
          "properties": {
            "code": {
              "$ref": "#/$defs/ErrorCode"
            },
            "message": {
              "type": "string",
              "maxLength": 500
            },
            "requestId": {
              "type": "string",
              "maxLength": 64
            }
          }
        }
      }
    }
  }
}
