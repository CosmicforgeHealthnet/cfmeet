{
  "openapi": "3.1.0",
  "info": {
    "title": "CF Meet communications private Communications integration",
    "version": "1.3.0",
    "description": "Private backend interfaces for Sections 4–7. Never routed by public ingress or advertised by public Swagger. The owner retains canonical data. Scope, permissions and identities come from signed service authentication; request bodies cannot impersonate principals."
  },
  "tags": [
    {
      "name": "Communications integration",
      "description": "Narrow owner-authenticated metadata and policy interfaces."
    }
  ],
  "paths": {
    "/internal/v1/communications/dispatch": {
      "post": {
        "operationId": "dispatchCommunicationsUser",
        "summary": "Dispatch Account-verified consumer operations",
        "description": "Dispatch Account-verified consumer operations. Private signed service traffic only; the delegated tenant, application and environment must match the verified Platform Access authority. Permission communications-user.forward is granted only by the receiving service trust policy. Replayed JWT hops are refused by the Hub; events and commands additionally deduplicate their durable identities. Failures never grant communications.",
        "tags": [
          "Communications integration"
        ],
        "security": [
          {
            "cfServiceAuth": []
          }
        ],
        "x-cfmeet-internal-permission": "communications-user.forward",
        "parameters": [
          {
            "name": "X-CF-Request-Id",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^req_[0-9a-f]{32}$"
            }
          },
          {
            "name": "X-CF-Correlation-Id",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^corr_[0-9a-f]{32}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Typed private result.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DispatchResult"
                }
              }
            }
          },
          "400": {
            "description": "Invalid typed request.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Invalid or replayed service authentication.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Permission or delegated scope denied.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Unavailable scoped resource.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Event identity or payload conflict.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Required authority or persistence unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Dispatch"
              }
            }
          }
        }
      }
    },
    "/internal/v1/communications/policy/check": {
      "post": {
        "operationId": "checkCommunicationsPolicy",
        "summary": "Check a typed live personal authorization decision",
        "description": "Check a typed live personal authorization decision. Private signed service traffic only; the delegated tenant, application and environment must match the verified Platform Access authority. Permission communications-policy.check is granted only by the receiving service trust policy. Replayed JWT hops are refused by the Hub; events and commands additionally deduplicate their durable identities. Failures never grant communications. MESSAGE_NOTIFICATION and GROUP_NOTIFICATION are Messaging-only delayed push decisions. They enforce active accounts, live blocks and recipient contact notification preferences. MENTIONS suppresses ordinary opaque notifications because the server cannot infer mentions from E2EE content. Group membership remains authoritative in Messaging; absence of a personal connection alone does not exclude an admitted group member.",
        "tags": [
          "Communications integration"
        ],
        "security": [
          {
            "cfServiceAuth": []
          }
        ],
        "x-cfmeet-internal-permission": "communications-policy.check",
        "parameters": [
          {
            "name": "X-CF-Request-Id",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^req_[0-9a-f]{32}$"
            }
          },
          {
            "name": "X-CF-Correlation-Id",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^corr_[0-9a-f]{32}$"
