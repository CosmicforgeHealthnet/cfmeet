        "x-cfmeet-internal-permission": "communications-backfill.run",
        "parameters": [
          {
            "name": "X-CF-Request-Id",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^req_[0-9a-f]{32}$"
            }
          },
          {
            "name": "X-CF-Correlation-Id",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^corr_[0-9a-f]{32}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Typed private result.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Metrics"
                }
              }
            }
          },
          "400": {
            "description": "Invalid typed request.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Invalid or replayed service authentication.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Permission or delegated scope denied.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Unavailable scoped resource.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Event identity or payload conflict.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Required authority or persistence unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "cfServiceAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-CF-Service-Authorization",
        "description": "Bearer EdDSA service JWT from cf-service-auth; audience, runtime, request IDs, scope, expiration and receiver-granted permission are verified."
      }
    },
    "schemas": {
      "AccountEvent": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "eventId": {
            "type": "string",
            "format": "uuid"
          },
          "accountReference": {
            "type": "string",
            "maxLength": 80
          },
          "sourceVersion": {
            "type": "integer",
            "minimum": 1
          },
          "kind": {
            "type": "string",
            "enum": [
              "STATUS_CHANGED",
              "SESSION_REVOKED"
            ]
          },
          "state": {
            "type": "string",
            "enum": [
              "ACCOUNT_CREATED",
              "ACTIVE",
              "SUSPENDED",
              "DEACTIVATED"
            ]
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "eventId",
          "accountReference",
          "sourceVersion",
          "kind",
          "state",
          "occurredAt"
        ]
      },
      "Backfill": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "cursor": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "limit",
          "cursor"
        ]
      },
      "BackfillResult": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "created": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "nextCursor": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "created",
          "nextCursor"
        ]
      },
      "BlockEvent": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "eventId": {
            "type": "string",
            "format": "uuid"
          },
          "actorPrincipalId": {
            "type": "string",
            "format": "uuid"
          },
          "targetPrincipalId": {
            "type": "string",
            "format": "uuid"
          },
          "sourceVersion": {
            "type": "integer",
            "minimum": 1
          },
          "blocked": {
            "type": "boolean"
          }
        },
        "required": [
          "eventId",
          "actorPrincipalId",
          "targetPrincipalId",
          "sourceVersion",
          "blocked"
        ]
      },
      "Decision": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "schemaVersion": {
            "type": "integer",
            "enum": [
              1
            ]
          },
          "allowed": {
            "type": "boolean"
          },
          "reason": {
            "type": "string",
            "enum": [
              "ALLOWED",
              "NOT_PERMITTED",
              "ACCOUNT_INACTIVE",
              "CREDENTIAL_REVOKED"
            ]
          },
          "policyVersion": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "schemaVersion",
          "allowed",
          "reason",
          "policyVersion"
        ]
      },
      "Dispatch": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "method": {
            "type": "string",
            "enum": [
              "GET",
              "POST",
              "PUT",
              "PATCH",
              "DELETE"
            ]
          },
          "path": {
            "type": "string",
            "maxLength": 180
          },
          "query": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "body": {},
          "idempotencyKey": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ]
          },
          "account": {
            "$ref": "#/components/schemas/VerifiedAccount"
          }
        },
        "required": [
          "method",
          "path",
          "query",
          "body",
          "idempotencyKey",
          "account"
        ]
      },
      "DispatchResult": {
        "description": "The consumer response for the dispatched public operation; a strictly bounded versioned JSON object. See the public Communications contract for each operation.",
        "type": "object",
        "required": [
          "schemaVersion"
        ],
        "properties": {
          "schemaVersion": {
            "type": "integer",
            "enum": [
              1
            ]
          }
        }
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "schemaVersion": {
            "type": "integer",
            "enum": [
              1
            ]
          },
          "error": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "AUTHENTICATION_REQUIRED",
                  "PERMISSION_DENIED",
                  "NOT_FOUND",
                  "VALIDATION_ERROR",
                  "VERSION_CONFLICT",
                  "IDEMPOTENCY_CONFLICT",
                  "REQUEST_PENDING",
                  "RATE_LIMITED",
                  "RECENT_AUTHENTICATION_REQUIRED",
                  "COMMUNICATIONS_UNAVAILABLE"
                ]
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "message"
            ]
          }
        },
        "required": [
          "schemaVersion",
          "error"
        ]
      },
      "EventReceipt": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "applied": {
            "type": "boolean"
          },
          "duplicate": {
            "type": "boolean"
          }
        },
        "required": [
          "applied",
          "duplicate"
        ]
      },
      "Metrics": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "schemaVersion": {
            "type": "integer",
            "enum": [
              1
            ]
          },
          "uptimeSeconds": {
            "type": "integer",
            "minimum": 0
          },
          "requests": {
            "type": "integer",
            "minimum": 0
          },
          "denied": {
            "type": "integer",
            "minimum": 0
          },
          "eventsDelivered": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "schemaVersion",
          "uptimeSeconds",
          "requests",
          "denied",
          "eventsDelivered"
        ]
      },
      "NotificationPreferenceQuery": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "category": {
            "type": "string",
            "enum": [
              "MEETINGS"
            ]
          },
          "accountReferences": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^cfmeet-user:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            }
          }
        },
        "required": [
          "category",
          "accountReferences"
        ]
      },
      "NotificationPreferenceResult": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "schemaVersion": {
            "type": "integer",
            "enum": [
              1
            ]
          },
          "category": {
            "type": "string",
            "enum": [
              "MEETINGS"
            ]
          },
          "optedOut": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^cfmeet-user:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            }
          }
        },
        "required": [
          "schemaVersion",
          "category",
          "optedOut"
        ]
      },
      "PolicyCheck": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "DIRECT_CALL",
              "DIRECT_CONVERSATION",
              "MESSAGE_SEND",
              "CONTACT_REQUEST",
              "GROUP_INVITATION",
              "PERSONAL_ACTIVITY",
              "PRESENCE",
              "PROFILE_DISCOVERY",
              "MESSAGE_NOTIFICATION",
              "GROUP_NOTIFICATION"
            ]
          },
          "actorPrincipalId": {
            "type": "string",
            "format": "uuid"
          },
          "targetPrincipalId": {
            "type": "string",
            "format": "uuid"
          },
          "credentialIssuedAt": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "credentialPrincipalId": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "action",
          "actorPrincipalId",
          "targetPrincipalId",
          "credentialIssuedAt",
          "credentialPrincipalId"
        ]
      },
      "PrincipalResolve": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "actorPrincipalId": {
            "type": "string",
            "format": "uuid"
          },
          "cfMeetId": {
            "type": "string",
            "pattern": "^CF-[A-Z2-7]{26}$"
          },
          "purpose": {
            "type": "string",
            "enum": [
              "DIRECT_CALL",
              "DIRECT_CONVERSATION",
              "GROUP_INVITATION"
            ],
            "description": "Optional for compatibility. Calling may request only DIRECT_CALL; Messaging only DIRECT_CONVERSATION (default) or GROUP_INVITATION. Other caller/purpose pairs are forbidden."
          }
        },
        "required": [
          "actorPrincipalId",
          "cfMeetId"
        ]
      },
      "PrincipalResult": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "schemaVersion": {
            "type": "integer",
            "enum": [
              1
            ]
          },
          "principalId": {
            "type": "string",
            "format": "uuid"
          },
          "kind": {
            "type": "string",
            "enum": [
              "NATIVE_CF_USER"
            ]
          },
          "policyVersion": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "schemaVersion",
          "principalId",
          "kind",
          "policyVersion"
        ]
      },
      "Replay": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "eventId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "eventId"
        ]
      },
      "ReplayResult": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "requeued": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2
          }
        },
        "required": [
          "requeued"
        ]
      },
      "VerifiedAccount": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "accountReference": {
            "type": "string",
            "maxLength": 80,
            "pattern": "^cfmeet-user:[0-9a-f-]{36}$"
          },
          "principalId": {
            "type": "string",
            "format": "uuid"
          },
          "displayName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "avatarReference": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 512
              },
              {
                "type": "null"
              }
            ]
          },
          "authenticatedAt": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "accountReference",
          "principalId",
          "displayName",
          "avatarReference",
          "authenticatedAt"
        ]
      }
    }
  }
}
