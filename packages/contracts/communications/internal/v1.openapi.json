    "/internal/v1/communications/notification-preferences/resolve": {
      "post": {
        "operationId": "resolveNotificationPreferences",
        "summary": "List the accounts that turned a notification category off",
        "description": "List the accounts that turned a notification category off (Blueprint Section 11). Private signed service traffic only; the delegated tenant, application and environment must match the verified Platform Access authority. Permission communications-preferences.read is granted only by the receiving service trust policy and only the Meeting Service may call it. MEETINGS is the meetingInvitations preference (meeting invitation, change and reminder emails). Accounts without a Communications profile or without a stored preference are not listed (the default is enabled). Returns account references only, never preference values, profile data or principals. At most 100 account references per request.",
        "tags": [
          "Communications integration"
        ],
        "security": [
          {
            "cfServiceAuth": []
          }
        ],
