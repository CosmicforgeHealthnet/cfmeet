{
  "openapi": "3.1.0",
  "info": {
    "title": "CF Meet Privacy Relay API",
    "version": "1.0.0",
    "description": "The CF Meet platform Privacy Relay API (Part D sections 26-30): Communication Contexts and Privacy Relay Sessions. One generic model for first-party and external applications alike; it never knows a consumer's business object. Privacy Relay (services/privacy-relay) is the business and data authority; the API is currently served by the authenticated platform ingress (services/calling), which authenticates the customer credential, checks the scope, validates referenced principals and forwards over authenticated internal service calls with a signed delegated platform context — the customer credential is never forwarded. Tenant, application and environment come only from the credential; a resource of another scope is answered exactly like a missing one (404). Every mutation requires expectedVersion where it changes an existing resource and an Idempotency-Key (a replay returns the recorded response with Idempotent-Replayed: true; a different request under the same key is 409 IDEMPOTENCY_CONFLICT). Lifecycle changes are explicit commands; there is no status patch. No telephone number, provider id, carrier, Contact Vault material or credential is ever accepted or returned."
  },
  "paths": {
    "/v1/privacy-relay/contexts": {
      "post": {
        "operationId": "createContext",
        "summary": "Create a communication context",
        "description": "Creates a Communication Context (version 1): the consumer-neutral authority for WHY (opaque externalContextReference), WHO (participants: principal ids or opaque ContactReference ids), in which DIRECTION, over which CHANNEL, during which window and under which bounded policy parties may communicate. Requires privacy.contexts.write and an Idempotency-Key. Referenced principals must be active principals of the credential's own application environment. Scope comes only from the credential; status, version, authorization results, telephone numbers, providers and relay numbers are never inputs. One context per external reference in an application environment. 503 PRIVACY_RELAY_DISABLED while the feature is disabled.",
        "security": [
          {
            "platformCredential": [
              "privacy.contexts.write"
            ]
          }
        ],
        "x-cfmeet-required-scope": "privacy.contexts.write",
        "parameters": [
          {
            "$ref": "#/components/parameters/IdempotencyKeyRequired"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "https://schemas.cfmeet.com/privacy-relay/context/v1.schema.json#/$defs/CreateContextRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The created context (or the recorded result of an identical earlier request).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/XRequestId"
              },
              "cache-control": {
                "$ref": "#/components/headers/CacheControlNoStore"
              },
              "idempotent-replayed": {
                "$ref": "#/components/headers/IdempotentReplayed"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "https://schemas.cfmeet.com/privacy-relay/context/v1.schema.json#/$defs/ContextMutationResult"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/InvalidRequest"
          },
          "401": {
            "$ref": "#/components/responses/AuthenticationFailed"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "422": {
            "$ref": "#/components/responses/Unprocessable"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        }
      },
