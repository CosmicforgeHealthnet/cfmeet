    "/v1/privacy-relay/contexts/{context_id}/sessions": {
      "post": {
        "operationId": "createRelaySession",
        "summary": "Create a Privacy Relay Session",
        "description": "Creates a Privacy Relay Session (NOT a call: one session may authorize many call attempts during its window) under a relay strategy. Requires privacy.sessions.write and an Idempotency-Key. Participants, channels, directions, validity and strategy may only NARROW the context; anything broader is refused (PARTICIPANT_NOT_AUTHORIZED, CHANNEL_NOT_ALLOWED, DIRECTION_NOT_ALLOWED, STRATEGY_NOT_ALLOWED, VALIDITY_NOT_CONTAINED). Strategies are policy: only the application route is executable today.",
        "security": [
          {
            "platformCredential": [
              "privacy.sessions.write"
            ]
          }
        ],
        "x-cfmeet-required-scope": "privacy.sessions.write",
        "parameters": [
