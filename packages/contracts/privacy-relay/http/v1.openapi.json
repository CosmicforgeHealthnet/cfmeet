  "components": {
    "securitySchemes": {
      "platformCredential": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "cfmk_<sbx|test|live>_<public id>_<secret>",
        "description": "Customer platform API credential (Authorization: Bearer). The roles in an operation's security requirement are the platform scopes the credential must hold (privacy.contexts.read / .write, privacy.sessions.read / .write)."
      }
    },
    "parameters": {
      "ContextId": {
        "name": "context_id",
        "in": "path",
        "required": true,
        "description": "Communication Context id.",
        "schema": {
          "type": "string"
        }
      },
      "RelaySessionId": {
        "name": "relay_session_id",
        "in": "path",
        "required": true,
        "description": "Privacy Relay Session id.",
        "schema": {
          "type": "string"
        }
      },
      "IdempotencyKeyRequired": {
        "name": "idempotency-key",
        "in": "header",
        "required": true,
        "description": "Required on every mutation. Same key + same request: recorded response; different request: 409 IDEMPOTENCY_CONFLICT; concurrent duplicates take effect once.",
        "schema": {
          "$ref": "https://schemas.cfmeet.com/privacy-relay/common/v1.schema.json#/$defs/IdempotencyKey"
        }
      },
      "Limit": {
        "name": "limit",
        "in": "query",
        "required": false,
        "description": "Page size 1-100 (default 50).",
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      },
      "Cursor": {
        "name": "cursor",
        "in": "query",
        "required": false,
        "description": "Opaque keyset cursor (nextCursor of the previous page).",
        "schema": {
          "type": "string",
          "maxLength": 512
        }
      },
      "ContextStatus": {
        "name": "status",
        "in": "query",
        "required": false,
        "schema": {
          "$ref": "https://schemas.cfmeet.com/privacy-relay/common/v1.schema.json#/$defs/CommunicationContextStatus"
        }
      },
      "SessionStatus": {
        "name": "status",
        "in": "query",
        "required": false,
        "schema": {
          "$ref": "https://schemas.cfmeet.com/privacy-relay/common/v1.schema.json#/$defs/PrivacyRelaySessionStatus"
        }
      },
      "ExternalContextReference": {
        "name": "externalContextReference",
        "in": "query",
        "required": false,
        "schema": {
          "$ref": "https://schemas.cfmeet.com/privacy-relay/common/v1.schema.json#/$defs/ExternalContextReference"
        }
      },
      "ContextIdFilter": {
        "name": "contextId",
        "in": "query",
        "required": false,
        "schema": {
          "$ref": "https://schemas.cfmeet.com/platform/common/v1.schema.json#/$defs/Uuid"
        }
      }
    },
    "headers": {
      "XRequestId": {
        "description": "Server-generated request id.",
        "schema": {
          "type": "string"
        }
      },
      "CacheControlNoStore": {
        "description": "Responses are never cached.",
        "schema": {
          "const": "no-store"
        }
      },
      "IdempotentReplayed": {
        "description": "true when the response replays an earlier identical request.",
        "schema": {
          "const": "true"
        }
      }
    },
    "responses": {
      "InvalidRequest": {
        "description": "Malformed or invalid request (VALIDATION_ERROR): unknown members (a tenantId, status, version, authorization result, telephone number, provider or arbitrary policy document is refused), invalid validity, missing Idempotency-Key, inactive or foreign principals.",
        "headers": {
          "x-request-id": {
            "$ref": "#/components/headers/XRequestId"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "https://schemas.cfmeet.com/privacy-relay/common/v1.schema.json#/$defs/ErrorEnvelope"
            }
          }
        }
      },
      "AuthenticationFailed": {
        "description": "AUTHENTICATION_FAILED (uniform for every reason).",
        "headers": {
          "x-request-id": {
            "$ref": "#/components/headers/XRequestId"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "https://schemas.cfmeet.com/privacy-relay/common/v1.schema.json#/$defs/ErrorEnvelope"
            }
          }
        }
      },
      "Forbidden": {
        "description": "INSUFFICIENT_SCOPE.",
        "headers": {
          "x-request-id": {
            "$ref": "#/components/headers/XRequestId"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "https://schemas.cfmeet.com/privacy-relay/common/v1.schema.json#/$defs/ErrorEnvelope"
            }
          }
        }
      },
      "NotFound": {
        "description": "CONTEXT_NOT_FOUND / SESSION_NOT_FOUND / NOT_FOUND — identical for missing and foreign resources.",
        "headers": {
          "x-request-id": {
            "$ref": "#/components/headers/XRequestId"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "https://schemas.cfmeet.com/privacy-relay/common/v1.schema.json#/$defs/ErrorEnvelope"
            }
          }
        }
      },
      "Conflict": {
        "description": "CONTEXT_VERSION_CONFLICT, SESSION_VERSION_CONFLICT, CONTEXT_REFERENCE_CONFLICT, CONTEXT_NOT_ACTIVE, CONTEXT_EXPIRED, CONTEXT_REVOKED, CONTEXT_SUSPENDED, SESSION_NOT_ACTIVE or IDEMPOTENCY_CONFLICT.",
        "headers": {
          "x-request-id": {
            "$ref": "#/components/headers/XRequestId"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "https://schemas.cfmeet.com/privacy-relay/common/v1.schema.json#/$defs/ErrorEnvelope"
            }
          }
        }
      },
      "Unprocessable": {
        "description": "The request would broaden authority: PARTICIPANT_NOT_AUTHORIZED, DIRECTION_NOT_ALLOWED, CHANNEL_NOT_ALLOWED, STRATEGY_NOT_ALLOWED or VALIDITY_NOT_CONTAINED.",
        "headers": {
          "x-request-id": {
            "$ref": "#/components/headers/XRequestId"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "https://schemas.cfmeet.com/privacy-relay/common/v1.schema.json#/$defs/ErrorEnvelope"
            }
          }
        }
      },
      "TooManyRequests": {
        "description": "RATE_LIMITED.",
        "headers": {
          "x-request-id": {
            "$ref": "#/components/headers/XRequestId"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "https://schemas.cfmeet.com/privacy-relay/common/v1.schema.json#/$defs/ErrorEnvelope"
            }
          }
        }
      },
      "Unavailable": {
        "description": "PRIVACY_RELAY_DISABLED (feature kill switch) or SERVICE_UNAVAILABLE.",
        "headers": {
          "x-request-id": {
            "$ref": "#/components/headers/XRequestId"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "https://schemas.cfmeet.com/privacy-relay/common/v1.schema.json#/$defs/ErrorEnvelope"
            }
          }
        }
      }
    }
  }
}
