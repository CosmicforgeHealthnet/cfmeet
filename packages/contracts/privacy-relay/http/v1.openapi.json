      "patch": {
        "operationId": "updateContext",
        "summary": "Update a communication context",
        "description": "Typed, versioned configuration update (participant replacement / reassignment on the SAME context, channels, directions, validity, bounded policy, allowed strategies) — never a status patch or an arbitrary merge patch. Requires privacy.contexts.write, expectedVersion (409 CONTEXT_VERSION_CONFLICT when stale; a stale write can never restore removed authority) and an Idempotency-Key. The version increments exactly once; removed participants lose authority the moment the update commits, in every relay session; active calls of removed participants are terminated when the policy says so (enforcement.status APPLIED or PENDING, never claimed early).",
        "security": [
          {
            "platformCredential": [
              "privacy.contexts.write"
            ]
          }
        ],
        "x-cfmeet-required-scope": "privacy.contexts.write",
        "parameters": [
