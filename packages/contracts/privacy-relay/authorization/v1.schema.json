{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.cfmeet.com/privacy-relay/authorization/v1.schema.json",
  "title": "CF Meet communication authorization v1",
  "description": "Communication authorization request and decision (Part D sections 29-30). The root accepts exactly one of the bodies (fixtures).",
  "oneOf": [
    {
      "$ref": "#/$defs/AuthorizationRequest"
    },
    {
      "$ref": "#/$defs/AuthorizationDecisionResult"
    }
  ],
  "$defs": {
    "AuthorizationRequest": {
      "description": "Internal communication authorization request (Calling -> Privacy Relay, service-authenticated). Tenant / application / environment come only from the signed delegated context; there is no client-asserted result.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relaySessionId",
        "source",
        "targets",
        "channel"
      ],
      "properties": {
        "relaySessionId": {
          "$ref": "https://schemas.cfmeet.com/platform/common/v1.schema.json#/$defs/Uuid"
        },
        "source": {
          "$ref": "https://schemas.cfmeet.com/privacy-relay/common/v1.schema.json#/$defs/SubjectReference"
        },
        "targets": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "$ref": "https://schemas.cfmeet.com/privacy-relay/common/v1.schema.json#/$defs/SubjectReference"
          }
        },
        "channel": {
          "$ref": "https://schemas.cfmeet.com/privacy-relay/common/v1.schema.json#/$defs/CommunicationChannel"
        },
        "route": {
          "$ref": "https://schemas.cfmeet.com/privacy-relay/common/v1.schema.json#/$defs/CommunicationRoute"
        },
        "purpose": {
          "$ref": "https://schemas.cfmeet.com/privacy-relay/common/v1.schema.json#/$defs/AuthorizationPurpose"
        }
      }
    },
    "AuthorizationDecisionResult": {
      "description": "A recorded decision evaluated against the CURRENT context AND session (their intersection) at server time. validUntil is present exactly when AUTHORIZED. No contacts, no provider ids.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decisionId",
        "decision",
        "reason",
        "contextId",
        "contextVersion",
        "relaySessionId",
        "relaySessionVersion",
        "strategy",
        "policyVersion",
        "channel",
        "route",
        "purpose",
        "decidedAt"
      ],
      "properties": {
        "decisionId": {
          "$ref": "https://schemas.cfmeet.com/platform/common/v1.schema.json#/$defs/Uuid"
        },
        "decision": {
          "$ref": "https://schemas.cfmeet.com/privacy-relay/common/v1.schema.json#/$defs/AuthorizationDecision"
        },
        "reason": {
          "$ref": "https://schemas.cfmeet.com/privacy-relay/common/v1.schema.json#/$defs/AuthorizationReason"
        },
        "contextId": {
          "$ref": "https://schemas.cfmeet.com/platform/common/v1.schema.json#/$defs/Uuid"
        },
        "contextVersion": {
          "$ref": "https://schemas.cfmeet.com/privacy-relay/common/v1.schema.json#/$defs/Version"
        },
        "relaySessionId": {
          "$ref": "https://schemas.cfmeet.com/platform/common/v1.schema.json#/$defs/Uuid"
        },
        "relaySessionVersion": {
          "$ref": "https://schemas.cfmeet.com/privacy-relay/common/v1.schema.json#/$defs/Version"
        },
        "strategy": {
          "$ref": "https://schemas.cfmeet.com/privacy-relay/common/v1.schema.json#/$defs/RelayStrategy"
        },
        "policyVersion": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{1,31}$"
        },
        "channel": {
          "$ref": "https://schemas.cfmeet.com/privacy-relay/common/v1.schema.json#/$defs/CommunicationChannel"
        },
        "route": {
          "$ref": "https://schemas.cfmeet.com/privacy-relay/common/v1.schema.json#/$defs/CommunicationRoute"
        },
        "purpose": {
          "$ref": "https://schemas.cfmeet.com/privacy-relay/common/v1.schema.json#/$defs/AuthorizationPurpose"
        },
        "validUntil": {
          "$ref": "https://schemas.cfmeet.com/privacy-relay/common/v1.schema.json#/$defs/Timestamp"
        },
        "decidedAt": {
          "$ref": "https://schemas.cfmeet.com/privacy-relay/common/v1.schema.json#/$defs/Timestamp"
        }
      },
      "if": {
        "properties": {
          "decision": {
            "const": "AUTHORIZED"
          }
        }
      },
      "then": {
        "required": [
          "validUntil"
        ],
        "properties": {
          "reason": {
            "const": "AUTHORIZED"
          }
        }
      },
      "else": {
        "not": {
          "required": [
            "validUntil"
          ]
        },
        "properties": {
          "reason": {
            "not": {
              "const": "AUTHORIZED"
            }
          }
        }
      }
    }
  }
}
