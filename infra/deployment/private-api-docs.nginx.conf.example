# CF Meet private engineering API catalog — reference configuration.
#
# IMPORTANT: Must NEVER be made accessible through api.cfmeet.com or a public
# server_name without an independently verified SSO/VPN gate.
#
# This safe baseline listens ONLY on loopback. Engineers access via an SSH tunnel
# to the VPS after authenticating with an authorized SSH account.
# Authentication is also required by Nginx; configure credentials OUTSIDE git.
#
# Generate catalog on trusted infrastructure:
#   python3 scripts/swagger/build-private-docs.py --out /opt/cfmeet-private-api-docs
# Install htpasswd (with strong unique credentials) at /etc/nginx/private-docs.htpasswd.
# Create a symlink in sites-enabled, run nginx -t and reload.
# Example engineer access:
#   ssh -L 18099:127.0.0.1:18099 <approved-vps-account>@<approved-vps-host>
#   http://127.0.0.1:18099/
#
# For internal-docs.cfmeet.com later: configure DNS, TLS, VPN/SSO, explicit deny
# rules on api.cfmeet.com for any private path, and externally verify 401/403;
# do not simply change listen to 0.0.0.0.

server {
    listen 127.0.0.1:18099;
    server_name localhost;
    root /opt/cfmeet-private-api-docs;
    index index.html;

    access_log /var/log/nginx/cfmeet-private-docs-access.log;
    error_log /var/log/nginx/cfmeet-private-docs-error.log warn;

    auth_basic "CF Meet engineering — private API docs";
    auth_basic_user_file /etc/nginx/private-docs.htpasswd;

    autoindex off;
    location / {
        limit_except GET HEAD { deny all; }
        try_files $uri $uri/ =404;
        add_header Cache-Control "private, no-store" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Robots-Tag "noindex, nofollow, noarchive" always;
        add_header Referrer-Policy "no-referrer" always;
        add_header Content-Security-Policy "default-src 'none'; script-src 'self' https://cdn.jsdelivr.net; style-src 'self' https://cdn.jsdelivr.net 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'" always;
    }
}
