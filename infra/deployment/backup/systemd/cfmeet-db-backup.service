# PROPOSAL / TEMPLATE — not installed by any workflow. See
# docs/operations/backup-and-restore.md ("Schedule") for the owner-approved install steps.
#
# Runs one scheduled backup of every configured CF Meet database. Install to
# /etc/systemd/system/cfmeet-db-backup.service together with cfmeet-db-backup.timer, with the
# tooling copied to /opt/cfmeet-backup (root-owned, not writable by anyone else).
[Unit]
Description=CF Meet encrypted database backup (all service databases)
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
User=root
Environment=CFMEET_BACKUP_CONFIG=/etc/cfmeet-backup/backup.env
Environment=TMPDIR=/var/backups/cfmeet/.tmp
ExecStartPre=/usr/bin/install -d -m 0700 /var/backups/cfmeet/.tmp
ExecStart=/usr/bin/bash /opt/cfmeet-backup/backup-all.sh --config /etc/cfmeet-backup/backup.env
# Backups are background work: never compete with live meetings for CPU or disk.
Nice=10
IOSchedulingClass=idle
CPUQuota=50%
TimeoutStartSec=2h
UMask=0077
PrivateTmp=yes
NoNewPrivileges=yes
ProtectHome=read-only
# Exit 5 (no off-host target while CFMEET_BACKUP_REQUIRE_OFFSITE=1) and 4 (off-host copy
# failed) leave the unit failed on purpose so `systemctl --failed` / monitoring shows them.
