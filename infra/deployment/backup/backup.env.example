# CF Meet scheduled database backup configuration — TEMPLATE.
# Install as /etc/cfmeet-backup/backup.env (root:root, mode 0600). backup-all.sh reads only
# CFMEET_*=value lines from it; it is never executed as shell code. Values are not secrets:
# every credential lives in its own root-only file referenced below.
#
# Production values marked REQUIRES_VALIDATION must be confirmed by the owner/operator on the
# VPS before the first run (docs/operations/backup-and-restore.md, "Owner actions").

# Where local backups go (root-only). Keep it on a different disk/volume from PostgreSQL's
# data if the host has one.
CFMEET_BACKUP_ROOT=/var/backups/cfmeet

# PUBLIC age recipients (one `age1...` per line; comments allowed). The matching private key
# is generated and kept by the owner OFF this host. backup-all.sh refuses to run without it
# and refuses a file containing a private key.
CFMEET_BACKUP_AGE_RECIPIENTS_FILE=/etc/cfmeet-backup/age-recipients.txt

# Databases to back up, in order. Every name must be `active` in catalog.conf.
CFMEET_BACKUP_SERVICES=meeting-service platform-access calling messaging communications

# ---- per-service connection -------------------------------------------------------------
# _URL_FILE      root-only file holding just the URL (preferably the read-only cfmeet_backup
#                role created by provision-backup-role.sh)
# _URL_ENV_FILE  docker env file that already holds DATABASE_URL (or _URL_VAR)
# _PG_WRAPPER    command prefix that runs pg_dump/psql where the database is reachable. The
#                core and legacy databases publish no host port, so a throwaway client
#                container joins their private network. `-e NAME` forwards the variable from
#                the backup process's environment without putting its value on a command line.

# Meeting Service (account authority) — database in the legacy `cosmicforge-db` container.
# The client container joins the running backend's network namespace (exactly as the release
# tooling runs its migrations: --network container:cfmeet-production-backend), so the
# DATABASE_URL host resolves the same way it does for the service.
# REQUIRES_VALIDATION: where the production DATABASE_URL lives (a root-only URL file for a
# read-only role is preferred over the service's own env file), the database name and the
# server's major version (the client image's major must be >= the server's).
CFMEET_BACKUP_MEETING_SERVICE_URL_FILE=/etc/cfmeet-backup/urls/meeting-service.url
CFMEET_BACKUP_MEETING_SERVICE_PG_WRAPPER=docker run --rm -i --network container:cfmeet-production-backend -e PGHOST -e PGPORT -e PGUSER -e PGPASSWORD -e PGDATABASE -e PGSSLMODE postgres:16-alpine

# Core databases on `cfmeet-core-db` (network cfmeet-core-private, no published port).
CFMEET_BACKUP_PLATFORM_ACCESS_URL_FILE=/etc/cfmeet-backup/urls/platform-access.url
CFMEET_BACKUP_PLATFORM_ACCESS_PG_WRAPPER=docker run --rm -i --network cfmeet-core-private -e PGHOST -e PGPORT -e PGUSER -e PGPASSWORD -e PGDATABASE postgres:16-alpine
CFMEET_BACKUP_CALLING_URL_FILE=/etc/cfmeet-backup/urls/calling.url
CFMEET_BACKUP_CALLING_PG_WRAPPER=docker run --rm -i --network cfmeet-core-private -e PGHOST -e PGPORT -e PGUSER -e PGPASSWORD -e PGDATABASE postgres:16-alpine
CFMEET_BACKUP_MESSAGING_URL_FILE=/etc/cfmeet-backup/urls/messaging.url
CFMEET_BACKUP_MESSAGING_PG_WRAPPER=docker run --rm -i --network cfmeet-core-private -e PGHOST -e PGPORT -e PGUSER -e PGPASSWORD -e PGDATABASE postgres:16-alpine
# Communications Hub production database is cfmeet_comm_production_hub.
CFMEET_BACKUP_COMMUNICATIONS_URL_FILE=/etc/cfmeet-backup/urls/communications.url
CFMEET_BACKUP_COMMUNICATIONS_PG_WRAPPER=docker run --rm -i --network cfmeet-core-private -e PGHOST -e PGPORT -e PGUSER -e PGPASSWORD -e PGDATABASE postgres:16-alpine
# Developer Platform, Numbering, Privacy Relay, Telephony, SMS Gateway: add them to
# CFMEET_BACKUP_SERVICES with the same three keys once they run in production.
# CFMEET_BACKUP_DEVELOPER_PLATFORM_URL_FILE=/etc/cfmeet-backup/urls/developer-platform.url
# Future Organizations authority: activate `organizations` in catalog.conf first.

# ---- local retention --------------------------------------------------------------------
# Scheduled runs: keep at least KEEP_MIN newest; delete older than KEEP_DAYS days.
CFMEET_BACKUP_KEEP_DAYS=14
CFMEET_BACKUP_KEEP_MIN=7
# Pre-migration snapshots (per service).
CFMEET_BACKUP_PRE_MIGRATION_KEEP_DAYS=30
CFMEET_BACKUP_PRE_MIGRATION_KEEP_MIN=5

# ---- off-host copy (owner decision; none = LOCAL_ONLY, not disaster recovery) --------------
CFMEET_BACKUP_OFFSITE_KIND=none
CFMEET_BACKUP_SOURCE_NAME=cfmeet-vps
# Set to 1 once a target exists, so a run without a working off-host copy exits non-zero.
CFMEET_BACKUP_REQUIRE_OFFSITE=0

# rsync over SSH to an owner-provided host (recommend `rrsync -wo <dir>` in the target's
# authorized_keys so this host can add backups but never read or delete them).
# CFMEET_BACKUP_OFFSITE_KIND=rsync
# CFMEET_BACKUP_OFFSITE_RSYNC_DEST=cfmeet-backup@backup.example.org:/srv/cfmeet-backups
# CFMEET_BACKUP_OFFSITE_SSH_KEY=/etc/cfmeet-backup/offsite_ed25519
# CFMEET_BACKUP_OFFSITE_SSH_KNOWN_HOSTS=/etc/cfmeet-backup/offsite_known_hosts
# CFMEET_BACKUP_OFFSITE_SSH_PORT=22

# rclone to any non-AWS backend the owner chooses (SFTP, WebDAV, B2, an S3-compatible
# provider other than AWS, ...).
# CFMEET_BACKUP_OFFSITE_KIND=rclone
# CFMEET_BACKUP_OFFSITE_RCLONE_REMOTE=cfmeet-offsite:cfmeet-backups
# CFMEET_BACKUP_OFFSITE_RCLONE_CONFIG=/etc/cfmeet-backup/rclone.conf
