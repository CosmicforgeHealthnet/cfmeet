# CF Meet frontend environment (copy to .env.local).
# Only NEXT_PUBLIC_* variables are exposed to the browser — never put secrets here.

# Base URL of the CF Meet Meeting & Conference Platform service
# (services/meeting-service/ in this monorepo).
# Local default when running `make meeting-service`: http://localhost:8080/api/v1
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
