# CF Meet frontend environment (copy to .env.local).
# Only NEXT_PUBLIC_* variables are exposed to the browser — never put secrets here.

# Base URL of the CF Meet Meeting & Conference Platform service
# (services/meeting-service/ in this monorepo).
# Local default when running `make meeting-service`: http://localhost:8080/api/v1
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1

# Unified Messaging REST uses /api/v2/messaging on this same Meeting Service.
# Keep the URL above on /api/v1: login/profile endpoints still use v1.
# Browser-reachable Messaging realtime origin (not the Meeting API URL).
# Set this to your deployed Messaging ingress to enable live delivery.
NEXT_PUBLIC_MESSAGING_URL=
# Object storage origin used by Messaging attachment grants (optional).
NEXT_PUBLIC_MESSAGING_STORAGE_URL=
# Optional pinned key-transparency log configuration; see messaging-v2.md.
NEXT_PUBLIC_MESSAGING_KT_LOG_ID=
NEXT_PUBLIC_MESSAGING_KT_LOG_KEY=

# Base URL of the CF Meet Calling service (services/calling/ in this monorepo).
# Local default when running `make calling`: http://localhost:8090
NEXT_PUBLIC_CALLING_API_URL=http://localhost:8090

# Server-only Calling adapter configuration. The Platform Access credential needs
# calls.read / calls.write (and enterprise.calls.use for extension calls).
# Use the same communication scope as Meeting Service /api/v2/messaging/me.
CALLING_API_URL=http://localhost:8090
CALLING_PLATFORM_CREDENTIAL=
CALLING_TENANT_ID=
CALLING_APPLICATION_ID=
CALLING_ENVIRONMENT_ID=
# Comma-separated Calling principal IDs explicitly authorized for enterprise,
# webhook, and usage screens. These are deny-by-default user-level gates, in
# addition to the API credential's scopes and enterprise policy capabilities.
CALLING_ADMIN_PRINCIPAL_IDS=
CALLING_PRIVACY_ADMIN_PRINCIPAL_IDS=
# Developer Portal (/developers). Off unless exactly "true"; the base URL is the public
# API Gateway origin (https; never the legacy meeting-service /api/v1). Not deployed yet (PLT-005).
NEXT_PUBLIC_DEVELOPER_PLATFORM_ENABLED=false
NEXT_PUBLIC_DEVELOPER_API_BASE_URL=
