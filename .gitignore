# =============================================================================
# CF Meet monorepo — root ignore rules
# backend/.gitignore and frontend/.gitignore keep their app-specific rules.
# =============================================================================

# ---- Rust -------------------------------------------------------------------
target/
debug/
**/*.rs.bk
*.pdb
**/mutants.out*/

# ---- Node / Next.js ---------------------------------------------------------
node_modules/
.next/
out/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
*.tsbuildinfo
next-env.d.ts
.vercel/

# ---- Environment / secrets --------------------------------------------------
.env
.env.*
!.env.example
denv.txt
*.pem

# ---- Logs -------------------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ---- Test / coverage --------------------------------------------------------
coverage/
*.lcov

# ---- Build output -----------------------------------------------------------
build/
dist/

# ---- IDE / OS ---------------------------------------------------------------
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ---- Temporary files --------------------------------------------------------
tmp/
*.tmp
