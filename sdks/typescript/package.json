{
  "name": "@cfmeet/platform-sdk",
  "version": "0.1.0",
  "private": true,
  "description": "CF Meet platform SDK for TypeScript (Part VI Section 52): typed client generated from the published contracts, with retries, idempotency, pagination, realtime, webhook verification and the messaging crypto adapter.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": ["dist"],
  "scripts": {
    "generate": "python3 ../generate.py",
    "generate:check": "python3 ../generate.py --check",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "typecheck:examples": "tsc -p tsconfig.examples.json && tsc -p tsconfig.examples-browser.json",
    "test": "tsc -p tsconfig.test.json && node --test --test-reporter=spec \"build-test/test/**/*.test.js\"",
    "check:bundle": "node scripts/check-bundle.mjs dist",
    "build:wasm-test-module": "sh scripts/build-messaging-crypto-test-module.sh"
  },
  "engines": { "node": ">=22" },
  "devDependencies": {
    "@types/node": "22.10.2",
    "typescript": "5.6.3"
  }
}
